  pip_summary="$(summarize_list_items "$v_pip" "package")"
  npm_summary="$(summarize_list_items "$v_npm" "package")"

  echo -e "${BOLD}${CYAN}╭────────────────────────────────────────────────────────────────────╮${RESET}"
  echo -e "${BOLD}${CYAN}│${RESET}  ${BOLD}⚡ AIUP Installed Inventory${RESET}                                       ${BOLD}${CYAN}│${RESET}"
  echo -e "${BOLD}${CYAN}╰────────────────────────────────────────────────────────────────────╯${RESET}"
  echo ""
  echo -e "  ${BOLD}${CYAN}◈ CLI HARNESSES & AGENT RUNTIMES${RESET}"
  echo -e "  ╭──────────────────────────┬────────────────────────────┬────────────────╮"
  echo -e "  │ Target                   │ Engine / Command           │ Version        │"
  echo -e "  ├──────────────────────────┼────────────────────────────┼────────────────┤"
  printf "  │ %-24s │ %-26s │ %-14s │\n" "Google Antigravity" "agy" "${v_agy:0:14}"
