# Shared updater helper for CLI self-updaters without a --check dry-run mode
run_self_updater_cli() {
  local id="$1"
  local title="$2"
  local bin_name="$3"
  local subcmd="$4"
  local step_msg="$5"
  local uptodate_re="$6"
  local updated_re="$7"

  local bin
  bin="$(resolve_bin "$bin_name" 2>/dev/null || true)"
  [[ -n "$bin" ]] || return 0
  should_run "$id" "cli" || return 0

  log_card_start "$title" "cli"
  local t_start curr_v dur output rc=0 post_v
  t_start="$(now_ns)"
  curr_v="$(get_version "$id")"

  if [[ $DRY_RUN -eq 1 ]]; then
    log_step "Installed version: ${curr_v}"
    log_step "Skipping update execution (${bin_name} has no non-mutating --check mode)"
    dur="$(elapsed_since "$t_start")"
    log_card_end "SKIPPED" "v${curr_v#v} (no CLI --check)" "$dur"
    record_result "$id" "CLI" "SKIPPED" "No CLI --check" "$dur"
    return 0
  fi

  log_step "$step_msg"
  output="$("$bin" "$subcmd" 2>&1 | strip_cr)" || rc=$?
  printf '%s\n' "$output" | stream_progress 4
  post_v="$(get_version "$id")"
  dur="$(elapsed_since "$t_start")"

  if [[ $rc -ne 0 ]]; then
    log_card_end "FAILED" "${bin_name} ${subcmd} exited ${rc}" "$dur"
    record_result "$id" "CLI" "FAILED" "Exit ${rc}" "$dur"
  elif [[ "$post_v" != "$curr_v" && -n "$post_v" && "$post_v" != "not installed" ]]; then
    log_card_end "UPDATED" "${curr_v} → ${post_v}" "$dur"
    record_result "$id" "CLI" "UPDATED" "${post_v}" "$dur"
  elif [[ -n "$uptodate_re" ]] && printf '%s\n' "$output" | grep -qiE "$uptodate_re"; then
    log_card_end "UP TO DATE" "Current (${post_v})" "$dur"
    record_result "$id" "CLI" "UP TO DATE" "${post_v}" "$dur"
  elif [[ -n "$updated_re" ]] && printf '%s\n' "$output" | grep -qiE "$updated_re"; then
    log_card_end "UPDATED" "Upgraded to ${post_v}" "$dur"
    record_result "$id" "CLI" "UPDATED" "${post_v}" "$dur"
  else
    log_card_end "UP TO DATE" "Verified (${post_v})" "$dur"
    record_result "$id" "CLI" "UP TO DATE" "${post_v}" "$dur"
  fi
}

# Shared helper for Windows winget-managed apps (with optional fallback check function)
run_winget_app() {
  local id="$1"
  local title="$2"
  local scope="$3"       # "CLI" or "DESKTOP"
  local pkg_id="$4"
  local local_ver="$5"
  local card_type
  card_type="$(printf '%s' "$scope" | tr '[:upper:]' '[:lower:]')"

  local t_start dur wg_info inst_v avail_v curr_v upg_rc=0 post_v
  t_start="$(now_ns)"

  if [[ $HAS_WINGET -eq 0 ]]; then
    dur="$(elapsed_since "$t_start")"
    log_card_end "SKIPPED" "v${local_ver#v} (winget unavailable)" "$dur"
    record_result "$id" "$scope" "SKIPPED" "No winget" "$dur"
    return 0
  fi

  log_step "Querying winget manifest (${pkg_id})..."
  wg_info="$(winget_query_pkg "$pkg_id" || true)"
  if [[ -z "$wg_info" ]]; then
    return 2
  fi

  IFS='|' read -r inst_v avail_v _ <<< "$wg_info"
  curr_v="${inst_v:-$local_ver}"

  if [[ -n "$avail_v" ]] && { [[ "$avail_v" != "$curr_v" ]] || is_version_gt "$avail_v" "$curr_v"; }; then
    log_step "Found newer version: ${avail_v} (installed: ${curr_v})"
    if [[ $DRY_RUN -eq 1 ]]; then
      dur="$(elapsed_since "$t_start")"
      log_card_end "UPDATE AVAIL" "${curr_v} → ${avail_v}" "$dur"
      record_result "$id" "$scope" "UPDATE AVAIL" "${avail_v}" "$dur"
      return 0
    fi
    log_step "Upgrading ${pkg_id} via winget..."
    winget.exe upgrade --exact --id "$pkg_id" --silent --accept-package-agreements --accept-source-agreements --disable-interactivity < /dev/null 2>&1 | strip_cr | stream_progress 5 || upg_rc=$?
    post_v="$(get_version "$id")"
    [[ "$post_v" == "not installed" || -z "$post_v" ]] && post_v="$avail_v"
    dur="$(elapsed_since "$t_start")"
    if [[ $upg_rc -eq 0 ]]; then
      log_card_end "UPDATED" "Upgraded to ${post_v}" "$dur"
      record_result "$id" "$scope" "UPDATED" "${post_v}" "$dur"
    else
      log_card_end "FAILED" "winget upgrade exited ${upg_rc}" "$dur"
      record_result "$id" "$scope" "FAILED" "winget (${upg_rc})" "$dur"
    fi
  else
    dur="$(elapsed_since "$t_start")"
    log_card_end "UP TO DATE" "Version ${curr_v} is current" "$dur"
    record_result "$id" "$scope" "UP TO DATE" "v${curr_v#v}" "$dur"
  fi
  return 0
}

# Shared helper for GitHub latest release check (read-only alert or optional verification)
check_github_release_status() {
  local id="$1"
  local scope="$2"
  local repo="$3"
  local curr_v="$4"
  local t_start="$5"
  local latest_tag dur

  log_step "Checking GitHub releases for ${repo}..."
  latest_tag=$(curl -s --connect-timeout 4 "https://api.github.com/repos/${repo}/releases/latest" 2>/dev/null | json_get_stdin "tag_name" | sed 's/^v//')
  dur="$(elapsed_since "$t_start")"

  if [[ -z "$latest_tag" ]]; then
    log_card_end "SKIPPED" "GitHub check unavailable (local v${curr_v#v})" "$dur"
    record_result "$id" "$scope" "SKIPPED" "Check failed" "$dur"
  elif is_version_gt "$latest_tag" "$curr_v"; then
    log_step "New release available: v${latest_tag} (manual download)"
    log_card_end "UPDATE AVAIL" "v${curr_v#v} → v${latest_tag} (manual)" "$dur"
    record_result "$id" "$scope" "UPDATE AVAIL" "v${latest_tag} (manual)" "$dur"
  else
    log_card_end "UP TO DATE" "Version v${curr_v#v} is current" "$dur"
    record_result "$id" "$scope" "UP TO DATE" "v${curr_v#v}" "$dur"
  fi
}

# Shared helper for Linux DNF/APT package upgrade
run_linux_pkg_upgrade() {
  local id="$1"
  local pkg_name="$2"
  local curr_v="$3"
  local t_start="$4"
  local dur avail_v="" upg_rc=0

  if [[ "$PKG_MGR" == "dnf" ]]; then
    log_step "Checking DNF repository for ${pkg_name}..."
    local dnf_rc=0 dnf_out
    dnf_out=$(dnf check-update "$pkg_name" 2>&1) || dnf_rc=$?
    if [[ $dnf_rc -eq 100 ]]; then
      avail_v=$(printf '%s\n' "$dnf_out" | awk -v p="$pkg_name" '$1 ~ p {print $2; exit}')
      log_step "Found newer version: ${avail_v:-latest} (current: ${curr_v})"
      if [[ $DRY_RUN -eq 1 ]]; then
        dur="$(elapsed_since "$t_start")"
        log_card_end "UPDATE AVAIL" "${curr_v} → ${avail_v:-latest}" "$dur"
        record_result "$id" "DESKTOP" "UPDATE AVAIL" "${avail_v:-latest}" "$dur"
      else
        run_privileged "${pkg_name} DNF upgrade" dnf upgrade -y "$pkg_name" 2>&1 | stream_progress 4 || upg_rc=$?
        dur="$(elapsed_since "$t_start")"
        if [[ $upg_rc -eq 0 ]]; then
          log_card_end "UPDATED" "Upgraded via DNF (${avail_v:-latest})" "$dur"
          record_result "$id" "DESKTOP" "UPDATED" "${avail_v:-Upgraded}" "$dur"
        elif [[ $upg_rc -eq 1 || $upg_rc -eq 2 ]]; then
          log_card_end "UPDATE AVAIL" "Auth skipped; run: sudo dnf upgrade -y ${pkg_name}" "$dur"
          record_result "$id" "DESKTOP" "UPDATE AVAIL" "sudo dnf upgrade" "$dur"
        else
          log_card_end "FAILED" "DNF upgrade exited ${upg_rc}" "$dur"
          record_result "$id" "DESKTOP" "FAILED" "DNF error (${upg_rc})" "$dur"
        fi
      fi
    elif [[ $dnf_rc -ne 0 ]]; then
      dur="$(elapsed_since "$t_start")"
      log_card_end "FAILED" "DNF check-update exited ${dnf_rc}" "$dur"
      record_result "$id" "DESKTOP" "FAILED" "DNF check error" "$dur"
    else
      dur="$(elapsed_since "$t_start")"
      log_card_end "UP TO DATE" "Version ${curr_v} is current" "$dur"
      record_result "$id" "DESKTOP" "UP TO DATE" "v${curr_v#v}" "$dur"
    fi
  elif [[ "$PKG_MGR" == "apt" ]]; then
    log_step "Checking APT policy for ${pkg_name}..."
    local apt_cand
    apt_cand=$(apt-cache policy "$pkg_name" 2>/dev/null | awk '/Candidate:/ {print $2; exit}')
    if [[ -n "$apt_cand" && "$apt_cand" != "(none)" ]] && is_version_gt "${apt_cand%%-*}" "$curr_v"; then
      if [[ $DRY_RUN -eq 1 ]]; then
        dur="$(elapsed_since "$t_start")"
        log_card_end "UPDATE AVAIL" "${curr_v} → ${apt_cand}" "$dur"
        record_result "$id" "DESKTOP" "UPDATE AVAIL" "${apt_cand}" "$dur"
      else
        run_privileged "${pkg_name} APT upgrade" apt-get install -y --only-upgrade "$pkg_name" 2>&1 | stream_progress 4 || upg_rc=$?
        dur="$(elapsed_since "$t_start")"
        if [[ $upg_rc -eq 0 ]]; then
          log_card_end "UPDATED" "Upgraded via APT (${apt_cand})" "$dur"
          record_result "$id" "DESKTOP" "UPDATED" "${apt_cand}" "$dur"
        elif [[ $upg_rc -eq 1 || $upg_rc -eq 2 ]]; then
          log_card_end "UPDATE AVAIL" "Auth skipped; run: sudo apt-get install --only-upgrade ${pkg_name}" "$dur"
          record_result "$id" "DESKTOP" "UPDATE AVAIL" "sudo apt upgrade" "$dur"
        else
          log_card_end "FAILED" "APT upgrade exited ${upg_rc}" "$dur"
          record_result "$id" "DESKTOP" "FAILED" "APT error (${upg_rc})" "$dur"
        fi
      fi
    else
      dur="$(elapsed_since "$t_start")"
      log_card_end "UP TO DATE" "Version ${curr_v} is current" "$dur"
      record_result "$id" "DESKTOP" "UP TO DATE" "v${curr_v#v}" "$dur"
    fi
  else
    dur="$(elapsed_since "$t_start")"
    log_card_end "SKIPPED" "v${curr_v} (no supported repo mgr)" "$dur"
    record_result "$id" "DESKTOP" "SKIPPED" "Unsupported pkg" "$dur"
  fi
}

# Shared helper for local Electron/Node git desktop workspaces
sync_git_desktop_repo() {
  local id="$1"
  local title="$2"
  local repo_dir="$3"
  local build_cmd="$4"

  [[ -d "${repo_dir}/.git" ]] || return 0
  should_run "$id" "desktop" || return 0

  log_card_start "$title" "desktop"
  local t_start dirty_count local_sha upstream_ref remote_name branch_name remote_sha dur git_out pull_rc=0 build_rc=0 stashed=0
  t_start="$(now_ns)"
  dirty_count=$(git -C "$repo_dir" status --porcelain 2>/dev/null | wc -l | awk '{print $1}')
  local_sha=$(git -C "$repo_dir" rev-parse HEAD 2>/dev/null || echo "")
  upstream_ref=$(git -C "$repo_dir" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || echo "origin/main")
  remote_name="${upstream_ref%%/*}"
  branch_name="${upstream_ref#*/}"

  log_step "Checking local git working tree (${upstream_ref})..."

  if [[ $DRY_RUN -eq 1 ]]; then
    log_step "Probing ${upstream_ref} (read-only ls-remote)..."
    remote_sha=$(git -C "$repo_dir" ls-remote "$remote_name" "refs/heads/${branch_name}" 2>/dev/null | awk '{print $1}')
    dur="$(elapsed_since "$t_start")"
    if [[ -n "$remote_sha" && "$remote_sha" != "$local_sha" ]]; then
      local note="New commits on ${upstream_ref}"
      [[ $dirty_count -gt 0 ]] && note+=" (${dirty_count} local edits)"
      log_card_end "UPDATE AVAIL" "$note" "$dur"
      record_result "$id" "DESKTOP" "UPDATE AVAIL" "Origin ahead" "$dur"
    elif [[ $dirty_count -gt 0 ]]; then
      log_card_end "DIRTY (SKIPPED)" "${dirty_count} uncommitted files (up to date)" "$dur"
      record_result "$id" "DESKTOP" "DIRTY (SKIPPED)" "${dirty_count} edits" "$dur"
    else
      log_card_end "UP TO DATE" "Matches ${upstream_ref}" "$dur"
      record_result "$id" "DESKTOP" "UP TO DATE" "Up to date" "$dur"
    fi
    return 0
  fi

  if [[ $dirty_count -gt 0 && $FORCE_GIT -eq 0 ]]; then
    log_step "Detected ${dirty_count} uncommitted files (use --force-git to stash & restore)"
    dur="$(elapsed_since "$t_start")"
    log_card_end "DIRTY (SKIPPED)" "${dirty_count} uncommitted files" "$dur"
    record_result "$id" "DESKTOP" "DIRTY (SKIPPED)" "${dirty_count} edits" "$dur"
    return 0
  fi

  if [[ $FORCE_GIT -eq 1 && $dirty_count -gt 0 ]]; then
    log_step "Stashing ${dirty_count} local change(s) (--force-git)..."
    if git -C "$repo_dir" stash push -u -m "Auto-stashed by aiup" &>/dev/null; then
      stashed=1
    fi
  fi

  log_step "Pulling latest commits from ${upstream_ref}..."
  git_out=$(git -C "$repo_dir" pull --ff-only "$remote_name" "$branch_name" 2>&1) || pull_rc=$?

  if [[ $pull_rc -ne 0 ]]; then
    log_step "Git pull failed (non-fast-forward or network error)"
    printf '%s\n' "$git_out" | stream_progress 3
    if [[ $stashed -eq 1 ]]; then
      git -C "$repo_dir" stash pop &>/dev/null || log_step "Note: stashed edits kept in 'git stash list'"
    fi
    dur="$(elapsed_since "$t_start")"
    log_card_end "FAILED" "Git pull error (${pull_rc})" "$dur"
    record_result "$id" "DESKTOP" "FAILED" "Git pull error" "$dur"
    return 0
  fi

  if printf '%s\n' "$git_out" | grep -qi "Already up to date"; then
    if [[ $stashed -eq 1 ]]; then
      log_step "Restoring stashed local changes..."
      git -C "$repo_dir" stash pop &>/dev/null || log_step "Note: stashed edits kept in 'git stash list'"
    fi
    dur="$(elapsed_since "$t_start")"
    log_card_end "UP TO DATE" "Already up to date" "$dur"
    record_result "$id" "DESKTOP" "UP TO DATE" "Up to date" "$dur"
    return 0
  fi

  log_step "Running build/dependency sync: ${build_cmd}"
  NPM_DID_UPDATE=1
  (cd "$repo_dir" && bash -lc "$build_cmd") 2>&1 | stream_progress 6 || build_rc=$?

  if [[ $stashed -eq 1 ]]; then
    log_step "Restoring stashed local changes..."
    git -C "$repo_dir" stash pop &>/dev/null || log_step "Warning: stash pop had conflicts; run 'git stash pop' manually"
  fi

  dur="$(elapsed_since "$t_start")"
  if [[ $build_rc -ne 0 ]]; then
    log_card_end "FAILED" "Pulled commits, build exited ${build_rc}" "$dur"
    record_result "$id" "DESKTOP" "FAILED" "Build failed (${build_rc})" "$dur"
  else
    log_card_end "UPDATED" "Pulled & synced workspace" "$dur"
    record_result "$id" "DESKTOP" "UPDATED" "Pulled & built" "$dur"
  fi
}

