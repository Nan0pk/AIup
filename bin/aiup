#!/usr/bin/env bash
# ==============================================================================
# aiup - The Universal AI Harness & Desktop App Updater
# Repository: https://github.com/Nan0pk/AIup
# License: MIT
# ==============================================================================

set -uo pipefail

VERSION="1.1.0"

# Detect Operating System & Architecture (preserve Windows $env:OS for child processes)
HOST_OS="$(uname -s)"
ARCH="$(uname -m)"
IS_LINUX=0
IS_MACOS=0
IS_WINDOWS=0

case "$HOST_OS" in
  Linux*)  IS_LINUX=1 ;;
  Darwin*) IS_MACOS=1 ;;
  MINGW*|MSYS*|CYGWIN*) IS_WINDOWS=1 ;;
  *)
    if [[ "${OS:-}" == "Windows_NT" || -n "${WINDIR:-}" ]]; then
      IS_WINDOWS=1
    fi
    ;;
esac

if [[ $IS_WINDOWS -eq 1 ]]; then
  export PYTHONIOENCODING="utf-8"
  export PYTHONUTF8="1"
fi

# Detect Package Manager
PKG_MGR="unknown"
HAS_WINGET=0
HAS_CHOCO=0
HAS_SCOOP=0

if [[ $IS_LINUX -eq 1 ]]; then
  if command -v dnf &>/dev/null; then
    PKG_MGR="dnf"
  elif command -v apt-get &>/dev/null; then
    PKG_MGR="apt"
  elif command -v pacman &>/dev/null; then
    PKG_MGR="pacman"
  elif command -v zypper &>/dev/null; then
    PKG_MGR="zypper"
  fi
elif [[ $IS_MACOS -eq 1 ]]; then
  command -v brew &>/dev/null && PKG_MGR="brew"
elif [[ $IS_WINDOWS -eq 1 ]]; then
  command -v winget.exe &>/dev/null && HAS_WINGET=1
  command -v choco.exe &>/dev/null && HAS_CHOCO=1
  command -v scoop &>/dev/null && HAS_SCOOP=1
  if [[ $HAS_WINGET -eq 1 ]]; then
    PKG_MGR="winget"
  elif [[ $HAS_SCOOP -eq 1 ]]; then
    PKG_MGR="scoop"
  elif [[ $HAS_CHOCO -eq 1 ]]; then
    PKG_MGR="choco"
  fi
fi

# Determine color support early across ALL arguments
USE_COLOR=1
if [[ ! -t 1 || "${NO_COLOR:-}" == "1" || "${TERM:-}" == "dumb" ]]; then
  USE_COLOR=0
fi
for _arg in "$@"; do
  if [[ "$_arg" == "--no-color" || "$_arg" == "--json" ]]; then
    USE_COLOR=0
    break
  fi
done

if [[ $USE_COLOR -eq 1 ]]; then
  BOLD="\033[1m"
  DIM="\033[2m"
  RED="\033[1;31m"
  GREEN="\033[1;32m"
  YELLOW="\033[1;33m"
  BLUE="\033[1;34m"
  CYAN="\033[1;36m"
  MAGENTA="\033[1;35m"
  GRAY="\033[38;5;244m"
  LIGHT_GRAY="\033[38;5;250m"
  RESET="\033[0m"
else
  BOLD=""
  DIM=""
  RED=""
  GREEN=""
  YELLOW=""
  BLUE=""
  CYAN=""
  MAGENTA=""
  GRAY=""
  LIGHT_GRAY=""
  RESET=""
fi

# Execution state
declare -a REPORT_NAMES=()
declare -a REPORT_TYPES=()
declare -a REPORT_STATUS=()
declare -a REPORT_DETAILS=()
declare -a REPORT_DURATIONS=()

DRY_RUN=0          # 1 for -c/--check
LIST_ONLY=0        # 1 for -l/--list
FILTER_TYPE="all"  # "all", "cli", "desktop", "clean"
OUTPUT_FORMAT="text" # "text", "json"
FORCE_GIT=0
FORCE_PREAUTH=0    # 1 for -S/--sudo
NO_SUDO=0
DO_CLEANUP=1
NPM_DID_UPDATE=0
SUDO_KEEP_ALIVE_PID=""
declare -a ONLY_TARGETS=()
declare -a SKIP_TARGETS=()
declare -a PYTHON_CMD=()

cleanup_on_exit() {
  if [[ -n "${SUDO_KEEP_ALIVE_PID:-}" ]]; then
    kill "$SUDO_KEEP_ALIVE_PID" 2>/dev/null || true
  fi
}
trap cleanup_on_exit EXIT

# ==============================================================================
# CROSS-PLATFORM PATH & RUNTIME HELPERS
# ==============================================================================
to_posix_path() {
  local p="$1"
  [[ -z "$p" ]] && return 0
  if [[ $IS_WINDOWS -eq 1 ]] && command -v cygpath &>/dev/null; then
    cygpath -u "$p" 2>/dev/null || printf '%s\n' "$p"
  else
    printf '%s\n' "$p"
  fi
}

to_native_path() {
  local p="$1"
  [[ -z "$p" ]] && return 0
  if [[ $IS_WINDOWS -eq 1 ]] && command -v cygpath &>/dev/null; then
    cygpath -w "$p" 2>/dev/null || printf '%s\n' "$p"
  else
    printf '%s\n' "$p"
  fi
}

LOCALAPPDATA_DIR=""
APPDATA_DIR=""
PROGRAMFILES_DIR=""
PROGRAMFILES_X86_DIR=""

if [[ $IS_WINDOWS -eq 1 ]]; then
  LOCALAPPDATA_DIR="$(to_posix_path "${LOCALAPPDATA:-${USERPROFILE:-$HOME}/AppData/Local}")"
  APPDATA_DIR="$(to_posix_path "${APPDATA:-${USERPROFILE:-$HOME}/AppData/Roaming}")"
  PROGRAMFILES_DIR="$(to_posix_path "${PROGRAMFILES:-/c/Program Files}")"
  _pf86="$(printenv 'ProgramFiles(x86)' 2>/dev/null || echo '')"
  PROGRAMFILES_X86_DIR="$(to_posix_path "${_pf86:-/c/Program Files (x86)}")"
  unset _pf86
fi

detect_python() {
  local cand
  local -a py_order=("python3" "python")
  if [[ $IS_WINDOWS -eq 1 ]]; then
    # On Windows, prefer `python` (real install ahead on PATH) over Microsoft Store/Manager `python3` shim
    py_order=("python" "python3")
  fi
  for cand in "${py_order[@]}"; do
    if command -v "$cand" &>/dev/null && "$cand" -c "import re, sys" &>/dev/null; then
      PYTHON_CMD=("$cand")
      return 0
    fi
  done
  if [[ $IS_WINDOWS -eq 1 ]]; then
    if command -v py &>/dev/null && py -3 -c "import re, sys" &>/dev/null; then
      PYTHON_CMD=("py" "-3")
      return 0
    fi
    local p
    for p in /c/Python3*/python.exe "${LOCALAPPDATA_DIR:-}/Programs/Python/Python3"*/python.exe; do
      if [[ -f "$p" ]] && "$p" -c "import re, sys" &>/dev/null; then
        PYTHON_CMD=("$p")
        return 0
      fi
    done
  fi
  return 1
}

run_py() {
  if [[ ${#PYTHON_CMD[@]} -eq 0 ]]; then
    detect_python || return 1
  fi
  "${PYTHON_CMD[@]}" "$@"
}

# Initialize Python early when present
detect_python || true

strip_cr() {
  tr -d '\r'
}

json_get_file() {
  local file_path="$1"
  local expr="$2"
  [[ -f "$file_path" ]] || return 1
  if command -v jq &>/dev/null; then
    jq -r "$expr" "$file_path" 2>/dev/null | strip_cr
    return $?
  fi
  local native_path
  native_path="$(to_native_path "$file_path")"
  run_py -c '
import json, sys
try:
    with open(sys.argv[1], "r", encoding="utf-8") as f:
        data = json.load(f)
    val = data
    for key in sys.argv[2].split("."):
        if not key:
            continue
        if isinstance(val, dict):
            val = val.get(key)
        else:
            val = None
            break
    if val is not None:
        print(val)
except Exception:
    pass
' "$native_path" "$expr" 2>/dev/null
}

json_get_stdin() {
  local key="$1"
  if command -v jq &>/dev/null; then
    jq -r ".${key} // empty" 2>/dev/null | strip_cr
    return $?
  fi
  run_py -c '
import json, sys
try:
    data = json.load(sys.stdin)
    val = data
    for part in sys.argv[1].split("."):
        if not part:
            continue
        val = val.get(part) if isinstance(val, dict) else None
    if val is not None:
        print(val)
except Exception:
    pass
' "$key" 2>/dev/null
}

resolve_bin() {
  local name="$1"
  local found=""
  if found="$(command -v "$name" 2>/dev/null)" && [[ -n "$found" ]]; then
    printf '%s\n' "$found"
    return 0
  fi

  local -a cands=()
  case "$name" in
    agy)
      cands=("${HOME}/.local/bin/agy" "${LOCALAPPDATA_DIR:-}/agy/bin/agy.exe") ;;
    claude)
      cands=("${HOME}/.local/bin/claude" "${HOME}/.local/bin/claude.exe" "${LOCALAPPDATA_DIR:-}/Programs/claude/claude.exe") ;;
    codex)
      cands=("${LOCALAPPDATA_DIR:-}/Programs/OpenAI/Codex/bin/codex.exe" "${LOCALAPPDATA_DIR:-}/OpenAI/Codex/bin/codex.exe" "${HOME}/.local/bin/codex") ;;
    hermes)
      cands=("${HOME}/.local/bin/hermes" "${LOCALAPPDATA_DIR:-}/hermes/bin/hermes.exe") ;;
    opencode)
      cands=("${HOME}/.opencode/bin/opencode" "${HOME}/.opencode/bin/opencode.exe" "${HOME}/.local/bin/opencode" "${LOCALAPPDATA_DIR:-}/Programs/opencode/opencode.exe") ;;
    uv)
      cands=("${HOME}/.local/bin/uv" "${HOME}/.local/bin/uv.exe" "${HOME}/.cargo/bin/uv" "${HOME}/.cargo/bin/uv.exe" "${LOCALAPPDATA_DIR:-}/hermes/bin/uv.exe") ;;
    ollama)
      cands=("/usr/local/bin/ollama" "${LOCALAPPDATA_DIR:-}/Programs/Ollama/ollama.exe" "${PROGRAMFILES_DIR:-}/Ollama/ollama.exe") ;;
    lms)
      cands=("${HOME}/.lmstudio/bin/lms" "${HOME}/.lmstudio/bin/lms.exe" "${HOME}/.cache/lm-studio/bin/lms") ;;
    copilot)
      cands=("${HOME}/.local/bin/copilot" "${HOME}/.local/bin/copilot.exe") ;;
    *)
      cands=("${HOME}/.local/bin/${name}" "${HOME}/.local/bin/${name}.exe") ;;
  esac

  local p
  for p in "${cands[@]}"; do
    if [[ -n "$p" && -f "$p" ]]; then
      if [[ $IS_WINDOWS -eq 1 && "$p" == *.exe ]] || [[ -x "$p" ]]; then
        printf '%s\n' "$p"
        return 0
      fi
    fi
  done
  return 1
}

usage() {
  echo -e "${BOLD}${CYAN}╭──────────────────────────────────────────────────────────────╮${RESET}"
  echo -e "${BOLD}${CYAN}│${RESET}  ${BOLD}⚡ AIUP${RESET} — Universal AI Harness & Desktop App Updater     ${BOLD}${CYAN}│${RESET}"
  echo -e "${BOLD}${CYAN}│${RESET}  ${DIM}Version ${VERSION}  •  https://github.com/Nan0pk/AIup${RESET}           ${BOLD}${CYAN}│${RESET}"
  echo -e "${BOLD}${CYAN}╰──────────────────────────────────────────────────────────────╯${RESET}"
  echo ""
  echo -e "${BOLD}USAGE:${RESET}"
  echo "    aiup [OPTIONS]"
  echo "    uai  [OPTIONS]"
  echo ""
  echo -e "${BOLD}OPTIONS:${RESET}"
  echo -e "    ${CYAN}-h, --help${RESET}            Show this documentation"
  echo -e "    ${CYAN}-v, --version${RESET}         Show version number"
  echo -e "    ${CYAN}-l, --list${RESET}            List detected CLI and Desktop AI apps & versions"
  echo -e "    ${CYAN}-c, --check${RESET}           Non-mutating check for available updates/debloat"
  echo -e "    ${CYAN}-C, --clean${RESET}           Run housekeeping, cache purge & debloat scope only"
  echo -e "    ${CYAN}--no-clean${RESET}            Skip post-update housekeeping and cache debloat"
  echo -e "    ${CYAN}-S, --sudo${RESET}            Pre-authenticate sudo at startup (if safe) for unattended sync"
  echo -e "    ${CYAN}--no-sudo${RESET}             Disable elevation prompts (skip/cache privileged updates)"
  echo -e "    ${CYAN}--cli${RESET}                 Only target CLI harnesses and agent runtimes"
  echo -e "    ${CYAN}--desktop${RESET}             Only target Desktop AI apps and UI workspaces"
  echo -e "    ${CYAN}-o, --only <names>${RESET}    Only run specified targets (comma-separated)"
  echo -e "    ${CYAN}-s, --skip <names>${RESET}    Skip specified targets (comma-separated)"
  echo -e "    ${CYAN}--json${RESET}                Output results in JSON format"
  echo -e "    ${CYAN}--force-git${RESET}           Stash, pull, and restore dirty git checkouts"
  echo -e "    ${CYAN}--no-color${RESET}            Disable colored terminal output"
  echo ""
  echo -e "${BOLD}SUPPORTED TARGETS:${RESET}"
  echo -e "  ${CYAN}◈ CLI Engines:${RESET}     agy, claude, codex, hermes, opencode, mimo, kilo, goose, uv-tools, pip-ai, npm-globals, ollama, lms"
  echo -e "  ${MAGENTA}❖ Desktop Apps:${RESET}    chatgpt, opencode-desktop, aionui, antigravity-desktop, zcode, copilot, claude-desktop, codex-desktop, cowork-os, orkas, hermes-desktop"
  echo -e "  ${BLUE}🧹 Housekeeping:${RESET}   clean-uv, clean-npm, clean-pip, clean-installers, clean-git, clean-electron, clean-dnf, clean-dumps"
  echo ""
  echo -e "${BOLD}EXAMPLES:${RESET}"
  echo "    aiup                    # Update everything with live progress & debloat afterwards"
  echo "    aiup -l                 # Visual dashboard of detected installed versions"
  echo "    aiup -c                 # Safe dry-run check without modifying files"
  echo "    aiup -C                 # Run housekeeping & cache debloat only"
  echo "    aiup -c -C              # Dry-run housekeeping check (shows reclaimable cache)"
  echo "    aiup -S                 # Pre-authenticate sudo upfront if safe"
  echo "    aiup --no-clean         # Update only, skip housekeeping"
  echo "    aiup -o opencode,claude # Target specific apps"
  echo "    aiup -l --json          # Structured JSON inventory for automations"
  exit 0
}

require_arg_value() {
  local opt="$1"
  local val="${2:-}"
  if [[ -z "$val" || "$val" == -* ]]; then
    echo -e "${RED}[ERROR]${RESET} Option ${opt} requires a non-empty value." >&2
    exit 2
  fi
}

# Parse Arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      ;;
    -v|--version)
      echo "aiup version ${VERSION} (${HOST_OS} ${ARCH})"
      exit 0
      ;;
    -l|--list)
      LIST_ONLY=1
      shift
      ;;
    -c|--check)
      DRY_RUN=1
      shift
      ;;
    -C|--clean|--debloat)
      FILTER_TYPE="clean"
      DO_CLEANUP=1
      shift
      ;;
    --no-clean|--skip-clean|--skip-cleanup)
      DO_CLEANUP=0
      shift
      ;;
    -S|--sudo)
      FORCE_PREAUTH=1
      shift
      ;;
    --no-sudo)
      NO_SUDO=1
      shift
      ;;
    --cli)
      FILTER_TYPE="cli"
      shift
      ;;
    --desktop)
      FILTER_TYPE="desktop"
      shift
      ;;
    --json)
      OUTPUT_FORMAT="json"
      shift
      ;;
    --force-git)
      FORCE_GIT=1
      shift
      ;;
    --no-color)
      shift
      ;;
    -o|--only)
      require_arg_value "$1" "${2:-}"
      IFS=',' read -r -a targets <<< "$2"
      for t in "${targets[@]}"; do
        t_clean="$(printf '%s' "$t" | tr '[:upper:]' '[:lower:]' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        [[ -n "$t_clean" ]] && ONLY_TARGETS+=("$t_clean")
      done
      shift 2
      ;;
    -s|--skip)
      require_arg_value "$1" "${2:-}"
      IFS=',' read -r -a targets <<< "$2"
      for t in "${targets[@]}"; do
        t_clean="$(printf '%s' "$t" | tr '[:upper:]' '[:lower:]' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        [[ -n "$t_clean" ]] && SKIP_TARGETS+=("$t_clean")
      done
      shift 2
      ;;
    *)
      echo -e "${RED}[ERROR]${RESET} Unknown option: $1" >&2
      usage
      ;;
  esac
done

# Derive normalized mode label for UI/JSON
if [[ $LIST_ONLY -eq 1 ]]; then
  MODE_LABEL="list"
elif [[ $DRY_RUN -eq 1 ]]; then
  MODE_LABEL="check"
elif [[ "$FILTER_TYPE" == "clean" ]]; then
  MODE_LABEL="clean"
else
  MODE_LABEL="update"
fi

# ==============================================================================
# HELPERS & UTILITIES
# ==============================================================================
should_run() {
  local name="$1"
  local type="$2" # "cli", "desktop", or "clean"
  local lower_name
  lower_name="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')"

  if [[ "$FILTER_TYPE" == "cli" && "$type" != "cli" ]]; then
    return 1
  fi
  if [[ "$FILTER_TYPE" == "desktop" && "$type" != "desktop" ]]; then
    return 1
  fi
  if [[ "$FILTER_TYPE" == "clean" && "$type" != "clean" ]]; then
    return 1
  fi
  if [[ "$FILTER_TYPE" == "all" && "$type" == "clean" && $DO_CLEANUP -eq 0 ]]; then
    return 1
  fi

  for s in "${SKIP_TARGETS[@]:-}"; do
    [[ -n "$s" && "$lower_name" == "$s" ]] && return 1
  done

  if [[ ${#ONLY_TARGETS[@]} -gt 0 ]]; then
    for o in "${ONLY_TARGETS[@]}"; do
      [[ -n "$o" && "$lower_name" == "$o" ]] && return 0
    done
    return 1
  fi

  return 0
}

now_ns() {
  local t
  t="$(date +%s%N 2>/dev/null || true)"
  if [[ "$t" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$t"
  elif run_py -c 'import time; print(int(time.time() * 1_000_000_000))' 2>/dev/null; then
    return 0
  else
    printf '%s000000000\n' "$(date +%s)"
  fi
}

elapsed_since() {
  local t_start="$1"
  local t_end
  t_end="$(now_ns)"
  awk -v s="$t_start" -v e="$t_end" 'BEGIN {printf "%.1fs", (e - s)/1000000000}'
}

record_result() {
  local name="$1"
  local type="$2"
  local status="$3"
  local detail="$4"
  local duration="$5"

  REPORT_NAMES+=("$name")
  REPORT_TYPES+=("$type")
  REPORT_STATUS+=("$status")
  REPORT_DETAILS+=("$detail")
  REPORT_DURATIONS+=("$duration")
}

log_card_start() {
  [[ "$OUTPUT_FORMAT" == "json" ]] && return
  local title="$1"
  local type="$2"
  if [[ "$type" == "cli" ]]; then
    echo -e "${BOLD}${CYAN}┌── ◈ [CLI] ${title}${RESET}"
  elif [[ "$type" == "clean" ]]; then
    echo -e "${BOLD}${BLUE}┌── 🧹 [CLEANUP] ${title}${RESET}"
  else
    echo -e "${BOLD}${MAGENTA}┌── ❖ [DESKTOP] ${title}${RESET}"
  fi
}

log_step() {
  [[ "$OUTPUT_FORMAT" == "json" ]] && return
  local msg="$1"
  echo -e "  ${DIM}│${RESET}   ${GRAY}↳${RESET} ${LIGHT_GRAY}${msg}${RESET}"
}

log_card_end() {
  [[ "$OUTPUT_FORMAT" == "json" ]] && return
  local status="$1"
  local detail="$2"
  local dur="$3"
  local badge=""

  case "$status" in
    UPDATED)           badge="${GREEN}✔ [UPDATED]${RESET}" ;;
    CLEANED|DEBLOATED) badge="${GREEN}✔ [CLEANED]${RESET}" ;;
    "UP TO DATE")      badge="${GREEN}✔ [UP-TO-DATE]${RESET}" ;;
    "UPDATE AVAIL")    badge="${YELLOW}★ [UPDATE AVAILABLE]${RESET}" ;;
    "DIRTY (SKIPPED)") badge="${YELLOW}▲ [DIRTY TREE]${RESET}" ;;
    CACHED)            badge="${CYAN}⇣ [CACHED]${RESET}" ;;
    SKIPPED)           badge="${GRAY}⊘ [SKIPPED]${RESET}" ;;
    FAILED)            badge="${RED}✖ [FAILED]${RESET}" ;;
    *)                 badge="${CYAN}• [${status}]${RESET}" ;;
  esac

  echo -e "  ${DIM}└──${RESET} ${badge} ${detail} ${GRAY}[${dur}]${RESET}\n"
}

# Drains stdin completely so upstream never receives SIGPIPE under pipefail
stream_progress() {
  local max_lines="${1:-6}"
  local count=0
  local esc_strip=$'s/\x1B\\[[0-9;?]*[a-zA-Z]//g'
  while IFS= read -r line; do
    if [[ "$OUTPUT_FORMAT" == "json" ]] || [[ $count -ge $max_lines ]]; then
      continue
    fi
    line="$(printf '%s' "$line" | tr '\r' '\n' | tail -n 1 | sed -E "$esc_strip" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    [[ -z "$line" ]] && continue
    if [[ "$line" =~ ^[═─━_=-]{3,}$ ]] || [[ "$line" =~ ^[█░▒◒◐◓◑\\|/-]+$ ]]; then
      continue
    fi
    if [[ ${#line} -gt 74 ]]; then
      line="${line:0:71}..."
    fi
    echo -e "  ${DIM}│${RESET}   ${GRAY}↳${RESET} ${DIM}${line}${RESET}"
    ((count++)) || true
  done
}

is_version_gt() {
  local candidate="$1"
  local current="$2"
  local py=""
  if command -v python3 &>/dev/null && python3 -c "import re, sys" &>/dev/null; then
    py="python3"
  elif command -v python &>/dev/null && python -c "import re, sys" &>/dev/null; then
    py="python"
  else
    return 1
  fi
  "$py" -c '
import re, sys

def norm(s):
    s = s.strip().lstrip("vV")
    main, _, pre = s.partition("-")
    parts = [int(x) for x in re.findall(r"\d+", main)]
    # Stable release > prerelease for same base tuple
    return (parts, 0 if pre else 1, pre)

c, l = norm(sys.argv[1]), norm(sys.argv[2])
sys.exit(0 if c > l else 1)
' "$candidate" "$current" 2>/dev/null
}

verify_sha512_b64() {
  local file_path="$1"
  local expected_b64="$2"
  local py=""
  if command -v python3 &>/dev/null && python3 -c "import re, sys" &>/dev/null; then
    py="python3"
  elif command -v python &>/dev/null && python -c "import re, sys" &>/dev/null; then
    py="python"
  else
    return 1
  fi
  if command -v cygpath &>/dev/null; then
    file_path="$(cygpath -w "$file_path" 2>/dev/null || printf '%s' "$file_path")"
  fi
  "$py" -c '
import base64, hashlib, sys
h = hashlib.sha512()
with open(sys.argv[1], "rb") as f:
    for chunk in iter(lambda: f.read(1048576), b""):
        h.update(chunk)
actual = base64.b64encode(h.digest()).decode("ascii")
sys.exit(0 if actual == sys.argv[2].strip() else 1)
' "$file_path" "$expected_b64" 2>/dev/null
}

verify_sha256_hex() {
  local file_path="$1"
  local expected_hex="$2"
  local native_path
  native_path="$(to_native_path "$file_path")"
  run_py -c '
import hashlib, sys
h = hashlib.sha256()
with open(sys.argv[1], "rb") as f:
    for chunk in iter(lambda: f.read(1048576), b""):
        h.update(chunk)
sys.exit(0 if h.hexdigest().lower() == sys.argv[2].strip().lower() else 1)
' "$native_path" "$expected_hex" 2>/dev/null
}

dir_size_human() {
  local dir_path="$1"
  [[ -d "$dir_path" ]] || { echo "0B"; return 0; }
  if [[ $IS_WINDOWS -eq 1 ]]; then
    local native_path
    native_path="$(to_native_path "$dir_path")"
    run_py -c '
import os, sys
total = 0
stack = [sys.argv[1]]
while stack:
    d = stack.pop()
    try:
        with os.scandir(d) as it:
            for e in it:
                try:
                    if e.is_dir(follow_symlinks=False):
                        stack.append(e.path)
                    elif e.is_file(follow_symlinks=False):
                        total += e.stat(follow_symlinks=False).st_size
                except OSError:
                    pass
    except OSError:
        pass
units = [("G", 1073741824), ("M", 1048576), ("K", 1024)]
for suffix, div in units:
    if total >= div:
        print(f"{total / div:.1f}{suffix}")
        sys.exit(0)
print(f"{total}B")
' "$native_path" 2>/dev/null || echo "0B"
  else
    du -sh "$dir_path" 2>/dev/null | awk '{print $1}' || echo "0B"
  fi
}

count_files_in_dir() {
  local dir_path="$1"
  [[ -d "$dir_path" ]] || { echo "0"; return 0; }
  if [[ $IS_WINDOWS -eq 1 ]]; then
    local native_path
    native_path="$(to_native_path "$dir_path")"
    run_py -c '
import os, sys
c = 0
stack = [sys.argv[1]]
while stack:
    d = stack.pop()
    try:
        with os.scandir(d) as it:
            for e in it:
                if e.is_dir(follow_symlinks=False):
                    stack.append(e.path)
                elif e.is_file(follow_symlinks=False):
                    c += 1
    except OSError:
        pass
print(c)
' "$native_path" 2>/dev/null || echo "0"
  else
    { find "$dir_path" -type f 2>/dev/null || true; } | wc -l | awk '{print $1}'
  fi
}

scan_or_prune_old_files() {
  # Usage: scan_or_prune_old_files <mode: scan|prune> <pattern> <days> <dir1> [dir2 ...]
  # Outputs: "<count> <human_size>"
  local mode="$1"
  local pattern="$2"
  local days="$3"
  shift 3

  local -a existing=()
  local d
  for d in "$@"; do
    [[ -d "$d" ]] && existing+=("$d")
  done
  if [[ ${#existing[@]} -eq 0 ]]; then
    echo "0 0B"
    return 0
  fi

  if [[ $IS_WINDOWS -eq 1 ]]; then
    local -a native_dirs=()
    for d in "${existing[@]}"; do
      native_dirs+=("$(to_native_path "$d")")
    done
    run_py -c '
import fnmatch, os, sys, time
mode, pattern, days = sys.argv[1], sys.argv[2], float(sys.argv[3])
cutoff = time.time() - days * 86400.0
count = 0
total_bytes = 0
dirs_to_check = []
stack = list(sys.argv[4:])
while stack:
    cur = stack.pop()
    try:
        with os.scandir(cur) as it:
            for e in it:
                try:
                    if e.is_dir(follow_symlinks=False):
                        stack.append(e.path)
                        dirs_to_check.append(e.path)
                    elif e.is_file(follow_symlinks=False) and fnmatch.fnmatch(e.name.lower(), pattern.lower()):
                        st = e.stat(follow_symlinks=False)
                        if st.st_mtime < cutoff:
                            if mode == "prune":
                                os.unlink(e.path)
                            count += 1
                            total_bytes += st.st_size
                except OSError:
                    pass
    except OSError:
        pass
if mode == "prune":
    for dp in sorted(dirs_to_check, key=len, reverse=True):
        try:
            if not os.listdir(dp):
                os.rmdir(dp)
        except OSError:
            pass
if total_bytes >= 1048576:
    sz = f"{total_bytes / 1048576:.1f}MB"
elif total_bytes >= 1024:
    sz = f"{total_bytes / 1024:.0f}KB"
else:
    sz = f"{total_bytes}B"
print(f"{count} {sz}")
' "$mode" "$pattern" "$days" "${native_dirs[@]}" 2>/dev/null || echo "0 0B"
  else
    local count bytes human
    count=$({ find "${existing[@]}" -type f -name "$pattern" -mtime +"$days" 2>/dev/null || true; } | wc -l | awk '{print $1}')
    if [[ "${count:-0}" -gt 0 ]]; then
      bytes=$({ find "${existing[@]}" -type f -name "$pattern" -mtime +"$days" -exec wc -c {} + 2>/dev/null || true; } | awk '{sum+=$1} END {print sum+0}')
      if [[ "$mode" == "prune" ]]; then
        find "${existing[@]}" -type f -name "$pattern" -mtime +"$days" -delete 2>/dev/null || true
        find "${existing[@]}" -type d -empty -delete 2>/dev/null || true
      fi
      human=$(awk -v b="${bytes:-0}" 'BEGIN {if (b>=1048576) printf "%.1fMB", b/1048576; else if (b>=1024) printf "%.0fKB", b/1024; else printf "%dB", b}')
      echo "${count} ${human}"
    else
      echo "0 0B"
    fi
  fi
}

keep_sudo_alive() {
  [[ $IS_WINDOWS -eq 1 ]] && return 0
  if [[ -z "${SUDO_KEEP_ALIVE_PID:-}" ]]; then
    while true; do
      sudo -n true 2>/dev/null || exit 0
      sleep 50
    done 2>/dev/null &
    SUDO_KEEP_ALIVE_PID=$!
  fi
}

run_privileged() {
  local prompt_desc="${1:-system update}"
  shift || true

  if [[ $IS_WINDOWS -eq 1 ]]; then
    if net session &>/dev/null; then
      "$@"
      return $?
    fi
    if [[ $NO_SUDO -eq 1 || "${CI:-}" == "true" || "${AIUP_NONINTERACTIVE:-}" == "1" ]]; then
      return 2
    fi
    "$@"
    return $?
  fi

  if sudo -n true 2>/dev/null; then
    keep_sudo_alive
    sudo "$@"
    return $?
  fi

  if [[ $NO_SUDO -eq 1 || "${CI:-}" == "true" || "${DEBIAN_FRONTEND:-}" == "noninteractive" || "${AIUP_NONINTERACTIVE:-}" == "1" ]]; then
    return 2
  fi

  if [[ -t 0 ]]; then
    log_step "Administrator privileges required for ${prompt_desc}"
    if sudo -v </dev/tty >/dev/tty 2>&1; then
      keep_sudo_alive
      sudo "$@"
      return $?
    fi
    return 1
  fi

  if [[ (-n "${DISPLAY:-}" || -n "${WAYLAND_DISPLAY:-}") ]] && command -v pkexec &>/dev/null; then
    log_step "Requesting desktop authorization via pkexec (${prompt_desc})..."
    pkexec "$@"
    return $?
  fi

  return 2
}

preauth_sudo_if_safe() {
  # Pre-authenticate at startup ONLY when -S/--sudo is passed and it is safe
  [[ $IS_WINDOWS -eq 1 ]] && return 0
  [[ $FORCE_PREAUTH -eq 0 ]] && return 0
  [[ $DRY_RUN -eq 1 || $LIST_ONLY -eq 1 || $NO_SUDO -eq 1 ]] && return 0
  [[ "$FILTER_TYPE" == "cli" || "$FILTER_TYPE" == "clean" ]] && return 0
  [[ "${CI:-}" == "true" || "${DEBIAN_FRONTEND:-}" == "noninteractive" || "${AIUP_NONINTERACTIVE:-}" == "1" ]] && return 0
  [[ ! -t 0 ]] && return 0

  if sudo -n true 2>/dev/null; then
    keep_sudo_alive
    return 0
  fi

  if [[ "$OUTPUT_FORMAT" != "json" ]]; then
    echo -e "${DIM}┌──${RESET} ${BOLD}${CYAN}🔒 Administrator Privileges (sudo)${RESET}"
    echo -e "  ${DIM}│${RESET}   ${GRAY}↳${RESET} ${LIGHT_GRAY}Pre-authenticating upfront (-S/--sudo) for unattended batch sync...${RESET}"
  fi

  if sudo -v </dev/tty >/dev/tty 2>&1; then
    keep_sudo_alive
    [[ "$OUTPUT_FORMAT" != "json" ]] && echo -e "  ${DIM}└──${RESET} ${GREEN}✔ Sudo session established (active keep-alive)${RESET}\n"
    return 0
  else
    [[ "$OUTPUT_FORMAT" != "json" ]] && echo -e "  ${DIM}└──${RESET} ${YELLOW}⚠ Sudo pre-auth skipped — will prompt only if needed${RESET}\n"
    return 1
  fi
}

get_asar_version() {
  local asar_path="$1"
  if [[ ! -f "$asar_path" ]]; then
    echo "unknown"
    return
  fi
  local native_path
  native_path="$(to_native_path "$asar_path")"
  run_py -c '
import struct, json, sys
try:
    with open(sys.argv[1], "rb") as f:
        f.seek(4)
        total_header_size = struct.unpack("<I", f.read(4))[0]
        base = 8 + total_header_size
        f.seek(12)
        l = struct.unpack("<I", f.read(4))[0]
        h = json.loads(f.read(l).decode("utf-8"))
        off = int(h["files"]["package.json"]["offset"])
        sz = int(h["files"]["package.json"]["size"])
        f.seek(base + off)
        p = json.loads(f.read(sz).decode("utf-8"))
        print(p.get("version", "unknown"))
except Exception:
    print("unknown")
' "$native_path" 2>/dev/null || echo "unknown"
}

_APPX_CACHE_LOADED=0
_APPX_CACHE=""

get_pe_version() {
  local exe_path="$1"
  [[ $IS_WINDOWS -eq 1 && -f "$exe_path" ]] || return 1
  local native_path
  native_path="$(to_native_path "$exe_path")"
  powershell.exe -NoProfile -NonInteractive -Command "\$v=(Get-Item -LiteralPath '$native_path').VersionInfo; if(\$v.ProductVersion){\$v.ProductVersion}elseif(\$v.FileVersion){\$v.FileVersion}" < /dev/null 2>/dev/null | strip_cr | awk 'NF{print $1; exit}'
}

ensure_appx_cache() {
  [[ $IS_WINDOWS -eq 1 ]] || return 1
  [[ $_APPX_CACHE_LOADED -eq 1 ]] && return 0
  _APPX_CACHE_LOADED=1
  _APPX_CACHE="$(powershell.exe -NoProfile -NonInteractive -Command "Get-AppxPackage | Where-Object { \$_.Name -match 'ChatGPT|Claude|OpenAI\.Codex|Microsoft\.Copilot|Microsoft\.365Copilot|Hermes' } | ForEach-Object { \$_.Name + '|' + \$_.Version }" < /dev/null 2>/dev/null | strip_cr || true)"
}

get_appx_version() {
  local substr="$1"
  [[ $IS_WINDOWS -eq 1 ]] || return 1
  ensure_appx_cache || return 1
  printf '%s\n' "$_APPX_CACHE" | awk -F'|' -v pat="$substr" 'index(tolower($1), tolower(pat)) > 0 {print $2; exit}'
}

# Queries winget for an exact package ID. Prints "installed|available|source" on stdout.
winget_query_pkg() {
  local pkg_id="$1"
  [[ $HAS_WINGET -eq 1 ]] || return 1
  local raw
  raw="$(winget.exe list --exact --id "$pkg_id" --accept-source-agreements --disable-interactivity < /dev/null 2>/dev/null | strip_cr || true)"
  [[ -n "$raw" ]] || return 1
  run_py -c '
import re, sys
raw, pkg_id = sys.argv[1], sys.argv[2]
lines = []
for blk in raw.splitlines():
    part = blk.split("\r")[-1]
    if part.strip():
        lines.append(part)
sep_idx = next((i for i, l in enumerate(lines) if len(l.strip()) >= 10 and set(l.strip()) == {"-"}), -1)
if sep_idx <= 0:
    sys.exit(1)
hdr = lines[sep_idx - 1]
idx_id = hdr.find("Id")
idx_ver = hdr.find("Version")
idx_avail = hdr.find("Available")
idx_src = hdr.find("Source")
if idx_id < 0 or idx_ver < 0:
    sys.exit(1)
for row in lines[sep_idx + 1:]:
    m = re.search(re.escape(pkg_id), row, re.I)
    if m:
        after_id = row[m.end():].strip()
        toks = after_id.split()
        if not toks:
            continue
        ver = toks[0]
        avail = ""
        src = ""
        if idx_avail > 0:
            if len(toks) >= 3:
                avail, src = toks[1], toks[2]
            elif len(toks) == 2:
                # Could be "<ver> <avail>" (no source) or "<ver> <source>" (no avail)
                if toks[1].lower() in ("winget", "msstore"):
                    src = toks[1]
                else:
                    avail = toks[1]
        elif len(toks) >= 2:
            src = toks[1]
        print(f"{ver}|{avail}|{src}")
        sys.exit(0)
sys.exit(1)
' "$raw" "$pkg_id" 2>/dev/null
}

get_npm_cache_dir() {
  local cache_dir=""
  if command -v npm &>/dev/null; then
    cache_dir="$(npm config get cache 2>/dev/null | strip_cr || true)"
    cache_dir="$(to_posix_path "$cache_dir")"
  fi
  if [[ -z "$cache_dir" || "$cache_dir" == "undefined" ]]; then
    if [[ $IS_WINDOWS -eq 1 ]]; then
      cache_dir="${LOCALAPPDATA_DIR}/npm-cache"
    else
      cache_dir="${HOME}/.npm"
    fi
  fi
  printf '%s\n' "$cache_dir"
}

NPM_ROOT_GLOBAL_CACHE=""

init_npm_root_global() {
  [[ -n "${NPM_ROOT_GLOBAL_CACHE:-}" ]] && return 0
  local node_root="${HOME}/.local/node/lib/node_modules"
  if [[ ! -d "$node_root" ]] && command -v npm &>/dev/null; then
    node_root="$(npm root -g < /dev/null 2>/dev/null | strip_cr || echo '')"
    node_root="$(to_posix_path "$node_root")"
  fi
  NPM_ROOT_GLOBAL_CACHE="$node_root"
}

get_npm_root_global() {
  if [[ -n "${NPM_ROOT_GLOBAL_CACHE:-}" ]]; then
    echo "$NPM_ROOT_GLOBAL_CACHE"
    return 0
  fi
  init_npm_root_global
  echo "$NPM_ROOT_GLOBAL_CACHE"
}

get_npm_pkg_version() {
  local pkg="$1"
  local node_root
  node_root="$(get_npm_root_global)"
  if [[ -n "$node_root" && -f "${node_root}/${pkg}/package.json" ]]; then
    json_get_file "${node_root}/${pkg}/package.json" ".version" || echo ""
  else
    echo ""
  fi
}

get_pip_ai_installed() {
  # Outputs lines of "<pkg> <version>" for installed tracked AI packages
  run_py -c '
import importlib.metadata as m, sys
for pkg in sys.argv[1:]:
    try:
        print(f"{pkg} {m.version(pkg)}")
    except m.PackageNotFoundError:
        pass
' "${TRACKED_PIP_PKGS[@]}" 2>/dev/null | strip_cr
}

