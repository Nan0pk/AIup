# Shared updater helper for CLI self-updaters without a --check dry-run mode
run_self_updater_cli() {
  local id="$1"
  local title="$2"
  local bin="$3"
  local subcmd="$4"
  local step_msg="$5"
  local uptodate_re="$6"
  local updated_re="$7"

  command -v "$bin" &>/dev/null || return 0
  should_run "$id" "cli" || return 0

  log_card_start "$title" "cli"
  local t_start curr_v dur output rc=0 post_v
  t_start=$(date +%s%N)
  curr_v="$(get_version "$id")"

  if [[ $DRY_RUN -eq 1 ]]; then
    log_step "Installed version: ${curr_v}"
    log_step "Skipping update execution (${bin} has no non-mutating --check mode)"
    dur="$(elapsed_since "$t_start")"
    log_card_end "SKIPPED" "v${curr_v#v} (no CLI --check)" "$dur"
    record_result "$id" "CLI" "SKIPPED" "No CLI --check" "$dur"
    return 0
  fi

  log_step "$step_msg"
  output="$("$bin" "$subcmd" 2>&1)" || rc=$?
  printf '%s\n' "$output" | stream_progress 4
  post_v="$(get_version "$id")"
  dur="$(elapsed_since "$t_start")"

  if [[ -n "$updated_re" ]] && printf '%s\n' "$output" | grep -qiE "$updated_re"; then
    log_card_end "UPDATED" "Upgraded to ${post_v}" "$dur"
    record_result "$id" "CLI" "UPDATED" "${post_v}" "$dur"
  elif [[ "$post_v" != "$curr_v" && -n "$post_v" && "$post_v" != "not installed" ]]; then
    log_card_end "UPDATED" "${curr_v} → ${post_v}" "$dur"
    record_result "$id" "CLI" "UPDATED" "${post_v}" "$dur"
  elif [[ $rc -ne 0 ]]; then
    log_card_end "FAILED" "${bin} ${subcmd} exited ${rc}" "$dur"
    record_result "$id" "CLI" "FAILED" "Exit ${rc}" "$dur"
  elif [[ -n "$uptodate_re" ]] && printf '%s\n' "$output" | grep -qiE "$uptodate_re"; then
    log_card_end "UP TO DATE" "Current (${post_v})" "$dur"
    record_result "$id" "CLI" "UP TO DATE" "${post_v}" "$dur"
  else
    log_card_end "UP TO DATE" "Verified (${post_v})" "$dur"
    record_result "$id" "CLI" "UP TO DATE" "${post_v}" "$dur"
  fi
}

# Shared helper for local Electron/Node git desktop workspaces
sync_git_desktop_repo() {
  local id="$1"
  local title="$2"
  local repo_dir="$3"
  local build_cmd="$4"

  [[ -d "${repo_dir}/.git" ]] || return 0
  should_run "$id" "desktop" || return 0

  log_card_start "$title" "desktop"
  local t_start dirty_count local_sha upstream_ref remote_name branch_name remote_sha dur git_out pull_rc=0 build_rc=0 stashed=0
  t_start=$(date +%s%N)
  dirty_count=$(git -C "$repo_dir" status --porcelain 2>/dev/null | wc -l)
  local_sha=$(git -C "$repo_dir" rev-parse HEAD 2>/dev/null || echo "")
  upstream_ref=$(git -C "$repo_dir" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || echo "origin/main")
  remote_name="${upstream_ref%%/*}"
  branch_name="${upstream_ref#*/}"

  log_step "Checking local git working tree (${upstream_ref})..."

  if [[ $DRY_RUN -eq 1 ]]; then
    log_step "Probing ${upstream_ref} (read-only ls-remote)..."
    remote_sha=$(git -C "$repo_dir" ls-remote "$remote_name" "refs/heads/${branch_name}" 2>/dev/null | awk '{print $1}')
    dur="$(elapsed_since "$t_start")"
    if [[ -n "$remote_sha" && "$remote_sha" != "$local_sha" ]]; then
      local note="New commits on ${upstream_ref}"
      [[ $dirty_count -gt 0 ]] && note+=" (${dirty_count} local edits)"
      log_card_end "UPDATE AVAIL" "$note" "$dur"
      record_result "$id" "DESKTOP" "UPDATE AVAIL" "Origin ahead" "$dur"
    elif [[ $dirty_count -gt 0 ]]; then
      log_card_end "DIRTY (SKIPPED)" "${dirty_count} uncommitted files (up to date)" "$dur"
      record_result "$id" "DESKTOP" "DIRTY (SKIPPED)" "${dirty_count} edits" "$dur"
    else
      log_card_end "UP TO DATE" "Matches ${upstream_ref}" "$dur"
      record_result "$id" "DESKTOP" "UP TO DATE" "Up to date" "$dur"
    fi
    return 0
  fi

  if [[ $dirty_count -gt 0 && $FORCE_GIT -eq 0 ]]; then
    log_step "Detected ${dirty_count} uncommitted files (use --force-git to stash & restore)"
    dur="$(elapsed_since "$t_start")"
    log_card_end "DIRTY (SKIPPED)" "${dirty_count} uncommitted files" "$dur"
    record_result "$id" "DESKTOP" "DIRTY (SKIPPED)" "${dirty_count} edits" "$dur"
    return 0
  fi

  if [[ $FORCE_GIT -eq 1 && $dirty_count -gt 0 ]]; then
    log_step "Stashing ${dirty_count} local change(s) (--force-git)..."
    if git -C "$repo_dir" stash push -u -m "Auto-stashed by aiup" &>/dev/null; then
      stashed=1
    fi
  fi

  log_step "Pulling latest commits from ${upstream_ref}..."
  git_out=$(git -C "$repo_dir" pull --ff-only "$remote_name" "$branch_name" 2>&1) || pull_rc=$?

  if [[ $pull_rc -ne 0 ]]; then
    log_step "Git pull failed (non-fast-forward or network error)"
    printf '%s\n' "$git_out" | stream_progress 3
    if [[ $stashed -eq 1 ]]; then
      git -C "$repo_dir" stash pop &>/dev/null || log_step "Note: stashed edits kept in 'git stash list'"
    fi
    dur="$(elapsed_since "$t_start")"
    log_card_end "FAILED" "Git pull error (${pull_rc})" "$dur"
    record_result "$id" "DESKTOP" "FAILED" "Git pull error" "$dur"
    return 0
  fi

  if printf '%s\n' "$git_out" | grep -qi "Already up to date"; then
    if [[ $stashed -eq 1 ]]; then
      log_step "Restoring stashed local changes..."
      git -C "$repo_dir" stash pop &>/dev/null || log_step "Note: stashed edits kept in 'git stash list'"
    fi
    dur="$(elapsed_since "$t_start")"
    log_card_end "UP TO DATE" "Already up to date" "$dur"
    record_result "$id" "DESKTOP" "UP TO DATE" "Up to date" "$dur"
    return 0
  fi

  log_step "Running build/dependency sync: ${build_cmd}"
  NPM_DID_UPDATE=1
  (cd "$repo_dir" && bash -lc "$build_cmd") 2>&1 | stream_progress 6 || build_rc=$?

  if [[ $stashed -eq 1 ]]; then
    log_step "Restoring stashed local changes..."
    git -C "$repo_dir" stash pop &>/dev/null || log_step "Warning: stash pop had conflicts; run 'git stash pop' manually"
  fi

  dur="$(elapsed_since "$t_start")"
  if [[ $build_rc -ne 0 ]]; then
    log_card_end "FAILED" "Pulled commits, build exited ${build_rc}" "$dur"
    record_result "$id" "DESKTOP" "FAILED" "Build failed (${build_rc})" "$dur"
  else
    log_card_end "UPDATED" "Pulled & synced workspace" "$dur"
    record_result "$id" "DESKTOP" "UPDATED" "Pulled & built" "$dur"
  fi
}

