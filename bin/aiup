#!/usr/bin/env bash
# ==============================================================================
# aiup - The Universal AI Harness & Desktop App Updater
# Repository: https://github.com/Nan0pk/AIup
# License: MIT
# ==============================================================================

set -uo pipefail

VERSION="1.0.1"

# Detect Operating System & Architecture
OS="$(uname -s)"
ARCH="$(uname -m)"
case "$OS" in
  Linux*)  IS_LINUX=1; IS_MACOS=0 ;;
  Darwin*) IS_LINUX=0; IS_MACOS=1 ;;
  *)       IS_LINUX=0; IS_MACOS=0 ;;
esac

# Detect Package Manager
PKG_MGR="unknown"
if [[ $IS_LINUX -eq 1 ]]; then
  if command -v dnf &>/dev/null; then
    PKG_MGR="dnf"
  elif command -v apt-get &>/dev/null; then
    PKG_MGR="apt"
  elif command -v pacman &>/dev/null; then
    PKG_MGR="pacman"
  elif command -v zypper &>/dev/null; then
    PKG_MGR="zypper"
  fi
elif [[ $IS_MACOS -eq 1 ]]; then
  PKG_MGR="brew"
fi

# Determine color support early across ALL arguments
USE_COLOR=1
if [[ ! -t 1 || "${NO_COLOR:-}" == "1" || "${TERM:-}" == "dumb" ]]; then
  USE_COLOR=0
fi
for _arg in "$@"; do
  if [[ "$_arg" == "--no-color" || "$_arg" == "--json" ]]; then
    USE_COLOR=0
    break
  fi
done

if [[ $USE_COLOR -eq 1 ]]; then
  BOLD="\033[1m"
  DIM="\033[2m"
  RED="\033[1;31m"
  GREEN="\033[1;32m"
  YELLOW="\033[1;33m"
  BLUE="\033[1;34m"
  CYAN="\033[1;36m"
  MAGENTA="\033[1;35m"
  GRAY="\033[38;5;244m"
  LIGHT_GRAY="\033[38;5;250m"
  RESET="\033[0m"
else
  BOLD=""
  DIM=""
  RED=""
  GREEN=""
  YELLOW=""
  BLUE=""
  CYAN=""
  MAGENTA=""
  GRAY=""
  LIGHT_GRAY=""
  RESET=""
fi

# Execution state
declare -a REPORT_NAMES=()
declare -a REPORT_TYPES=()
declare -a REPORT_STATUS=()
declare -a REPORT_DETAILS=()
declare -a REPORT_DURATIONS=()

DRY_RUN=0          # 1 for -c/--check
LIST_ONLY=0        # 1 for -l/--list
FILTER_TYPE="all"  # "all", "cli", "desktop", "clean"
OUTPUT_FORMAT="text" # "text", "json"
FORCE_GIT=0
FORCE_PREAUTH=0    # 1 for -S/--sudo
NO_SUDO=0
DO_CLEANUP=1
NPM_DID_UPDATE=0
SUDO_KEEP_ALIVE_PID=""
declare -a ONLY_TARGETS=()
declare -a SKIP_TARGETS=()

cleanup_on_exit() {
  if [[ -n "${SUDO_KEEP_ALIVE_PID:-}" ]]; then
    kill "$SUDO_KEEP_ALIVE_PID" 2>/dev/null || true
  fi
}
trap cleanup_on_exit EXIT

usage() {
  echo -e "${BOLD}${CYAN}╭──────────────────────────────────────────────────────────────╮${RESET}"
  echo -e "${BOLD}${CYAN}│${RESET}  ${BOLD}⚡ AIUP${RESET} — Universal AI Harness & Desktop App Updater     ${BOLD}${CYAN}│${RESET}"
  echo -e "${BOLD}${CYAN}│${RESET}  ${DIM}Version ${VERSION}  •  https://github.com/Nan0pk/AIup${RESET}           ${BOLD}${CYAN}│${RESET}"
  echo -e "${BOLD}${CYAN}╰──────────────────────────────────────────────────────────────╯${RESET}"
  echo ""
  echo -e "${BOLD}USAGE:${RESET}"
  echo "    aiup [OPTIONS]"
  echo "    uai  [OPTIONS]"
  echo ""
  echo -e "${BOLD}OPTIONS:${RESET}"
  echo -e "    ${CYAN}-h, --help${RESET}            Show this documentation"
  echo -e "    ${CYAN}-v, --version${RESET}         Show version number"
  echo -e "    ${CYAN}-l, --list${RESET}            List detected CLI and Desktop AI apps & versions"
  echo -e "    ${CYAN}-c, --check${RESET}           Non-mutating check for available updates/debloat"
  echo -e "    ${CYAN}-C, --clean${RESET}           Run housekeeping, cache purge & debloat scope only"
  echo -e "    ${CYAN}--no-clean${RESET}            Skip post-update housekeeping and cache debloat"
  echo -e "    ${CYAN}-S, --sudo${RESET}            Pre-authenticate sudo at startup (if safe) for unattended sync"
  echo -e "    ${CYAN}--no-sudo${RESET}             Disable sudo/pkexec prompts (cache privileged updates)"
  echo -e "    ${CYAN}--cli${RESET}                 Only target CLI harnesses and agent runtimes"
  echo -e "    ${CYAN}--desktop${RESET}             Only target Desktop AI apps and UI workspaces"
  echo -e "    ${CYAN}-o, --only <names>${RESET}    Only run specified targets (comma-separated)"
  echo -e "    ${CYAN}-s, --skip <names>${RESET}    Skip specified targets (comma-separated)"
  echo -e "    ${CYAN}--json${RESET}                Output results in JSON format"
  echo -e "    ${CYAN}--force-git${RESET}           Stash, pull, and restore dirty git checkouts"
  echo -e "    ${CYAN}--no-color${RESET}            Disable colored terminal output"
  echo ""
  echo -e "${BOLD}SUPPORTED TARGETS:${RESET}"
  echo -e "  ${CYAN}◈ CLI Engines:${RESET}     agy, claude, codex, hermes, opencode, mimo, kilo, goose, uv-tools, npm-globals"
  echo -e "  ${MAGENTA}❖ Desktop Apps:${RESET}    chatgpt, opencode-desktop, aionui, antigravity-desktop, cowork-os, orkas, hermes-desktop"
  echo -e "  ${BLUE}🧹 Housekeeping:${RESET}   clean-uv, clean-npm, clean-pip, clean-installers, clean-git, clean-electron, clean-dnf, clean-dumps"
  echo ""
  echo -e "${BOLD}EXAMPLES:${RESET}"
  echo "    aiup                    # Update everything with live progress & debloat afterwards"
  echo "    aiup -l                 # Visual dashboard of detected installed versions"
  echo "    aiup -c                 # Safe dry-run check without modifying files"
  echo "    aiup -C                 # Run housekeeping & cache debloat only"
  echo "    aiup -c -C              # Dry-run housekeeping check (shows reclaimable cache)"
  echo "    aiup -S                 # Pre-authenticate sudo upfront if safe"
  echo "    aiup --no-clean         # Update only, skip housekeeping"
  echo "    aiup -o opencode,claude # Target specific apps"
  echo "    aiup -l --json          # Structured JSON inventory for automations"
  exit 0
}

require_arg_value() {
  local opt="$1"
  local val="${2:-}"
  if [[ -z "$val" || "$val" == -* ]]; then
    echo -e "${RED}[ERROR]${RESET} Option ${opt} requires a non-empty value." >&2
    exit 2
  fi
}

# Parse Arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      ;;
    -v|--version)
      echo "aiup version ${VERSION} (${OS} ${ARCH})"
      exit 0
      ;;
    -l|--list)
      LIST_ONLY=1
      shift
      ;;
    -c|--check)
      DRY_RUN=1
      shift
      ;;
    -C|--clean|--debloat)
      FILTER_TYPE="clean"
      DO_CLEANUP=1
      shift
      ;;
    --no-clean|--skip-clean|--skip-cleanup)
      DO_CLEANUP=0
      shift
      ;;
    -S|--sudo)
      FORCE_PREAUTH=1
      shift
      ;;
    --no-sudo)
      NO_SUDO=1
      shift
      ;;
    --cli)
      FILTER_TYPE="cli"
      shift
      ;;
    --desktop)
      FILTER_TYPE="desktop"
      shift
      ;;
    --json)
      OUTPUT_FORMAT="json"
      shift
      ;;
    --force-git)
      FORCE_GIT=1
      shift
      ;;
    --no-color)
      shift
      ;;
    -o|--only)
      require_arg_value "$1" "${2:-}"
      IFS=',' read -r -a targets <<< "$2"
      for t in "${targets[@]}"; do
        t_clean="$(printf '%s' "$t" | tr '[:upper:]' '[:lower:]' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        [[ -n "$t_clean" ]] && ONLY_TARGETS+=("$t_clean")
      done
      shift 2
      ;;
    -s|--skip)
      require_arg_value "$1" "${2:-}"
      IFS=',' read -r -a targets <<< "$2"
      for t in "${targets[@]}"; do
        t_clean="$(printf '%s' "$t" | tr '[:upper:]' '[:lower:]' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        [[ -n "$t_clean" ]] && SKIP_TARGETS+=("$t_clean")
      done
      shift 2
      ;;
    *)
      echo -e "${RED}[ERROR]${RESET} Unknown option: $1" >&2
      usage
      ;;
  esac
done

# Derive normalized mode label for UI/JSON
if [[ $LIST_ONLY -eq 1 ]]; then
  MODE_LABEL="list"
elif [[ $DRY_RUN -eq 1 ]]; then
  MODE_LABEL="check"
elif [[ "$FILTER_TYPE" == "clean" ]]; then
  MODE_LABEL="clean"
else
  MODE_LABEL="update"
fi

# ==============================================================================
# HELPERS & UTILITIES
# ==============================================================================
should_run() {
  local name="$1"
  local type="$2" # "cli", "desktop", or "clean"
  local lower_name
  lower_name="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')"

  if [[ "$FILTER_TYPE" == "cli" && "$type" != "cli" ]]; then
    return 1
  fi
  if [[ "$FILTER_TYPE" == "desktop" && "$type" != "desktop" ]]; then
    return 1
  fi
  if [[ "$FILTER_TYPE" == "clean" && "$type" != "clean" ]]; then
    return 1
  fi
  if [[ "$FILTER_TYPE" == "all" && "$type" == "clean" && $DO_CLEANUP -eq 0 ]]; then
    return 1
  fi

  for s in "${SKIP_TARGETS[@]:-}"; do
    [[ -n "$s" && "$lower_name" == "$s" ]] && return 1
  done

  if [[ ${#ONLY_TARGETS[@]} -gt 0 ]]; then
    for o in "${ONLY_TARGETS[@]}"; do
      [[ -n "$o" && "$lower_name" == "$o" ]] && return 0
    done
    return 1
  fi

  return 0
}

elapsed_since() {
  local t_start="$1"
  local t_end
  t_end=$(date +%s%N)
  awk -v s="$t_start" -v e="$t_end" 'BEGIN {printf "%.1fs", (e - s)/1000000000}'
}

record_result() {
  local name="$1"
  local type="$2"
  local status="$3"
  local detail="$4"
  local duration="$5"

  REPORT_NAMES+=("$name")
  REPORT_TYPES+=("$type")
  REPORT_STATUS+=("$status")
  REPORT_DETAILS+=("$detail")
  REPORT_DURATIONS+=("$duration")
}

log_card_start() {
  [[ "$OUTPUT_FORMAT" == "json" ]] && return
  local title="$1"
  local type="$2"
  if [[ "$type" == "cli" ]]; then
    echo -e "${BOLD}${CYAN}┌── ◈ [CLI] ${title}${RESET}"
  elif [[ "$type" == "clean" ]]; then
    echo -e "${BOLD}${BLUE}┌── 🧹 [CLEANUP] ${title}${RESET}"
  else
    echo -e "${BOLD}${MAGENTA}┌── ❖ [DESKTOP] ${title}${RESET}"
  fi
}

log_step() {
  [[ "$OUTPUT_FORMAT" == "json" ]] && return
  local msg="$1"
  echo -e "  ${DIM}│${RESET}   ${GRAY}↳${RESET} ${LIGHT_GRAY}${msg}${RESET}"
}

log_card_end() {
  [[ "$OUTPUT_FORMAT" == "json" ]] && return
  local status="$1"
  local detail="$2"
  local dur="$3"
  local badge=""

  case "$status" in
    UPDATED)           badge="${GREEN}✔ [UPDATED]${RESET}" ;;
    CLEANED|DEBLOATED) badge="${GREEN}✔ [CLEANED]${RESET}" ;;
    "UP TO DATE")      badge="${GREEN}✔ [UP-TO-DATE]${RESET}" ;;
    "UPDATE AVAIL")    badge="${YELLOW}★ [UPDATE AVAILABLE]${RESET}" ;;
    "DIRTY (SKIPPED)") badge="${YELLOW}▲ [DIRTY TREE]${RESET}" ;;
    CACHED)            badge="${CYAN}⇣ [CACHED]${RESET}" ;;
    SKIPPED)           badge="${GRAY}⊘ [SKIPPED]${RESET}" ;;
    FAILED)            badge="${RED}✖ [FAILED]${RESET}" ;;
    *)                 badge="${CYAN}• [${status}]${RESET}" ;;
  esac

  echo -e "  ${DIM}└──${RESET} ${badge} ${detail} ${GRAY}[${dur}]${RESET}\n"
}

# Drains stdin completely so upstream never receives SIGPIPE under pipefail
stream_progress() {
  local max_lines="${1:-6}"
  local count=0
  local esc_strip=$'s/\x1B\\[[0-9;]*[a-zA-Z]//g'
  while IFS= read -r line; do
    if [[ "$OUTPUT_FORMAT" == "json" ]] || [[ $count -ge $max_lines ]]; then
      continue
    fi
    line="$(printf '%s' "$line" | tr '\r' '\n' | tail -n 1 | sed -E "$esc_strip" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    [[ -z "$line" ]] && continue
    if [[ "$line" =~ ^[═─━_=-]{3,}$ ]] || [[ "$line" =~ ^[█░▒◒◐◓◑]+$ ]]; then
      continue
    fi
    if [[ ${#line} -gt 74 ]]; then
      line="${line:0:71}..."
    fi
    echo -e "  ${DIM}│${RESET}   ${GRAY}↳${RESET} ${DIM}${line}${RESET}"
    ((count++)) || true
  done
}

is_version_gt() {
  local candidate="$1"
  local current="$2"
  python3 -c '
import re, sys

def norm(s):
    s = s.strip().lstrip("vV")
    main, _, pre = s.partition("-")
    parts = [int(x) for x in re.findall(r"\d+", main)]
    # Stable release > prerelease for same base tuple
    return (parts, 0 if pre else 1, pre)

c, l = norm(sys.argv[1]), norm(sys.argv[2])
sys.exit(0 if c > l else 1)
' "$candidate" "$current" 2>/dev/null
}

verify_sha512_b64() {
  local file_path="$1"
  local expected_b64="$2"
  python3 -c '
import base64, hashlib, sys
h = hashlib.sha512()
with open(sys.argv[1], "rb") as f:
    for chunk in iter(lambda: f.read(1048576), b""):
        h.update(chunk)
actual = base64.b64encode(h.digest()).decode("ascii")
sys.exit(0 if actual == sys.argv[2].strip() else 1)
' "$file_path" "$expected_b64" 2>/dev/null
}

keep_sudo_alive() {
  if [[ -z "${SUDO_KEEP_ALIVE_PID:-}" ]]; then
    while true; do
      sudo -n true 2>/dev/null || exit 0
      sleep 50
    done 2>/dev/null &
    SUDO_KEEP_ALIVE_PID=$!
  fi
}

run_privileged() {
  local prompt_desc="${1:-system update}"
  shift || true

  if sudo -n true 2>/dev/null; then
    keep_sudo_alive
    sudo "$@"
    return $?
  fi

  if [[ $NO_SUDO -eq 1 || "${CI:-}" == "true" || "${DEBIAN_FRONTEND:-}" == "noninteractive" || "${AIUP_NONINTERACTIVE:-}" == "1" ]]; then
    return 2
  fi

  if [[ -t 0 ]]; then
    log_step "Administrator privileges required for ${prompt_desc}"
    if sudo -v </dev/tty >/dev/tty 2>&1; then
      keep_sudo_alive
      sudo "$@"
      return $?
    fi
    return 1
  fi

  if [[ (-n "${DISPLAY:-}" || -n "${WAYLAND_DISPLAY:-}") ]] && command -v pkexec &>/dev/null; then
    log_step "Requesting desktop authorization via pkexec (${prompt_desc})..."
    pkexec "$@"
    return $?
  fi

  return 2
}

preauth_sudo_if_safe() {
  # Pre-authenticate at startup ONLY when -S/--sudo is passed and it is safe
  [[ $FORCE_PREAUTH -eq 0 ]] && return 0
  [[ $DRY_RUN -eq 1 || $LIST_ONLY -eq 1 || $NO_SUDO -eq 1 ]] && return 0
  [[ "$FILTER_TYPE" == "cli" || "$FILTER_TYPE" == "clean" ]] && return 0
  [[ "${CI:-}" == "true" || "${DEBIAN_FRONTEND:-}" == "noninteractive" || "${AIUP_NONINTERACTIVE:-}" == "1" ]] && return 0
  [[ ! -t 0 ]] && return 0

  if sudo -n true 2>/dev/null; then
    keep_sudo_alive
    return 0
  fi

  if [[ "$OUTPUT_FORMAT" != "json" ]]; then
    echo -e "${DIM}┌──${RESET} ${BOLD}${CYAN}🔒 Administrator Privileges (sudo)${RESET}"
    echo -e "  ${DIM}│${RESET}   ${GRAY}↳${RESET} ${LIGHT_GRAY}Pre-authenticating upfront (-S/--sudo) for unattended batch sync...${RESET}"
  fi

  if sudo -v </dev/tty >/dev/tty 2>&1; then
    keep_sudo_alive
    [[ "$OUTPUT_FORMAT" != "json" ]] && echo -e "  ${DIM}└──${RESET} ${GREEN}✔ Sudo session established (active keep-alive)${RESET}\n"
    return 0
  else
    [[ "$OUTPUT_FORMAT" != "json" ]] && echo -e "  ${DIM}└──${RESET} ${YELLOW}⚠ Sudo pre-auth skipped — will prompt only if needed${RESET}\n"
    return 1
  fi
}

get_asar_version() {
  local asar_path="$1"
  if [[ ! -f "$asar_path" ]]; then
    echo "unknown"
    return
  fi
  python3 -c '
import struct, json, sys
try:
    with open(sys.argv[1], "rb") as f:
        f.seek(4)
        total_header_size = struct.unpack("<I", f.read(4))[0]
        base = 8 + total_header_size
        f.seek(12)
        l = struct.unpack("<I", f.read(4))[0]
        h = json.loads(f.read(l).decode("utf-8"))
        off = int(h["files"]["package.json"]["offset"])
        sz = int(h["files"]["package.json"]["size"])
        f.seek(base + off)
        p = json.loads(f.read(sz).decode("utf-8"))
        print(p.get("version", "unknown"))
except Exception:
    print("unknown")
' "$asar_path" 2>/dev/null || echo "unknown"
}

get_npm_root_global() {
  local node_root="${HOME}/.local/node/lib/node_modules"
  if [[ ! -d "$node_root" ]] && command -v npm &>/dev/null; then
    node_root="$(npm root -g 2>/dev/null || echo '')"
  fi
  echo "$node_root"
}

get_npm_pkg_version() {
  local pkg="$1"
  local node_root
  node_root="$(get_npm_root_global)"
  if [[ -n "$node_root" && -f "${node_root}/${pkg}/package.json" ]] && command -v jq &>/dev/null; then
    jq -r '.version // "unknown"' "${node_root}/${pkg}/package.json" 2>/dev/null
  else
    echo ""
  fi
}

TRACKED_NPM_PKGS=("command-code" "@qwen-code/qwen-code" "cline")

get_version() {
  local tool="$1"
  case "$tool" in
    agy)
      command -v agy &>/dev/null && agy --version 2>&1 | head -n 1 | awk '{print $1}' || echo "not installed"
      ;;
    claude)
      command -v claude &>/dev/null && claude --version 2>&1 | head -n 1 | awk '{print $1}' || echo "not installed"
      ;;
    codex)
      command -v codex &>/dev/null && codex --version 2>&1 | head -n 1 | awk '{print $2}' || echo "not installed"
      ;;
    hermes)
      command -v hermes &>/dev/null && (hermes --version 2>&1 | head -n 1 | grep -oE 'v[0-9.]+' || echo "installed") || echo "not installed"
      ;;
    opencode)
      command -v opencode &>/dev/null && opencode --version 2>&1 | head -n 1 | awk '{print $2}' || echo "not installed"
      ;;
    mimo)
      command -v mimo &>/dev/null && mimo --version 2>&1 | head -n 1 || echo "not installed"
      ;;
    kilo)
      command -v kilo &>/dev/null && kilo --version 2>&1 | head -n 1 || echo "not installed"
      ;;
    goose)
      command -v goose &>/dev/null && goose --version 2>&1 | head -n 1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' || echo "not installed"
      ;;
    chatgpt)
      if command -v rpm &>/dev/null && rpm -q chatgpt &>/dev/null; then
        rpm -q --qf '%{VERSION}\n' chatgpt 2>/dev/null
      elif [[ $IS_MACOS -eq 1 && -d "/Applications/ChatGPT.app" ]]; then
        defaults read /Applications/ChatGPT.app/Contents/Info.plist CFBundleShortVersionString 2>/dev/null || echo "installed"
      else
        echo "not installed"
      fi
      ;;
    opencode-desktop)
      if command -v rpm &>/dev/null && rpm -q opencode &>/dev/null; then
        rpm -q --qf '%{VERSION}\n' opencode 2>/dev/null
      elif [[ -d "/opt/OpenCode" ]]; then
        echo "unmanaged"
      else
        echo "not installed"
      fi
      ;;
    aionui)
      [[ -f "$HOME/.local/opt/AionUi/resources/app.asar" ]] && get_asar_version "$HOME/.local/opt/AionUi/resources/app.asar" || echo "not installed"
      ;;
    antigravity-desktop)
      [[ -f "$HOME/.local/share/antigravity/resources/app.asar" ]] && get_asar_version "$HOME/.local/share/antigravity/resources/app.asar" || echo "not installed"
      ;;
    cowork-os)
      if [[ -d "$HOME/CoWork-OS/.git" ]]; then
        local hash pkg_ver
        hash=$(git -C "$HOME/CoWork-OS" rev-parse --short HEAD 2>/dev/null || echo "git")
        pkg_ver=$(jq -r '.version // "unknown"' "$HOME/CoWork-OS/package.json" 2>/dev/null || echo "dev")
        echo "v${pkg_ver} (${hash})"
      else
        echo "not found"
      fi
      ;;
    orkas)
      if [[ -d "$HOME/Orkas/.git" ]]; then
        local hash pkg_ver
        hash=$(git -C "$HOME/Orkas" rev-parse --short HEAD 2>/dev/null || echo "git")
        pkg_ver=$(jq -r '.version // "unknown"' "$HOME/Orkas/package.json" 2>/dev/null || echo "dev")
        echo "v${pkg_ver} (${hash})"
      else
        echo "not found"
      fi
      ;;
    hermes-desktop)
      command -v hermes &>/dev/null && echo "Available" || echo "not installed"
      ;;
    uv-tools)
      if command -v uv &>/dev/null; then
        local uv_pkgs
        uv_pkgs=$(uv tool list 2>/dev/null | grep -E '^[a-zA-Z0-9._-]+\s+v?[0-9]' | awk '{printf "%s@%s ", $1, $2}' | sed 's/ $//')
        echo "${uv_pkgs:-none}"
      else
        echo "not installed"
      fi
      ;;
    npm-globals)
      if command -v npm &>/dev/null; then
        local items=""
        for p in "${TRACKED_NPM_PKGS[@]}"; do
          local v
          v=$(get_npm_pkg_version "$p")
          [[ -n "$v" ]] && items+="${p##*/}@${v} "
        done
        echo "${items% }"
        [[ -z "$items" ]] && true
      else
        echo "not installed"
      fi
      ;;
    *)
      echo "unknown"
      ;;
  esac
}

list_harnesses() {
  local v_agy v_claude v_codex v_hermes v_opencode v_mimo v_kilo v_goose v_uv v_npm
  local v_chatgpt v_opencode_desk v_aionui v_ag_desk v_cowork v_orkas v_hermes_desk
  v_agy="$(get_version agy)"
  v_claude="$(get_version claude)"
  v_codex="$(get_version codex)"
  v_hermes="$(get_version hermes)"
  v_opencode="$(get_version opencode)"
  v_mimo="$(get_version mimo)"
  v_kilo="$(get_version kilo)"
  v_goose="$(get_version goose)"
  v_uv="$(get_version uv-tools)"
  v_npm="$(get_version npm-globals)"
  [[ -z "$v_npm" ]] && v_npm="none"

  v_chatgpt="$(get_version chatgpt)"
  v_opencode_desk="$(get_version opencode-desktop)"
  v_aionui="$(get_version aionui)"
  v_ag_desk="$(get_version antigravity-desktop)"
  v_cowork="$(get_version cowork-os)"
  v_orkas="$(get_version orkas)"
  v_hermes_desk="$(get_version hermes-desktop)"

  if [[ "$OUTPUT_FORMAT" == "json" ]]; then
    python3 -c '
import json, sys
keys_cli = ["agy", "claude", "codex", "hermes", "opencode", "mimo", "kilo", "goose", "uv_tools", "npm_globals"]
