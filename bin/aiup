find_first_existing_asar() {
  local p
  for p in "$@"; do
    if [[ -n "$p" && -f "$p" ]]; then
      printf '%s\n' "$p"
      return 0
    fi
  done
  return 1
}

find_first_appimage() {
  local dir pat f
  for dir in "$HOME/Applications" "$HOME/.local/bin"; do
    [[ -d "$dir" ]] || continue
    for pat in "$@"; do
      for f in "$dir"/$pat; do
        if [[ -f "$f" ]]; then
          printf '%s\n' "$f"
          return 0
        fi
      done
    done
  done
  return 1
}

get_linux_pkg_version() {
  local pkg
  for pkg in "$@"; do
    if command -v rpm &>/dev/null && rpm -q "$pkg" &>/dev/null; then
      rpm -q --qf '%{VERSION}\n' "$pkg" 2>/dev/null
      return 0
    fi
    if command -v dpkg-query &>/dev/null && dpkg-query -W -f='${Status}\n' "$pkg" 2>/dev/null | grep -q "install ok installed"; then
      dpkg-query -W -f='${Version}\n' "$pkg" 2>/dev/null | sed 's/-.*//'
      return 0
    fi
  done
  return 1
}

get_version() {
  local tool="$1"
  local bin_path=""
  case "$tool" in
    agy)
      bin_path="$(resolve_bin agy 2>/dev/null || true)"
      [[ -n "$bin_path" ]] && "$bin_path" --version 2>&1 | strip_cr | head -n 1 | awk '{print $1}' || echo "not installed"
      ;;
    claude)
      bin_path="$(resolve_bin claude 2>/dev/null || true)"
      [[ -n "$bin_path" ]] && "$bin_path" --version 2>&1 | strip_cr | head -n 1 | awk '{print $1}' || echo "not installed"
      ;;
    codex)
      bin_path="$(resolve_bin codex 2>/dev/null || true)"
      [[ -n "$bin_path" ]] && "$bin_path" --version 2>&1 | strip_cr | head -n 1 | awk '{print $2}' || echo "not installed"
      ;;
    hermes)
      bin_path="$(resolve_bin hermes 2>/dev/null || true)"
      [[ -n "$bin_path" ]] && ("$bin_path" --version 2>&1 | strip_cr | head -n 1 | grep -oE 'v?[0-9]+\.[0-9]+(\.[0-9]+)?' || echo "installed") || echo "not installed"
      ;;
    opencode)
      bin_path="$(resolve_bin opencode 2>/dev/null || true)"
      [[ -n "$bin_path" ]] && "$bin_path" --version 2>&1 | strip_cr | head -n 1 | awk '{print ($2 != "" ? $2 : $1)}' || echo "not installed"
      ;;
    mimo)
      bin_path="$(resolve_bin mimo 2>/dev/null || true)"
      [[ -n "$bin_path" ]] && "$bin_path" --version 2>&1 | strip_cr | head -n 1 || echo "not installed"
      ;;
    kilo)
      bin_path="$(resolve_bin kilo 2>/dev/null || true)"
      [[ -n "$bin_path" ]] && "$bin_path" --version 2>&1 | strip_cr | head -n 1 || echo "not installed"
      ;;
    goose)
      bin_path="$(resolve_bin goose 2>/dev/null || true)"
      [[ -n "$bin_path" ]] && "$bin_path" --version 2>&1 | strip_cr | head -n 1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' || echo "not installed"
      ;;
    ollama)
      bin_path="$(resolve_bin ollama 2>/dev/null || true)"
      if [[ -n "$bin_path" ]]; then
        "$bin_path" --version 2>&1 | strip_cr | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -n 1 || echo "installed"
      else
        echo "not installed"
      fi
      ;;
    lms)
      bin_path="$(resolve_bin lms 2>/dev/null || true)"
      if [[ -n "$bin_path" ]]; then
        "$bin_path" --version 2>&1 | strip_cr | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -n 1 || echo "installed"
      elif [[ $IS_WINDOWS -eq 1 && -f "${LOCALAPPDATA_DIR}/Programs/LM Studio/LM Studio.exe" ]]; then
        get_pe_version "${LOCALAPPDATA_DIR}/Programs/LM Studio/LM Studio.exe" || echo "installed"
      else
        echo "not installed"
      fi
      ;;
    chatgpt)
      if [[ $IS_LINUX -eq 1 ]]; then
        get_linux_pkg_version chatgpt && return 0
        if command -v flatpak &>/dev/null && flatpak info com.openai.ChatGPT &>/dev/null; then
          flatpak info com.openai.ChatGPT 2>/dev/null | awk -F: '/Version:/ {gsub(/^[ \t]+/, "", $2); print $2; exit}'
          return 0
        fi
        echo "not installed"
      elif [[ $IS_MACOS -eq 1 && -d "/Applications/ChatGPT.app" ]]; then
        defaults read /Applications/ChatGPT.app/Contents/Info.plist CFBundleShortVersionString 2>/dev/null || echo "installed"
      elif [[ $IS_WINDOWS -eq 1 ]]; then
        local appx_v
        appx_v="$(get_appx_version 'OpenAI.ChatGPT' || true)"
        if [[ -n "$appx_v" ]]; then
          echo "$appx_v"
        elif [[ -f "${LOCALAPPDATA_DIR}/Programs/ChatGPT/ChatGPT.exe" ]]; then
          get_pe_version "${LOCALAPPDATA_DIR}/Programs/ChatGPT/ChatGPT.exe" || echo "installed"
        else
          echo "not installed"
        fi
      else
        echo "not installed"
      fi
      ;;
    opencode-desktop)
      if [[ $IS_LINUX -eq 1 ]]; then
        get_linux_pkg_version opencode opencode-desktop && return 0
        local appimg
        appimg="$(find_first_appimage 'OpenCode*.AppImage' 'opencode*.AppImage' 2>/dev/null || true)"
        if [[ -n "$appimg" ]]; then
          printf '%s\n' "$appimg" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n 1 || echo "AppImage"
        elif [[ -d "/opt/OpenCode" ]]; then
          echo "unmanaged"
        else
          echo "not installed"
        fi
      elif [[ $IS_WINDOWS -eq 1 ]]; then
        local asar_p
        asar_p="$(find_first_existing_asar "${LOCALAPPDATA_DIR}/Programs/OpenCode/resources/app.asar" "${PROGRAMFILES_DIR}/OpenCode/resources/app.asar" 2>/dev/null || true)"
        if [[ -n "$asar_p" ]]; then
          get_asar_version "$asar_p"
        elif [[ -f "${LOCALAPPDATA_DIR}/Programs/OpenCode/OpenCode.exe" ]]; then
          get_pe_version "${LOCALAPPDATA_DIR}/Programs/OpenCode/OpenCode.exe" || echo "installed"
        else
          echo "not installed"
        fi
      elif [[ $IS_MACOS -eq 1 && -d "/Applications/OpenCode.app" ]]; then
        defaults read /Applications/OpenCode.app/Contents/Info.plist CFBundleShortVersionString 2>/dev/null || echo "installed"
      else
        echo "not installed"
      fi
      ;;
    aionui)
      if [[ $IS_WINDOWS -eq 1 ]]; then
        local asar_p
        asar_p="$(find_first_existing_asar "${LOCALAPPDATA_DIR}/Programs/AionUi/resources/app.asar" "${PROGRAMFILES_DIR}/AionUi/resources/app.asar" 2>/dev/null || true)"
        [[ -n "$asar_p" ]] && get_asar_version "$asar_p" || echo "not installed"
      elif [[ $IS_MACOS -eq 1 && -f "/Applications/AionUi.app/Contents/Resources/app.asar" ]]; then
        get_asar_version "/Applications/AionUi.app/Contents/Resources/app.asar"
      else
        local asar_p
        asar_p="$(find_first_existing_asar "$HOME/.local/opt/AionUi/resources/app.asar" "/opt/AionUi/resources/app.asar" 2>/dev/null || true)"
        if [[ -n "$asar_p" ]]; then
          get_asar_version "$asar_p"
        elif [[ $IS_LINUX -eq 1 ]] && get_linux_pkg_version aionui AionUi 2>/dev/null; then
          return 0
        else
          echo "not installed"
        fi
      fi
      ;;
    antigravity-desktop)
      if [[ $IS_WINDOWS -eq 1 ]]; then
        local asar_p
        asar_p="$(find_first_existing_asar "${LOCALAPPDATA_DIR}/Programs/Antigravity/resources/app.asar" "${LOCALAPPDATA_DIR}/antigravity/resources/app.asar" "${PROGRAMFILES_DIR}/Antigravity/resources/app.asar" 2>/dev/null || true)"
        [[ -n "$asar_p" ]] && get_asar_version "$asar_p" || echo "not installed"
      elif [[ $IS_MACOS -eq 1 && -f "/Applications/Antigravity.app/Contents/Resources/app.asar" ]]; then
        get_asar_version "/Applications/Antigravity.app/Contents/Resources/app.asar"
      else
        local asar_p
        asar_p="$(find_first_existing_asar "$HOME/.local/share/antigravity/resources/app.asar" "/usr/share/antigravity/resources/app.asar" "/opt/Antigravity/resources/app.asar" 2>/dev/null || true)"
        if [[ -n "$asar_p" ]]; then
          get_asar_version "$asar_p"
        elif [[ $IS_LINUX -eq 1 ]] && get_linux_pkg_version antigravity 2>/dev/null; then
          return 0
        else
          echo "not installed"
        fi
      fi
      ;;
    zcode)
      if [[ $IS_WINDOWS -eq 1 ]]; then
        local asar_p
        asar_p="$(find_first_existing_asar "${PROGRAMFILES_DIR}/ZCode/resources/app.asar" "${LOCALAPPDATA_DIR}/Programs/ZCode/resources/app.asar" 2>/dev/null || true)"
        if [[ -n "$asar_p" ]]; then
          get_asar_version "$asar_p"
        elif [[ -f "${PROGRAMFILES_DIR}/ZCode/ZCode.exe" ]]; then
          get_pe_version "${PROGRAMFILES_DIR}/ZCode/ZCode.exe" || echo "installed"
        else
          echo "not installed"
        fi
      elif [[ $IS_MACOS -eq 1 && -f "/Applications/ZCode.app/Contents/Resources/app.asar" ]]; then
        get_asar_version "/Applications/ZCode.app/Contents/Resources/app.asar"
      else
        local asar_p
        asar_p="$(find_first_existing_asar "$HOME/.local/opt/ZCode/resources/app.asar" "/opt/ZCode/resources/app.asar" 2>/dev/null || true)"
        if [[ -n "$asar_p" ]]; then
          get_asar_version "$asar_p"
        elif [[ $IS_LINUX -eq 1 ]] && get_linux_pkg_version zcode ZCode 2>/dev/null; then
          return 0
        else
          local appimg
          appimg="$(find_first_appimage 'ZCode*.AppImage' 'zcode*.AppImage' 2>/dev/null || true)"
          if [[ -n "$appimg" ]]; then
            printf '%s\n' "$appimg" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n 1 || echo "AppImage"
          else
            echo "not installed"
          fi
        fi
      fi
      ;;
    copilot)
      if [[ $IS_WINDOWS -eq 1 ]]; then
        local exe_p="${PROGRAMFILES_X86_DIR}/Microsoft/Copilot/Application/copilotapp.exe"
        if [[ -f "$exe_p" ]]; then
          get_pe_version "$exe_p" || echo "installed"
        else
          local appx_v
          appx_v="$(get_appx_version 'Microsoft.Copilot' || get_appx_version 'Microsoft.365Copilot' || true)"
          [[ -n "$appx_v" ]] && echo "$appx_v" || echo "not installed"
        fi
      else
        local gh_c=""
        if command -v gh &>/dev/null; then
          gh_c="$(gh extension list 2>/dev/null | awk '/copilot/ {print $NF; exit}' || true)"
        fi
        if [[ -n "$gh_c" ]]; then
          echo "$gh_c"
        elif bin_path="$(resolve_bin copilot 2>/dev/null || true)" && [[ -n "$bin_path" ]]; then
          "$bin_path" --version 2>&1 | head -n 1 | awk '{print $NF}'
        else
          echo "not installed"
        fi
      fi
      ;;
    claude-desktop)
      if [[ $IS_WINDOWS -eq 1 ]]; then
        local appx_v
        appx_v="$(get_appx_version 'Claude' || true)"
        if [[ -n "$appx_v" ]]; then
          echo "$appx_v"
        elif [[ -f "${LOCALAPPDATA_DIR}/AnthropicClaude/claude.exe" ]]; then
          get_pe_version "${LOCALAPPDATA_DIR}/AnthropicClaude/claude.exe" || echo "installed"
        else
          echo "not installed"
        fi
      elif [[ $IS_MACOS -eq 1 && -d "/Applications/Claude.app" ]]; then
        defaults read /Applications/Claude.app/Contents/Info.plist CFBundleShortVersionString 2>/dev/null || echo "installed"
      else
        local asar_p
        asar_p="$(find_first_existing_asar "/opt/Claude/resources/app.asar" "/usr/lib/claude-desktop/resources/app.asar" "$HOME/.local/opt/Claude/resources/app.asar" 2>/dev/null || true)"
        if [[ -n "$asar_p" ]]; then
          get_asar_version "$asar_p"
        elif [[ $IS_LINUX -eq 1 ]] && get_linux_pkg_version claude-desktop 2>/dev/null; then
          return 0
        else
          echo "not installed"
        fi
      fi
      ;;
    codex-desktop)
      if [[ $IS_WINDOWS -eq 1 ]]; then
        local appx_v
        appx_v="$(get_appx_version 'OpenAI.Codex' || true)"
        if [[ -n "$appx_v" ]]; then
          echo "$appx_v"
        elif [[ -f "${LOCALAPPDATA_DIR}/Programs/Codex/Codex.exe" ]]; then
          get_pe_version "${LOCALAPPDATA_DIR}/Programs/Codex/Codex.exe" || echo "installed"
        elif [[ -f "${PROGRAMFILES_DIR}/OpenAI/Codex/Codex.exe" ]]; then
          get_pe_version "${PROGRAMFILES_DIR}/OpenAI/Codex/Codex.exe" || echo "installed"
        else
          echo "not installed"
        fi
      elif [[ $IS_MACOS -eq 1 && -d "/Applications/Codex.app" ]]; then
        defaults read /Applications/Codex.app/Contents/Info.plist CFBundleShortVersionString 2>/dev/null || echo "installed"
      else
        local asar_p
        asar_p="$(find_first_existing_asar "/opt/Codex/resources/app.asar" "$HOME/.local/opt/Codex/resources/app.asar" 2>/dev/null || true)"
        if [[ -n "$asar_p" ]]; then
          get_asar_version "$asar_p"
        elif [[ $IS_LINUX -eq 1 ]] && get_linux_pkg_version codex-desktop 2>/dev/null; then
          return 0
        else
          echo "not installed"
        fi
      fi
      ;;
    cowork-os)
      if [[ -d "$HOME/CoWork-OS/.git" ]]; then
        local hash pkg_ver
        hash=$(git -C "$HOME/CoWork-OS" rev-parse --short HEAD 2>/dev/null || echo "git")
        pkg_ver=$(json_get_file "$HOME/CoWork-OS/package.json" ".version" || echo "dev")
        echo "v${pkg_ver:-unknown} (${hash})"
      else
        echo "not found"
      fi
      ;;
    orkas)
      if [[ -d "$HOME/Orkas/.git" ]]; then
        local hash pkg_ver
        hash=$(git -C "$HOME/Orkas" rev-parse --short HEAD 2>/dev/null || echo "git")
        pkg_ver=$(json_get_file "$HOME/Orkas/package.json" ".version" || echo "dev")
        echo "v${pkg_ver:-unknown} (${hash})"
      else
        echo "not found"
      fi
      ;;
    hermes-desktop)
      if [[ $IS_WINDOWS -eq 1 ]]; then
        local appx_v
        appx_v="$(get_appx_version 'NousResearch.Hermes' || true)"
        if [[ -n "$appx_v" ]]; then
          echo "$appx_v"
          return 0
        fi
      fi
      bin_path="$(resolve_bin hermes 2>/dev/null || true)"
      [[ -n "$bin_path" ]] && echo "Available" || echo "not installed"
      ;;
    uv-tools)
      bin_path="$(resolve_bin uv 2>/dev/null || true)"
      if [[ -n "$bin_path" ]]; then
        local uv_pkgs
        uv_pkgs=$("$bin_path" tool list 2>/dev/null | strip_cr | grep -E '^[a-zA-Z0-9._-]+\s+v?[0-9]' | awk '{printf "%s@%s ", $1, $2}' | sed 's/ $//')
        echo "${uv_pkgs:-none}"
      else
        echo "not installed"
      fi
      ;;
    pip-ai)
      if [[ ${#PYTHON_CMD[@]} -gt 0 ]] || detect_python; then
        local pip_pkgs
        pip_pkgs=$(get_pip_ai_installed | awk '{printf "%s@%s ", $1, $2}' | sed 's/ $//')
        echo "${pip_pkgs:-none}"
      else
        echo "not installed"
      fi
      ;;
    npm-globals)
      if command -v npm &>/dev/null; then
        local items=""
        for p in "${TRACKED_NPM_PKGS[@]}"; do
          local v
          v=$(get_npm_pkg_version "$p")
          [[ -n "$v" ]] && items+="${p##*/}@${v} "
        done
        echo "${items% }"
      else
        echo "not installed"
      fi
      ;;
    *)
      echo "unknown"
      ;;
  esac
}

summarize_list_items() {
  local raw="$1"
  local noun="$2"
  if [[ "$raw" == "none" || "$raw" == "not installed" || -z "$raw" ]]; then
    echo "${raw:-none}"
    return
  fi
  local -a arr
  read -ra arr <<< "$raw"
  if [[ ${#arr[@]} -eq 1 && "$noun" == "tool" ]]; then
    echo "${arr[0]%%@*}"
  else
    echo "${#arr[@]} ${noun}(s)"
  fi
}

