preauth_sudo_if_safe || true

# ==============================================================================
# SECTION 1: CLI HARNESSES & AGENTS
# ==============================================================================
if [[ "$FILTER_TYPE" == "all" || "$FILTER_TYPE" == "cli" ]]; then
  [[ "$OUTPUT_FORMAT" != "json" ]] && echo -e "${BOLD}${CYAN}◈ [SECTION 1] CLI HARNESSES & CORE AGENTS${RESET}\n"

  run_self_updater_cli "agy"      "Antigravity CLI (agy)"     "agy"      "update"  "Checking Google Antigravity release channel..." "already on the latest" "success|updated"
  run_self_updater_cli "claude"   "Claude Code (claude)"       "claude"   "update"  "Connecting to Anthropic update manifest..."     "already.*latest|up to date" "Updated from|successfully updated"
  run_self_updater_cli "codex"    "OpenAI Codex CLI (codex)"   "codex"    "update"  "Checking standalone binary release..."          "already up to date|already.*latest" "Updating Codex CLI from|Updated from"
  run_self_updater_cli "opencode" "OpenCode CLI (opencode)"    "opencode" "upgrade" "Checking upstream OpenCode CLI packages..."     "already installed|up to date" "Upgrade complete|Upgraded"
  run_self_updater_cli "mimo"     "Xiaomi Mimocode (mimo)"     "mimo"     "upgrade" "Connecting to Xiaomi Mimocode release..."       "already installed|up to date" "Upgrade complete|Upgraded"
  run_self_updater_cli "kilo"     "Kilo Agent (kilo)"          "kilo"     "upgrade" "Checking Kilo Agent distribution..."            "already installed|up to date" "Upgrade complete|Upgraded"
  run_self_updater_cli "goose"    "Goose CLI (goose)"          "goose"    "update"  "Checking Goose CLI latest release..."           "already on the latest" "successfully"

  # 8. Hermes Agent (supports native --check)
  hermes_bin="$(resolve_bin hermes 2>/dev/null || true)"
  if [[ -n "$hermes_bin" ]] && should_run "hermes" "cli"; then
    log_card_start "Hermes Agent (hermes)" "cli"
    t_start="$(now_ns)"
    if [[ $DRY_RUN -eq 1 ]]; then
      log_step "Probing Hermes Agent git repository (hermes update --check)..."
      rc=0; output=$("$hermes_bin" update --check 2>&1 | strip_cr) || rc=$?
      printf '%s\n' "$output" | stream_progress 4
      dur="$(elapsed_since "$t_start")"
      if printf '%s\n' "$output" | grep -qiE "Update available|behind"; then
        log_card_end "UPDATE AVAIL" "New commits on origin" "$dur"
        record_result "hermes" "CLI" "UPDATE AVAIL" "New commits on origin" "$dur"
      elif [[ $rc -ne 0 ]]; then
        log_card_end "FAILED" "hermes --check exited ${rc}" "$dur"
        record_result "hermes" "CLI" "FAILED" "Exit ${rc}" "$dur"
      else
        log_card_end "UP TO DATE" "Up to date with origin" "$dur"
        record_result "hermes" "CLI" "UP TO DATE" "Up to date" "$dur"
      fi
    else
      log_step "Updating Hermes dependencies and core engine..."
      rc=0; output=$("$hermes_bin" update --yes --no-gateway-restart 2>&1 | strip_cr) || rc=$?
      printf '%s\n' "$output" | stream_progress 4
      dur="$(elapsed_since "$t_start")"
      if printf '%s\n' "$output" | grep -qi "already up to date"; then
        log_card_end "UP TO DATE" "Already up to date" "$dur"
        record_result "hermes" "CLI" "UP TO DATE" "Up to date" "$dur"
      elif [[ $rc -ne 0 ]]; then
        log_card_end "FAILED" "hermes update exited ${rc}" "$dur"
        record_result "hermes" "CLI" "FAILED" "Exit ${rc}" "$dur"
      elif printf '%s\n' "$output" | grep -qiE "Updated|Successfully|Pulled|Installed"; then
        log_card_end "UPDATED" "Dependencies & git synced" "$dur"
        record_result "hermes" "CLI" "UPDATED" "Synced" "$dur"
      else
        log_card_end "UP TO DATE" "Verified (exit 0)" "$dur"
        record_result "hermes" "CLI" "UP TO DATE" "Verified" "$dur"
      fi
    fi
  fi

  # 9. Python Tools via uv
  uv_bin="$(resolve_bin uv 2>/dev/null || true)"
  if [[ -n "$uv_bin" ]] && should_run "uv-tools" "cli"; then
    log_card_start "Python uv Tools" "cli"
    t_start="$(now_ns)"
    if [[ $DRY_RUN -eq 1 ]]; then
      log_step "Checking PyPI versions for installed uv tools..."
      uv_updates=()
      uv_checked=0
      while read -r pkg ver _; do
        [[ -z "$pkg" || "$pkg" == -* ]] && continue
        ((uv_checked++)) || true
        pypi_v=$(curl -s --connect-timeout 3 "https://pypi.org/pypi/${pkg}/json" 2>/dev/null | json_get_stdin "info.version")
        if [[ -n "$pypi_v" ]] && is_version_gt "$pypi_v" "$ver"; then
          uv_updates+=("${pkg}:${ver}→${pypi_v}")
          log_step "Update available: ${pkg} (${ver} → ${pypi_v})"
        fi
      done < <("$uv_bin" tool list 2>/dev/null | strip_cr | grep -E '^[a-zA-Z0-9._-]+\s+v?[0-9]')
      dur="$(elapsed_since "$t_start")"
      if [[ ${#uv_updates[@]} -gt 0 ]]; then
        log_card_end "UPDATE AVAIL" "${#uv_updates[@]} tool(s) upgradable" "$dur"
        record_result "uv-tools" "CLI" "UPDATE AVAIL" "${#uv_updates[@]} upgradable" "$dur"
      else
        log_card_end "UP TO DATE" "${uv_checked} uv tool(s) current" "$dur"
        record_result "uv-tools" "CLI" "UP TO DATE" "${uv_checked} tools current" "$dur"
      fi
    else
      log_step "Upgrading installed uv tools..."
      rc=0; output=$("$uv_bin" tool upgrade --all 2>&1 | strip_cr) || rc=$?
      printf '%s\n' "$output" | stream_progress 4
      dur="$(elapsed_since "$t_start")"
      if [[ $rc -ne 0 ]]; then
        log_card_end "FAILED" "uv tool upgrade exited ${rc}" "$dur"
        record_result "uv-tools" "CLI" "FAILED" "Exit ${rc}" "$dur"
      elif printf '%s\n' "$output" | grep -qi "Nothing to upgrade"; then
        log_card_end "UP TO DATE" "All uv tools current" "$dur"
        record_result "uv-tools" "CLI" "UP TO DATE" "Tools current" "$dur"
      elif printf '%s\n' "$output" | grep -qiE "Updated|Upgraded|Installed"; then
        log_card_end "UPDATED" "Upgraded installed tools" "$dur"
        record_result "uv-tools" "CLI" "UPDATED" "Upgraded tools" "$dur"
      else
        log_card_end "UP TO DATE" "Verified" "$dur"
        record_result "uv-tools" "CLI" "UP TO DATE" "Verified" "$dur"
      fi
    fi
  fi

  # 10. Python pip AI Tools & Agent Packages (Windows & Linux)
  if ({ [[ ${#PYTHON_CMD[@]} -gt 0 ]] || detect_python; } && run_py -m pip --version &>/dev/null) && should_run "pip-ai" "cli"; then
    log_card_start "Python pip AI Tools (pip-ai)" "cli"
    t_start="$(now_ns)"
    pip_installed=()
    pip_upgradable=()
    pip_upgradable_names=()

    while read -r pkg ver; do
      [[ -z "$pkg" || -z "$ver" ]] && continue
      pip_installed+=("${pkg}@${ver}")
      pypi_v=$(curl -s --connect-timeout 3 "https://pypi.org/pypi/${pkg}/json" 2>/dev/null | json_get_stdin "info.version")
      if [[ -n "$pypi_v" ]] && is_version_gt "$pypi_v" "$ver"; then
        pip_upgradable+=("${pkg}:${ver}→${pypi_v}")
        pip_upgradable_names+=("$pkg")
        log_step "Update available: ${pkg} (${ver} → ${pypi_v})"
      fi
    done < <(get_pip_ai_installed)

    if [[ ${#pip_installed[@]} -eq 0 ]]; then
      dur="$(elapsed_since "$t_start")"
      log_card_end "SKIPPED" "No tracked pip AI packages installed" "$dur"
      record_result "pip-ai" "CLI" "SKIPPED" "None installed" "$dur"
    elif [[ $DRY_RUN -eq 1 ]]; then
      dur="$(elapsed_since "$t_start")"
      if [[ ${#pip_upgradable[@]} -gt 0 ]]; then
        log_card_end "UPDATE AVAIL" "${#pip_upgradable[@]} package(s) upgradable" "$dur"
        record_result "pip-ai" "CLI" "UPDATE AVAIL" "${#pip_upgradable[@]} upgradable" "$dur"
      else
        log_card_end "UP TO DATE" "${#pip_installed[@]} tracked package(s) current" "$dur"
        record_result "pip-ai" "CLI" "UP TO DATE" "${#pip_installed[@]} current" "$dur"
      fi
    elif [[ ${#pip_upgradable_names[@]} -eq 0 ]]; then
      dur="$(elapsed_since "$t_start")"
      log_card_end "UP TO DATE" "${#pip_installed[@]} tracked package(s) current" "$dur"
      record_result "pip-ai" "CLI" "UP TO DATE" "${#pip_installed[@]} current" "$dur"
    else
      log_step "Upgrading ${#pip_upgradable_names[@]} pip AI package(s)..."
      pip_rc=0
      run_py -m pip install --upgrade "${pip_upgradable_names[@]}" 2>&1 | strip_cr | stream_progress 4 || pip_rc=$?
      dur="$(elapsed_since "$t_start")"
      if [[ $pip_rc -eq 0 ]]; then
        log_card_end "UPDATED" "Upgraded ${#pip_upgradable_names[@]} package(s)" "$dur"
        record_result "pip-ai" "CLI" "UPDATED" "${#pip_upgradable_names[@]} upgraded" "$dur"
      else
        log_card_end "FAILED" "pip upgrade exited ${pip_rc}" "$dur"
        record_result "pip-ai" "CLI" "FAILED" "Exit ${pip_rc}" "$dur"
      fi
    fi
  fi

  # 11. NPM Global AI Packages
  if command -v npm &>/dev/null && should_run "npm-globals" "cli"; then
    log_card_start "NPM Global AI Packages" "cli"
    t_start="$(now_ns)"
    init_npm_root_global
    node_root="$(get_npm_root_global)"
    npm_installed=()
    npm_upgradable=()
    npm_updated_count=0
    npm_fail_count=0

    for pkg in "${TRACKED_NPM_PKGS[@]}"; do
      if [[ -L "${node_root}/${pkg}" ]]; then
        log_step "Skipping symlinked local checkout: ${pkg}"
        continue
      fi
      curr_v="$(get_npm_pkg_version "$pkg")"
      [[ -z "$curr_v" ]] && continue
      npm_installed+=("$pkg")
      latest_v=$(npm view "$pkg" version 2>/dev/null | strip_cr || true)
      if [[ -n "$latest_v" ]] && is_version_gt "$latest_v" "$curr_v"; then
        npm_upgradable+=("${pkg}@${latest_v}")
        log_step "Newer version available: ${pkg} (${curr_v} → ${latest_v})"
      fi
    done

    if [[ ${#npm_installed[@]} -eq 0 ]]; then
      dur="$(elapsed_since "$t_start")"
      log_card_end "SKIPPED" "No tracked global packages installed" "$dur"
      record_result "npm-globals" "CLI" "SKIPPED" "None installed" "$dur"
    elif [[ $DRY_RUN -eq 1 ]]; then
      dur="$(elapsed_since "$t_start")"
      if [[ ${#npm_upgradable[@]} -gt 0 ]]; then
        log_card_end "UPDATE AVAIL" "${#npm_upgradable[@]} package(s) upgradable" "$dur"
        record_result "npm-globals" "CLI" "UPDATE AVAIL" "${#npm_upgradable[@]} upgradable" "$dur"
      else
        log_card_end "UP TO DATE" "${#npm_installed[@]} tracked package(s) current" "$dur"
        record_result "npm-globals" "CLI" "UP TO DATE" "${#npm_installed[@]} current" "$dur"
      fi
    elif [[ ${#npm_upgradable[@]} -eq 0 ]]; then
      dur="$(elapsed_since "$t_start")"
      log_card_end "UP TO DATE" "${#npm_installed[@]} tracked package(s) current" "$dur"
      record_result "npm-globals" "CLI" "UP TO DATE" "${#npm_installed[@]} current" "$dur"
    else
      for target in "${npm_upgradable[@]}"; do
        log_step "Installing ${target}..."
        NPM_DID_UPDATE=1
        if npm install -g "$target" 2>&1 | strip_cr | stream_progress 3; then
          ((npm_updated_count++)) || true
        else
          ((npm_fail_count++)) || true
        fi
      done
      dur="$(elapsed_since "$t_start")"
      if [[ $npm_fail_count -gt 0 ]]; then
        log_card_end "FAILED" "Updated ${npm_updated_count}, failed ${npm_fail_count}" "$dur"
        record_result "npm-globals" "CLI" "FAILED" "${npm_fail_count} failed" "$dur"
      else
        log_card_end "UPDATED" "Upgraded ${npm_updated_count} package(s)" "$dur"
        record_result "npm-globals" "CLI" "UPDATED" "${npm_updated_count} upgraded" "$dur"
      fi
    fi
  fi

  # 12. Ollama Runtime (Windows & Linux)
  ollama_bin="$(resolve_bin ollama 2>/dev/null || true)"
  if [[ -n "$ollama_bin" ]] && should_run "ollama" "cli"; then
    log_card_start "Ollama Local Runtime (ollama)" "cli"
    t_start="$(now_ns)"
    curr_v="$(get_version ollama)"
    if [[ $IS_WINDOWS -eq 1 ]]; then
      wg_rc=0
      run_winget_app "ollama" "Ollama Local Runtime" "CLI" "Ollama.Ollama" "$curr_v" || wg_rc=$?
      if [[ $wg_rc -eq 2 ]]; then
        check_github_release_status "ollama" "CLI" "ollama/ollama" "$curr_v" "$t_start"
      fi
    elif [[ $IS_MACOS -eq 1 && "$PKG_MGR" == "brew" ]]; then
      log_step "Checking Homebrew formula for ollama..."
      dur="$(elapsed_since "$t_start")"
      if brew outdated ollama 2>/dev/null | grep -q ollama; then
        if [[ $DRY_RUN -eq 1 ]]; then
          log_card_end "UPDATE AVAIL" "Newer brew bottle available (local ${curr_v})" "$dur"
          record_result "ollama" "CLI" "UPDATE AVAIL" "brew outdated" "$dur"
        else
          brew upgrade ollama 2>&1 | stream_progress 4
          dur="$(elapsed_since "$t_start")"
          log_card_end "UPDATED" "Upgraded via Homebrew" "$dur"
          record_result "ollama" "CLI" "UPDATED" "$(get_version ollama)" "$dur"
        fi
      else
        log_card_end "UP TO DATE" "Version v${curr_v#v} is current" "$dur"
        record_result "ollama" "CLI" "UP TO DATE" "v${curr_v#v}" "$dur"
      fi
    else
      check_github_release_status "ollama" "CLI" "ollama/ollama" "$curr_v" "$t_start"
    fi
  fi

  # 13. LM Studio CLI / App (Windows & Linux)
  if should_run "lms" "cli"; then
  lms_v="$(get_version lms)"
  if [[ "$lms_v" != "not installed" ]]; then
    log_card_start "LM Studio (lms)" "cli"
    t_start="$(now_ns)"
    if [[ $IS_WINDOWS -eq 1 ]]; then
      wg_rc=0
      run_winget_app "lms" "LM Studio" "CLI" "ElementLabs.LMStudio" "$lms_v" || wg_rc=$?
      if [[ $wg_rc -eq 2 ]]; then
        dur="$(elapsed_since "$t_start")"
        log_card_end "SKIPPED" "v${lms_v#v} (self-managed in LM Studio)" "$dur"
        record_result "lms" "CLI" "SKIPPED" "v${lms_v#v} (self-managed)" "$dur"
      fi
    else
      dur="$(elapsed_since "$t_start")"
      log_card_end "SKIPPED" "v${lms_v#v} (self-managed in LM Studio)" "$dur"
      record_result "lms" "CLI" "SKIPPED" "v${lms_v#v} (self-managed)" "$dur"
    fi
  fi
  fi
fi

# ==============================================================================
# SECTION 2: DESKTOP AI APPS & WORKSPACES
# ==============================================================================
if [[ "$FILTER_TYPE" == "all" || "$FILTER_TYPE" == "desktop" ]]; then
  [[ "$OUTPUT_FORMAT" != "json" ]] && echo -e "${BOLD}${MAGENTA}❖ [SECTION 2] DESKTOP AI APPS & WORKSPACES${RESET}\n"

  # 14. ChatGPT Desktop App (Linux RPM/DEB/Flatpak, macOS, Windows MSIX/winget)
  if should_run "chatgpt" "desktop" && { curr_v="$(get_version chatgpt)"; [[ "$curr_v" != "not installed" ]]; }; then
    log_card_start "ChatGPT Desktop App (chatgpt)" "desktop"
    t_start="$(now_ns)"
    if [[ $IS_WINDOWS -eq 1 ]]; then
      wg_rc=0
      run_winget_app "chatgpt" "ChatGPT Desktop App" "DESKTOP" "OpenAI.ChatGPT" "$curr_v" || wg_rc=$?
      if [[ $wg_rc -eq 2 ]]; then
        dur="$(elapsed_since "$t_start")"
        log_card_end "SKIPPED" "v${curr_v} (Microsoft Store / self-managed)" "$dur"
        record_result "chatgpt" "DESKTOP" "SKIPPED" "v${curr_v} (Store managed)" "$dur"
      fi
    elif [[ $IS_LINUX -eq 1 ]]; then
      if command -v flatpak &>/dev/null && flatpak info com.openai.ChatGPT &>/dev/null; then
        if [[ $DRY_RUN -eq 1 ]]; then
          dur="$(elapsed_since "$t_start")"
          log_card_end "SKIPPED" "Flatpak v${curr_v} (use flatpak update)" "$dur"
          record_result "chatgpt" "DESKTOP" "SKIPPED" "Flatpak v${curr_v}" "$dur"
        else
          flatpak update -y com.openai.ChatGPT 2>&1 | stream_progress 4
          dur="$(elapsed_since "$t_start")"
          log_card_end "UPDATED" "Checked/updated Flatpak" "$dur"
          record_result "chatgpt" "DESKTOP" "UPDATED" "$(get_version chatgpt)" "$dur"
        fi
      else
        run_linux_pkg_upgrade "chatgpt" "chatgpt" "$curr_v" "$t_start"
      fi
    else
      dur="$(elapsed_since "$t_start")"
      log_card_end "SKIPPED" "v${curr_v} (managed externally)" "$dur"
      record_result "chatgpt" "DESKTOP" "SKIPPED" "Managed externally" "$dur"
    fi
  fi

  # 15. OpenCode Desktop App (Linux RPM/DEB/AppImage, Windows winget/NSIS latest.yml)
  if should_run "opencode-desktop" "desktop" && { curr_v="$(get_version opencode-desktop)"; [[ "$curr_v" != "not installed" ]]; }; then
    log_card_start "OpenCode Desktop App (opencode-desktop)" "desktop"
    t_start="$(now_ns)"

    if [[ $IS_WINDOWS -eq 1 ]]; then
      wg_rc=0
      run_winget_app "opencode-desktop" "OpenCode Desktop App" "DESKTOP" "Anomaly.OpenCode.Desktop" "$curr_v" || wg_rc=$?
      if [[ $wg_rc -eq 2 ]]; then
        log_step "Querying OpenCode release manifest (latest.yml)..."
        yml_data=$(curl -fsSL --connect-timeout 4 https://github.com/anomalyco/opencode/releases/latest/download/latest.yml 2>/dev/null | strip_cr || true)
        win_asset="opencode-desktop-win-x64.exe"
        [[ "$ARCH" == "aarch64" || "$ARCH" == "arm64" ]] && win_asset="opencode-desktop-win-arm64.exe"
        latest_tag=""
        expected_sha512=""
        if [[ -n "$yml_data" ]]; then
          latest_tag=$(printf '%s\n' "$yml_data" | awk '/^version:/ {print $2; exit}' | tr -d "'\"" | sed 's/^v//')
          expected_sha512=$(printf '%s\n' "$yml_data" | awk -v asset="$win_asset" '
            $0 ~ "- url: " asset {found=1; next}
            found && /sha512:/ {print $2; exit}
            found && /- url:/ {exit}
          ' | tr -d "'\"")
        fi
        if [[ -z "$latest_tag" ]]; then
          dur="$(elapsed_since "$t_start")"
          log_card_end "FAILED" "Could not query upstream OpenCode release" "$dur"
          record_result "opencode-desktop" "DESKTOP" "FAILED" "Query failed" "$dur"
        elif is_version_gt "$latest_tag" "$curr_v"; then
          log_step "Found newer release: v${latest_tag} (local: v${curr_v})"
          if [[ $DRY_RUN -eq 1 ]]; then
            dur="$(elapsed_since "$t_start")"
            log_card_end "UPDATE AVAIL" "v${curr_v} → v${latest_tag}" "$dur"
            record_result "opencode-desktop" "DESKTOP" "UPDATE AVAIL" "v${latest_tag}" "$dur"
          else
            exe_cache="${LOCALAPPDATA_DIR}/@opencode-aidesktop-updater/pending/${win_asset}"
            mkdir -p "$(dirname "$exe_cache")"
            exe_url="https://github.com/anomalyco/opencode/releases/download/v${latest_tag}/${win_asset}"
            log_step "Downloading Windows installer (${win_asset})..."
            exe_tmp="${exe_cache}.part"
            if curl -fL --connect-timeout 5 -o "$exe_tmp" "$exe_url" 2>&1 | stream_progress 2; then
              mv -f "$exe_tmp" "$exe_cache"
              if [[ -n "$expected_sha512" ]] && ! verify_sha512_b64 "$exe_cache" "$expected_sha512"; then
                rm -f "$exe_cache"
                dur="$(elapsed_since "$t_start")"
                log_card_end "FAILED" "Downloaded installer failed SHA-512 verification" "$dur"
                record_result "opencode-desktop" "DESKTOP" "FAILED" "Bad checksum" "$dur"
              else
                log_step "SHA-512 verified; running silent NSIS upgrade..."
                inst_rc=0
                "$(to_posix_path "$exe_cache")" /S < /dev/null 2>&1 | stream_progress 3 || inst_rc=$?
                dur="$(elapsed_since "$t_start")"
                if [[ $inst_rc -eq 0 ]]; then
                  log_card_end "UPDATED" "Installed v${latest_tag}" "$dur"
                  record_result "opencode-desktop" "DESKTOP" "UPDATED" "v${latest_tag}" "$dur"
                else
                  log_card_end "CACHED" "Installer ready at $(to_native_path "$exe_cache")" "$dur"
                  record_result "opencode-desktop" "DESKTOP" "CACHED" "Installer ready" "$dur"
                fi
              fi
            else
              rm -f "$exe_tmp"
              dur="$(elapsed_since "$t_start")"
              log_card_end "FAILED" "Download failed for v${latest_tag}" "$dur"
              record_result "opencode-desktop" "DESKTOP" "FAILED" "Download failed" "$dur"
            fi
          fi
        else
          dur="$(elapsed_since "$t_start")"
          log_card_end "UP TO DATE" "Version v${curr_v} is current (latest: v${latest_tag})" "$dur"
          record_result "opencode-desktop" "DESKTOP" "UP TO DATE" "v${curr_v}" "$dur"
        fi
      fi
    elif [[ $IS_LINUX -eq 1 ]]; then
      linux_pkg_type=""
      linux_asset=""
      if command -v rpm &>/dev/null && rpm -q opencode &>/dev/null && [[ "$ARCH" == "x86_64" && "$PKG_MGR" == "dnf" ]]; then
        linux_pkg_type="rpm"
        linux_asset="opencode-desktop-linux-x86_64.rpm"
      elif command -v dpkg-query &>/dev/null && dpkg-query -W -f='${Status}\n' opencode 2>/dev/null | grep -q "install ok installed"; then
        linux_pkg_type="deb"
        linux_asset="opencode-desktop-linux-amd64.deb"
        [[ "$ARCH" == "aarch64" ]] && linux_asset="opencode-desktop-linux-arm64.deb"
      elif [[ "$curr_v" != "unmanaged" && "$curr_v" != "not installed" ]] && find_first_appimage 'OpenCode*.AppImage' 'opencode*.AppImage' &>/dev/null; then
        linux_pkg_type="appimage"
        linux_asset="opencode-desktop-linux-x86_64.AppImage"
      fi

      if [[ -z "$linux_pkg_type" ]]; then
        dur="$(elapsed_since "$t_start")"
        log_card_end "SKIPPED" "Requires RPM/DEB/AppImage install (detected: ${curr_v}, ${ARCH}/${PKG_MGR})" "$dur"
        record_result "opencode-desktop" "DESKTOP" "SKIPPED" "Unsupported pkg" "$dur"
      else
        log_step "Inspecting local ${linux_pkg_type^^} installation (v${curr_v})..."
        log_step "Querying OpenCode release manifest (latest-linux.yml)..."
        yml_data=$(curl -fsSL --connect-timeout 4 https://github.com/anomalyco/opencode/releases/latest/download/latest-linux.yml 2>/dev/null || true)
        latest_tag=""
        expected_sha512=""
        if [[ -n "$yml_data" ]]; then
          latest_tag=$(printf '%s\n' "$yml_data" | awk '/^version:/ {print $2; exit}' | tr -d "'\"" | sed 's/^v//')
          expected_sha512=$(printf '%s\n' "$yml_data" | awk -v asset="$linux_asset" '
            $0 ~ "- url: " asset {found=1; next}
            found && /sha512:/ {print $2; exit}
            found && /- url:/ {exit}
          ' | tr -d "'\"")
        else
          log_step "Falling back to GitHub releases API..."
          latest_tag=$(curl -s --connect-timeout 4 https://api.github.com/repos/anomalyco/opencode/releases/latest 2>/dev/null | json_get_stdin "tag_name" | sed 's/^v//')
        fi

        if [[ -z "$latest_tag" ]]; then
          dur="$(elapsed_since "$t_start")"
          log_card_end "FAILED" "Could not query upstream OpenCode release" "$dur"
          record_result "opencode-desktop" "DESKTOP" "FAILED" "Query failed" "$dur"
        elif is_version_gt "$latest_tag" "$curr_v"; then
          log_step "Found newer release: v${latest_tag} (local: v${curr_v})"
          if [[ $DRY_RUN -eq 1 ]]; then
            dur="$(elapsed_since "$t_start")"
            log_card_end "UPDATE AVAIL" "v${curr_v} → v${latest_tag}" "$dur"
            record_result "opencode-desktop" "DESKTOP" "UPDATE AVAIL" "v${latest_tag}" "$dur"
          elif [[ "$linux_pkg_type" == "appimage" ]]; then
            appimg_dest="$(find_first_appimage 'OpenCode*.AppImage' 'opencode*.AppImage')"
            appimg_url="https://github.com/anomalyco/opencode/releases/download/v${latest_tag}/${linux_asset}"
            appimg_tmp="${appimg_dest}.part"
            if curl -fL --connect-timeout 5 -o "$appimg_tmp" "$appimg_url" 2>&1 | stream_progress 2; then
              if [[ -n "$expected_sha512" ]] && ! verify_sha512_b64 "$appimg_tmp" "$expected_sha512"; then
                rm -f "$appimg_tmp"
                dur="$(elapsed_since "$t_start")"
                log_card_end "FAILED" "AppImage failed SHA-512 verification" "$dur"
                record_result "opencode-desktop" "DESKTOP" "FAILED" "Bad checksum" "$dur"
              else
                chmod +x "$appimg_tmp"
                mv -f "$appimg_tmp" "$appimg_dest"
                dur="$(elapsed_since "$t_start")"
                log_card_end "UPDATED" "Replaced AppImage v${latest_tag}" "$dur"
                record_result "opencode-desktop" "DESKTOP" "UPDATED" "v${latest_tag}" "$dur"
              fi
            else
              rm -f "$appimg_tmp"
              dur="$(elapsed_since "$t_start")"
              log_card_end "FAILED" "Download failed for v${latest_tag}" "$dur"
              record_result "opencode-desktop" "DESKTOP" "FAILED" "Download failed" "$dur"
            fi
          else
            pkg_cache="${HOME}/.cache/@opencode-aidesktop-updater/pending/${linux_asset}"
            mkdir -p "$(dirname "$pkg_cache")"
            pkg_url="https://github.com/anomalyco/opencode/releases/download/v${latest_tag}/${linux_asset}"

            need_download=1
            if [[ -f "$pkg_cache" ]]; then
              cached_v=""
              if [[ "$linux_pkg_type" == "rpm" ]]; then
                cached_v=$(rpm -qp "$pkg_cache" --queryformat "%{VERSION}" 2>/dev/null || true)
              else
                cached_v=$(dpkg-deb -f "$pkg_cache" Version 2>/dev/null | sed 's/-.*//' || true)
              fi
              if [[ "$cached_v" == "$latest_tag" ]]; then
                if [[ -z "$expected_sha512" ]] || verify_sha512_b64 "$pkg_cache" "$expected_sha512"; then
                  log_step "Verified ready cached package (v${cached_v}) at ${pkg_cache}"
                  need_download=0
                else
                  log_step "Cached package checksum mismatch; re-downloading..."
                  rm -f "$pkg_cache"
                fi
              fi
            fi

            download_ok=0
            if [[ $need_download -eq 0 ]]; then
              download_ok=1
            else
              log_step "Downloading ${linux_pkg_type^^} package from ${pkg_url}..."
              pkg_tmp="${pkg_cache}.part"
              if curl -fL --connect-timeout 5 -o "$pkg_tmp" "$pkg_url" 2>&1 | stream_progress 2; then
                mv -f "$pkg_tmp" "$pkg_cache"
                log_step "Downloaded package to ${pkg_cache}"
                download_ok=1
              else
                rm -f "$pkg_tmp"
              fi
            fi

            if [[ $download_ok -eq 1 ]]; then
              integrity_ok=1
              if [[ -n "$expected_sha512" ]]; then
                if verify_sha512_b64 "$pkg_cache" "$expected_sha512"; then
                  log_step "SHA-512 digest verified against latest-linux.yml"
                else
                  log_step "ERROR: SHA-512 verification failed for ${pkg_cache}"
                  rm -f "$pkg_cache"
                  integrity_ok=0
                fi
              fi
              if [[ $integrity_ok -eq 1 && "$linux_pkg_type" == "rpm" ]] && ! rpm -K --nosignature "$pkg_cache" &>/dev/null; then
                log_step "ERROR: RPM header/payload integrity check failed"
                rm -f "$pkg_cache"
                integrity_ok=0
              fi

              if [[ $integrity_ok -eq 0 ]]; then
                dur="$(elapsed_since "$t_start")"
                log_card_end "FAILED" "Downloaded package failed integrity check" "$dur"
                record_result "opencode-desktop" "DESKTOP" "FAILED" "Bad checksum" "$dur"
              else
                log_step "Installing verified ${linux_pkg_type^^} package (v${latest_tag})..."
                inst_rc=0
                if [[ "$linux_pkg_type" == "rpm" ]]; then
                  run_privileged "OpenCode Desktop RPM installation" rpm -U "$pkg_cache" 2>&1 | stream_progress 4 || inst_rc=$?
                else
                  run_privileged "OpenCode Desktop DEB installation" dpkg -i "$pkg_cache" 2>&1 | stream_progress 4 || inst_rc=$?
                fi
                dur="$(elapsed_since "$t_start")"
                if [[ $inst_rc -eq 0 ]]; then
                  log_card_end "UPDATED" "Installed v${latest_tag}" "$dur"
                  record_result "opencode-desktop" "DESKTOP" "UPDATED" "v${latest_tag}" "$dur"
                elif [[ $inst_rc -eq 1 || $inst_rc -eq 2 ]]; then
                  log_step "Privileged installation deferred"
                  local cmd_hint="sudo rpm -U ${pkg_cache}"
                  [[ "$linux_pkg_type" == "deb" ]] && cmd_hint="sudo dpkg -i ${pkg_cache}"
                  log_card_end "CACHED" "Run: ${cmd_hint}" "$dur"
                  record_result "opencode-desktop" "DESKTOP" "CACHED" "${linux_pkg_type^^} ready" "$dur"
                else
                  log_card_end "FAILED" "${linux_pkg_type^^} install exited ${inst_rc}" "$dur"
                  record_result "opencode-desktop" "DESKTOP" "FAILED" "${linux_pkg_type^^} error (${inst_rc})" "$dur"
                fi
              fi
            else
              dur="$(elapsed_since "$t_start")"
              log_card_end "FAILED" "Download failed for v${latest_tag}" "$dur"
              record_result "opencode-desktop" "DESKTOP" "FAILED" "Download failed" "$dur"
            fi
          fi
        else
          dur="$(elapsed_since "$t_start")"
          log_card_end "UP TO DATE" "Version v${curr_v} is current (latest: v${latest_tag})" "$dur"
          record_result "opencode-desktop" "DESKTOP" "UP TO DATE" "v${curr_v}" "$dur"
        fi
      fi
    fi
  fi

  # 16. AionUi Desktop Workspace
  if should_run "aionui" "desktop" && { curr_v="$(get_version aionui)"; [[ "$curr_v" != "not installed" ]]; }; then
    log_card_start "AionUi AI Workspace (aionui)" "desktop"
    t_start="$(now_ns)"
    if [[ $IS_WINDOWS -eq 1 ]]; then
      wg_rc=0
      run_winget_app "aionui" "AionUi AI Workspace" "DESKTOP" "iOfficeAI.AionUi" "$curr_v" || wg_rc=$?
      if [[ $wg_rc -eq 2 ]]; then
        check_github_release_status "aionui" "DESKTOP" "iOfficeAI/AionUi" "$curr_v" "$t_start"
      fi
    else
      check_github_release_status "aionui" "DESKTOP" "iOfficeAI/AionUi" "$curr_v" "$t_start"
    fi
  fi

  # 17. Google Antigravity Desktop IDE
  if should_run "antigravity-desktop" "desktop" && { curr_v="$(get_version antigravity-desktop)"; [[ "$curr_v" != "not installed" ]]; }; then
    log_card_start "Google Antigravity IDE (antigravity-desktop)" "desktop"
    t_start="$(now_ns)"
    if [[ $IS_WINDOWS -eq 1 ]]; then
      wg_rc=0
      run_winget_app "antigravity-desktop" "Google Antigravity IDE" "DESKTOP" "Google.Antigravity" "$curr_v" || wg_rc=$?
      if [[ $wg_rc -eq 2 ]]; then
        dur="$(elapsed_since "$t_start")"
        log_card_end "SKIPPED" "IDE v${curr_v} (self-managed)" "$dur"
        record_result "antigravity-desktop" "DESKTOP" "SKIPPED" "v${curr_v} (self-managed)" "$dur"
      fi
    elif [[ $IS_LINUX -eq 1 ]] && get_linux_pkg_version antigravity &>/dev/null; then
      run_linux_pkg_upgrade "antigravity-desktop" "antigravity" "$curr_v" "$t_start"
    else
      log_step "Local IDE shell v${curr_v}"
      log_step "Auto-updated internally by Antigravity Desktop; CLI engine updated via 'agy'"
      dur="$(elapsed_since "$t_start")"
      log_card_end "SKIPPED" "IDE v${curr_v} (self-managed)" "$dur"
      record_result "antigravity-desktop" "DESKTOP" "SKIPPED" "v${curr_v} (self-managed)" "$dur"
    fi
  fi

  # 18. ZhipuAI ZCode Desktop (Windows winget/GitHub SHA256SUMS + Linux repo/GitHub check)
  if should_run "zcode" "desktop" && { curr_v="$(get_version zcode)"; [[ "$curr_v" != "not installed" ]]; }; then
    log_card_start "ZhipuAI ZCode Desktop (zcode)" "desktop"
    t_start="$(now_ns)"
    if [[ $IS_WINDOWS -eq 1 ]]; then
      wg_rc=0
      run_winget_app "zcode" "ZhipuAI ZCode Desktop" "DESKTOP" "ZhipuAI.ZCode" "$curr_v" || wg_rc=$?
      if [[ $wg_rc -eq 2 ]]; then
        check_github_release_status "zcode" "DESKTOP" "zai-org/ZCode" "$curr_v" "$t_start"
      fi
    elif [[ $IS_LINUX -eq 1 ]] && get_linux_pkg_version zcode ZCode &>/dev/null; then
      pkg_n="zcode"
      get_linux_pkg_version ZCode &>/dev/null && pkg_n="ZCode"
      run_linux_pkg_upgrade "zcode" "$pkg_n" "$curr_v" "$t_start"
    else
      check_github_release_status "zcode" "DESKTOP" "zai-org/ZCode" "$curr_v" "$t_start"
    fi
  fi

  # 19. Microsoft Copilot (Windows Copilot Desktop + Linux gh-copilot)
  if should_run "copilot" "desktop" && { curr_v="$(get_version copilot)"; [[ "$curr_v" != "not installed" ]]; }; then
    log_card_start "Microsoft Copilot (copilot)" "desktop"
    t_start="$(now_ns)"
    if [[ $IS_WINDOWS -eq 1 ]]; then
      wg_rc=0
      run_winget_app "copilot" "Microsoft Copilot" "DESKTOP" "Microsoft.365Copilot" "$curr_v" || wg_rc=$?
      if [[ $wg_rc -eq 2 ]]; then
        run_winget_app "copilot" "Microsoft Copilot" "DESKTOP" "Microsoft.Copilot" "$curr_v" || wg_rc=$?
      fi
      if [[ $wg_rc -eq 2 ]]; then
        dur="$(elapsed_since "$t_start")"
        log_card_end "SKIPPED" "v${curr_v} (Microsoft Store managed)" "$dur"
        record_result "copilot" "DESKTOP" "SKIPPED" "v${curr_v} (Store)" "$dur"
      fi
    else
      if command -v gh &>/dev/null && gh extension list 2>/dev/null | grep -qi "copilot"; then
        if [[ $DRY_RUN -eq 1 ]]; then
          dur="$(elapsed_since "$t_start")"
          log_card_end "SKIPPED" "v${curr_v} (gh extension lacks --check)" "$dur"
          record_result "copilot" "DESKTOP" "SKIPPED" "No --check" "$dur"
        else
          rc=0; output=$(gh extension upgrade gh-copilot 2>&1) || rc=$?
          printf '%s\n' "$output" | stream_progress 3
          dur="$(elapsed_since "$t_start")"
          if [[ $rc -ne 0 ]]; then
            log_card_end "FAILED" "gh extension upgrade exited ${rc}" "$dur"
            record_result "copilot" "DESKTOP" "FAILED" "Exit ${rc}" "$dur"
          elif printf '%s\n' "$output" | grep -qiE "Successfully|Upgraded"; then
            log_card_end "UPDATED" "Upgraded gh-copilot" "$dur"
            record_result "copilot" "DESKTOP" "UPDATED" "$(get_version copilot)" "$dur"
          else
            log_card_end "UP TO DATE" "Current (${curr_v})" "$dur"
            record_result "copilot" "DESKTOP" "UP TO DATE" "${curr_v}" "$dur"
          fi
        fi
      else
        dur="$(elapsed_since "$t_start")"
        log_card_end "SKIPPED" "v${curr_v} (self-managed)" "$dur"
        record_result "copilot" "DESKTOP" "SKIPPED" "v${curr_v}" "$dur"
      fi
    fi
  fi

  # 20. Anthropic Claude Desktop App (Windows & Linux)
  if should_run "claude-desktop" "desktop" && { curr_v="$(get_version claude-desktop)"; [[ "$curr_v" != "not installed" ]]; }; then
    log_card_start "Claude Desktop App (claude-desktop)" "desktop"
    t_start="$(now_ns)"
    if [[ $IS_WINDOWS -eq 1 ]]; then
      wg_rc=0
      run_winget_app "claude-desktop" "Claude Desktop App" "DESKTOP" "Anthropic.Claude" "$curr_v" || wg_rc=$?
      if [[ $wg_rc -eq 2 ]]; then
        dur="$(elapsed_since "$t_start")"
        log_card_end "SKIPPED" "v${curr_v} (self-managed)" "$dur"
        record_result "claude-desktop" "DESKTOP" "SKIPPED" "v${curr_v} (self-managed)" "$dur"
      fi
    elif [[ $IS_LINUX -eq 1 ]] && get_linux_pkg_version claude-desktop &>/dev/null; then
      run_linux_pkg_upgrade "claude-desktop" "claude-desktop" "$curr_v" "$t_start"
    else
      dur="$(elapsed_since "$t_start")"
      log_card_end "SKIPPED" "v${curr_v} (self-managed)" "$dur"
      record_result "claude-desktop" "DESKTOP" "SKIPPED" "v${curr_v} (self-managed)" "$dur"
    fi
  fi

  # 21. OpenAI Codex Desktop App (Windows & Linux)
  if should_run "codex-desktop" "desktop" && { curr_v="$(get_version codex-desktop)"; [[ "$curr_v" != "not installed" ]]; }; then
    log_card_start "OpenAI Codex Desktop App (codex-desktop)" "desktop"
    t_start="$(now_ns)"
    if [[ $IS_WINDOWS -eq 1 ]]; then
      dur="$(elapsed_since "$t_start")"
      log_card_end "SKIPPED" "v${curr_v} (Store/app auto-updated)" "$dur"
      record_result "codex-desktop" "DESKTOP" "SKIPPED" "v${curr_v} (self-managed)" "$dur"
    elif [[ $IS_LINUX -eq 1 ]] && get_linux_pkg_version codex-desktop &>/dev/null; then
      run_linux_pkg_upgrade "codex-desktop" "codex-desktop" "$curr_v" "$t_start"
    else
      dur="$(elapsed_since "$t_start")"
      log_card_end "SKIPPED" "v${curr_v} (self-managed)" "$dur"
      record_result "codex-desktop" "DESKTOP" "SKIPPED" "v${curr_v} (self-managed)" "$dur"
    fi
  fi

  # 22 & 23. Local Git Desktop Repositories (CoWork-OS & Orkas)
  sync_git_desktop_repo "cowork-os" "CoWork-OS Desktop (~/CoWork-OS)" "$HOME/CoWork-OS" "npm install --silent && npm run build"
  sync_git_desktop_repo "orkas"     "Orkas Desktop Client (~/Orkas)"   "$HOME/Orkas"     "npm install --silent"

  # 24. Hermes Desktop UI
  if should_run "hermes-desktop" "desktop" && { hermes_desk_v="$(get_version hermes-desktop)"; [[ "$hermes_desk_v" != "not installed" ]]; }; then
    log_card_start "Hermes Desktop UI (hermes-desktop)" "desktop"
    t_start="$(now_ns)"
    if [[ $IS_WINDOWS -eq 1 && "$hermes_desk_v" != "Available" ]]; then
      log_step "Detected Windows Hermes Desktop MSIX (v${hermes_desk_v})"
      dur="$(elapsed_since "$t_start")"
      log_card_end "SKIPPED" "MSIX v${hermes_desk_v} (Store/AppInstaller)" "$dur"
      record_result "hermes-desktop" "DESKTOP" "SKIPPED" "MSIX v${hermes_desk_v}" "$dur"
    else
      log_step "Built/launched on demand via 'hermes desktop' from core hermes-agent checkout"
      dur="$(elapsed_since "$t_start")"
      log_card_end "SKIPPED" "Bundled with 'hermes' core" "$dur"
      record_result "hermes-desktop" "DESKTOP" "SKIPPED" "Bundled w/ hermes" "$dur"
    fi
  fi
fi

# ==============================================================================
# SECTION 3: HOUSEKEEPING & SYSTEM DEBLOAT
# ==============================================================================
if [[ $DO_CLEANUP -eq 1 && ("$FILTER_TYPE" == "all" || "$FILTER_TYPE" == "clean") ]]; then
  [[ "$OUTPUT_FORMAT" != "json" ]] && echo -e "${BOLD}${BLUE}🧹 [SECTION 3] HOUSEKEEPING & SYSTEM DEBLOAT${RESET}\n"

  # 25. Python uv Cache & Environments
  uv_bin="$(resolve_bin uv 2>/dev/null || true)"
  uv_cache_dir="$HOME/.cache/uv"
  [[ $IS_WINDOWS -eq 1 ]] && uv_cache_dir="${LOCALAPPDATA_DIR}/uv/cache"
  if [[ -n "$uv_bin" || -d "$uv_cache_dir" ]] && should_run "clean-uv" "clean"; then
    log_card_start "Python uv Cache & Environments" "clean"
    t_start="$(now_ns)"
    log_step "Checking dangling wheel builds and orphaned cache entries..."
    if [[ -z "$uv_bin" ]]; then
      uv_sz="$(dir_size_human "$uv_cache_dir")"
      dur="$(elapsed_since "$t_start")"
      log_card_end "SKIPPED" "uv not installed (${uv_sz} leftover at uv/cache)" "$dur"
      record_result "clean-uv" "CLEAN" "SKIPPED" "uv missing (${uv_sz})" "$dur"
    elif [[ $DRY_RUN -eq 1 ]]; then
      uv_sz="$(dir_size_human "$uv_cache_dir")"
      dur="$(elapsed_since "$t_start")"
      log_card_end "UP TO DATE" "Cache footprint: ${uv_sz}" "$dur"
      record_result "clean-uv" "CLEAN" "UP TO DATE" "Footprint: ${uv_sz}" "$dur"
    else
      uv_out=$("$uv_bin" cache prune 2>&1 | strip_cr || true)
      dur="$(elapsed_since "$t_start")"
      if printf '%s\n' "$uv_out" | grep -qi "Removed [1-9]"; then
        uv_files=$(printf '%s\n' "$uv_out" | grep -oE 'Removed [0-9]+ files?' | awk '{print $2 " " $3}')
        uv_bytes=$(printf '%s\n' "$uv_out" | grep -oE '\([^)]+\)' | tr -d '()' | head -n 1)
        uv_detail="${uv_files}${uv_bytes:+, ${uv_bytes}}"
        log_card_end "CLEANED" "Pruned ${uv_detail}" "$dur"
        record_result "clean-uv" "CLEAN" "CLEANED" "$uv_detail" "$dur"
      else
        log_card_end "UP TO DATE" "Cache optimal (0 dangling files)" "$dur"
        record_result "clean-uv" "CLEAN" "UP TO DATE" "0 dangling files" "$dur"
      fi
    fi
  fi

  # 26. NPM Cache & Debug Logs
  if command -v npm &>/dev/null && should_run "clean-npm" "clean"; then
    log_card_start "NPM Cache & Debug Logs" "clean"
    t_start="$(now_ns)"
    npm_cache_dir="$(get_npm_cache_dir)"
    npm_logs_dir="${npm_cache_dir}/_logs"
    log_count="$(count_files_in_dir "$npm_logs_dir")"
    log_step "Scanning debug logs (${npm_logs_dir}: ${log_count} files)..."
    if [[ $DRY_RUN -eq 1 ]]; then
      dur="$(elapsed_since "$t_start")"
      log_card_end "UP TO DATE" "${log_count} debug log(s) present" "$dur"
      record_result "clean-npm" "CLEAN" "UP TO DATE" "${log_count} logs present" "$dur"
    else
      cleaned_npm=0
      gc_info=""
      if [[ $log_count -gt 0 ]]; then
        rm -rf "${npm_logs_dir}/"* 2>/dev/null || true
        cleaned_npm=1
      fi
      if [[ "$FILTER_TYPE" == "clean" || $NPM_DID_UPDATE -eq 1 || $log_count -gt 0 ]]; then
        log_step "Verifying cache integrity (npm cache verify)..."
        npm_out=$(npm cache verify 2>&1 | strip_cr || true)
        gc_count=$(printf '%s\n' "$npm_out" | awk -F: '/Content garbage-collected/ {print $2}' | awk '{print $1}')
        gc_bytes=$(printf '%s\n' "$npm_out" | grep -i "Content garbage-collected" | grep -oE '\([0-9]+ bytes\)' | tr -d '() bytes' || true)
        if [[ -n "$gc_count" && "$gc_count" -gt 0 ]]; then
          cleaned_npm=1
          gc_info=$(awk -v b="${gc_bytes:-0}" 'BEGIN {if (b>=1048576) printf "%.1fMB", b/1048576; else printf "%.0fKB", b/1024}')
        fi
      fi
      dur="$(elapsed_since "$t_start")"
      if [[ $cleaned_npm -eq 1 ]]; then
        detail_msg="Purged ${log_count} log(s)${gc_info:+, GC ${gc_info}}"
        short_msg="${log_count} log(s)${gc_info:+, GC ${gc_info}}"
        log_card_end "CLEANED" "$detail_msg" "$dur"
        record_result "clean-npm" "CLEAN" "CLEANED" "$short_msg" "$dur"
      else
        log_card_end "UP TO DATE" "0 stale logs; cache skipped (idle)" "$dur"
        record_result "clean-npm" "CLEAN" "UP TO DATE" "Cache clean" "$dur"
      fi
    fi
  fi

  # 27. Python Pip Wheel Cache
  if ({ [[ ${#PYTHON_CMD[@]} -gt 0 ]] || detect_python; } && run_py -m pip --version &>/dev/null) && should_run "clean-pip" "clean"; then
    log_card_start "Python Pip Cache" "clean"
    t_start="$(now_ns)"
    if [[ $DRY_RUN -eq 1 ]]; then
      pip_sz=$(run_py -m pip cache info 2>/dev/null | strip_cr | awk -F: '/Package index page cache size/ {gsub(/^[ \t]+/, "", $2); print $2; exit}')
      dur="$(elapsed_since "$t_start")"
      log_card_end "UP TO DATE" "Cache footprint: ${pip_sz:-0B}" "$dur"
      record_result "clean-pip" "CLEAN" "UP TO DATE" "Footprint: ${pip_sz:-0B}" "$dur"
    else
      log_step "Purging cached wheel downloads and HTTP index files..."
      pip_out=$(run_py -m pip cache purge 2>&1 | strip_cr || true)
      dur="$(elapsed_since "$t_start")"
      removed_files=$(printf '%s\n' "$pip_out" | sed -n 's/^Files removed: \([0-9][0-9]*\).*/\1/p' | head -n 1)
      removed_size=$(printf '%s\n' "$pip_out" | sed -n 's/^Files removed: [0-9][0-9]* (\([^)]*\)).*/\1/p' | head -n 1)
      if [[ -n "$removed_files" && "$removed_files" -gt 0 ]]; then
        log_card_end "CLEANED" "Purged ${removed_files} files (${removed_size:-0B})" "$dur"
        record_result "clean-pip" "CLEAN" "CLEANED" "${removed_files} files (${removed_size:-0B})" "$dur"
      else
        log_card_end "UP TO DATE" "Cache empty (0 files removed)" "$dur"
        record_result "clean-pip" "CLEAN" "UP TO DATE" "0 files (empty)" "$dur"
      fi
    fi
  fi

  # 28. Desktop Updater Packages & Temp Installers
  if should_run "clean-installers" "clean"; then
    log_card_start "Desktop Updater Packages & Temp Installers" "clean"
    t_start="$(now_ns)"
    installer_status="UP TO DATE"
    installer_detail="No stale installers"
    installer_short=""
    reclaimed_list=()
    kept_list=()

    if [[ $IS_LINUX -eq 1 ]]; then
      rpm_cache="$HOME/.cache/@opencode-aidesktop-updater/pending/opencode-desktop-linux-x86_64.rpm"
      deb_cache="$HOME/.cache/@opencode-aidesktop-updater/pending/opencode-desktop-linux-amd64.deb"
      if [[ -f "$rpm_cache" ]] && command -v rpm &>/dev/null; then
        cached_v=$(rpm -qp "$rpm_cache" --queryformat "%{VERSION}" 2>/dev/null || true)
        curr_v=$(rpm -q --queryformat "%{VERSION}" opencode 2>/dev/null || true)
        sz=$(dir_size_human "$(dirname "$rpm_cache")")
        if [[ -n "$curr_v" && -n "$cached_v" ]] && ! is_version_gt "$cached_v" "$curr_v"; then
          if [[ $DRY_RUN -eq 1 ]]; then
            reclaimed_list+=("OpenCode RPM (${sz})")
          else
            rm -rf "$HOME/.cache/@opencode-aidesktop-updater/pending"* 2>/dev/null || true
            reclaimed_list+=("OpenCode RPM (${sz})")
          fi
        else
          kept_list+=("OpenCode v${cached_v:-RPM} (${sz})")
        fi
      fi
      if [[ -f "$deb_cache" ]] && command -v dpkg-deb &>/dev/null; then
        cached_v=$(dpkg-deb -f "$deb_cache" Version 2>/dev/null | sed 's/-.*//' || true)
        curr_v=$(get_linux_pkg_version opencode opencode-desktop || true)
        sz=$(dir_size_human "$(dirname "$deb_cache")")
        if [[ -n "$curr_v" && -n "$cached_v" ]] && ! is_version_gt "$cached_v" "$curr_v"; then
          if [[ $DRY_RUN -eq 1 ]]; then
            reclaimed_list+=("OpenCode DEB (${sz})")
          else
            rm -rf "$HOME/.cache/@opencode-aidesktop-updater/pending"* 2>/dev/null || true
            reclaimed_list+=("OpenCode DEB (${sz})")
          fi
        else
          kept_list+=("OpenCode v${cached_v:-DEB} (${sz})")
        fi
      fi
    elif [[ $IS_WINDOWS -eq 1 ]]; then
      zcode_inst="${LOCALAPPDATA_DIR}/@zcodedesktop-updater/installer.exe"
      if [[ -f "$zcode_inst" ]]; then
        cached_v="$(get_pe_version "$zcode_inst" | awk -F. '{if(NF>=3) print $1"."$2"."$3; else print $0}' || true)"
        curr_v="$(get_version zcode)"
        sz="$(dir_size_human "${LOCALAPPDATA_DIR}/@zcodedesktop-updater")"
        if [[ "$curr_v" != "not installed" && -n "$cached_v" ]] && ! is_version_gt "$cached_v" "$curr_v"; then
          if [[ $DRY_RUN -eq 1 ]]; then
            reclaimed_list+=("ZCode v${cached_v} (${sz})")
          else
            rm -f "$zcode_inst" 2>/dev/null || true
            reclaimed_list+=("ZCode v${cached_v} (${sz})")
          fi
        else
          kept_list+=("ZCode v${cached_v:-exe} (${sz})")
        fi
      fi
      opencode_win_pending="${LOCALAPPDATA_DIR}/@opencode-aidesktop-updater/pending"
      if [[ -d "$opencode_win_pending" ]]; then
        sz="$(dir_size_human "$opencode_win_pending")"
        curr_v="$(get_version opencode-desktop)"
        if [[ "$curr_v" != "not installed" && "$sz" != "0B" ]]; then
          if [[ $DRY_RUN -eq 1 ]]; then
            reclaimed_list+=("OpenCode installer (${sz})")
          else
            rm -rf "$opencode_win_pending" 2>/dev/null || true
            reclaimed_list+=("OpenCode installer (${sz})")
          fi
        fi
      fi
    fi

    if [[ ${#reclaimed_list[@]} -gt 0 ]]; then
      if [[ $DRY_RUN -eq 1 ]]; then
        installer_status="UPDATE AVAIL"
        installer_detail="Reclaimable: ${reclaimed_list[*]}"
        installer_short="Reclaimable (${#reclaimed_list[@]})"
      else
        installer_status="CLEANED"
        installer_detail="Removed: ${reclaimed_list[*]}"
        installer_short="Removed ${#reclaimed_list[@]} pkg(s)"
      fi
    elif [[ ${#kept_list[@]} -gt 0 ]]; then
      installer_status="CACHED"
      installer_detail="Pending kept: ${kept_list[*]}"
      installer_short="Kept ${#kept_list[@]} pending"
    fi

    dur="$(elapsed_since "$t_start")"
    log_card_end "$installer_status" "$installer_detail" "$dur"
    record_result "clean-installers" "CLEAN" "$installer_status" "${installer_short:-$installer_detail}" "$dur"
  fi

  # 29. Local AI Git Repositories (git gc --auto)
  if should_run "clean-git" "clean"; then
    log_card_start "Local AI Git Repositories (git gc --auto)" "clean"
    t_start="$(now_ns)"
    repos_checked=0
    repos_packed=0
    for r in "$HOME/CoWork-OS" "$HOME/Orkas"; do
      if [[ -d "$r/.git" ]]; then
        ((repos_checked++)) || true
        before_loose=$(git -C "$r" count-objects 2>/dev/null | awk '{print $1}')
        if [[ $DRY_RUN -eq 0 ]]; then
          log_step "Running git gc --auto in ${r} (loose: ${before_loose:-0})..."
          git -C "$r" gc --auto --quiet 2>/dev/null || true
          after_loose=$(git -C "$r" count-objects 2>/dev/null | awk '{print $1}')
          if [[ -n "$before_loose" && -n "$after_loose" && "$after_loose" -lt "$before_loose" ]]; then
            ((repos_packed++)) || true
          fi
        fi
      fi
    done
    dur="$(elapsed_since "$t_start")"
    if [[ $repos_checked -eq 0 ]]; then
      log_card_end "SKIPPED" "No tracked git repos found" "$dur"
      record_result "clean-git" "CLEAN" "SKIPPED" "None found" "$dur"
    elif [[ $DRY_RUN -eq 1 ]]; then
      log_card_end "UP TO DATE" "Checked ${repos_checked} repo(s)" "$dur"
      record_result "clean-git" "CLEAN" "UP TO DATE" "${repos_checked} checked" "$dur"
    elif [[ $repos_packed -gt 0 ]]; then
      log_card_end "CLEANED" "Packed objects in ${repos_packed}/${repos_checked} repo(s)" "$dur"
      record_result "clean-git" "CLEAN" "CLEANED" "${repos_packed} repacked" "$dur"
    else
      log_card_end "UP TO DATE" "${repos_checked} repo(s) already packed" "$dur"
      record_result "clean-git" "CLEAN" "UP TO DATE" "${repos_checked} packed" "$dur"
    fi
  fi

  # 30. Cached Electron Distribution Archives
  electron_cache_dir="$HOME/.cache/electron"
  [[ $IS_WINDOWS -eq 1 ]] && electron_cache_dir="${LOCALAPPDATA_DIR}/electron/Cache"
  if [[ -d "$electron_cache_dir" ]] && should_run "clean-electron" "clean"; then
    log_card_start "Cached Electron Distribution Archives" "clean"
    t_start="$(now_ns)"
    log_step "Scanning cached distribution zips >7 days old (${electron_cache_dir})..."
    if [[ $DRY_RUN -eq 1 ]]; then
      read -r old_zips old_sz <<< "$(scan_or_prune_old_files scan "*.zip" 7 "$electron_cache_dir")"
      dur="$(elapsed_since "$t_start")"
      if [[ "${old_zips:-0}" -gt 0 ]]; then
        log_card_end "UPDATE AVAIL" "${old_zips} stale (>7d) archive(s) (${old_sz})" "$dur"
        record_result "clean-electron" "CLEAN" "UPDATE AVAIL" "${old_zips} (${old_sz})" "$dur"
      else
        log_card_end "UP TO DATE" "0 stale (>7d) archives" "$dur"
        record_result "clean-electron" "CLEAN" "UP TO DATE" "0 stale" "$dur"
      fi
    else
      read -r old_zips old_sz <<< "$(scan_or_prune_old_files prune "*.zip" 7 "$electron_cache_dir")"
      dur="$(elapsed_since "$t_start")"
      if [[ "${old_zips:-0}" -gt 0 ]]; then
        log_card_end "CLEANED" "Pruned ${old_zips} archive(s) (${old_sz})" "$dur"
        record_result "clean-electron" "CLEAN" "CLEANED" "${old_zips} (${old_sz})" "$dur"
      else
        log_card_end "UP TO DATE" "0 stale (>7d) archives" "$dur"
        record_result "clean-electron" "CLEAN" "UP TO DATE" "0 stale" "$dur"
      fi
    fi
  fi

  # 31. System Package Manager Cache Debloat (DNF / APT)
  if [[ $IS_LINUX -eq 1 ]] && { command -v dnf &>/dev/null || command -v apt-get &>/dev/null; } && should_run "clean-dnf" "clean"; then
    log_card_start "System Package Cache (DNF/APT)" "clean"
    t_start="$(now_ns)"
    if [[ $DRY_RUN -eq 1 ]]; then
      dur="$(elapsed_since "$t_start")"
      log_card_end "UP TO DATE" "System package cache check requires root" "$dur"
      record_result "clean-dnf" "CLEAN" "UP TO DATE" "Needs root check" "$dur"
    elif sudo -n true 2>/dev/null; then
      if command -v dnf &>/dev/null; then
        log_step "Cleaning root DNF package cache (sudo dnf clean packages)..."
        dnf_clean_out=$(sudo dnf clean packages 2>&1 || true)
        dur="$(elapsed_since "$t_start")"
        removed_rpm=$(printf '%s\n' "$dnf_clean_out" | sed -n 's/Removed \([0-9][0-9]*\) files.*/\1/p' | head -n 1)
        if [[ -n "$removed_rpm" && "$removed_rpm" -gt 0 ]]; then
          log_card_end "CLEANED" "Removed ${removed_rpm} cached RPM files" "$dur"
          record_result "clean-dnf" "CLEAN" "CLEANED" "${removed_rpm} RPMs purged" "$dur"
        else
          log_card_end "UP TO DATE" "DNF package cache empty" "$dur"
          record_result "clean-dnf" "CLEAN" "UP TO DATE" "Cache empty" "$dur"
        fi
      else
        log_step "Cleaning APT package cache (sudo apt-get autoclean)..."
        sudo apt-get autoclean -y &>/dev/null || true
        dur="$(elapsed_since "$t_start")"
        log_card_end "CLEANED" "Pruned obsolete APT archives" "$dur"
        record_result "clean-dnf" "CLEAN" "CLEANED" "APT autocleaned" "$dur"
      fi
    else
      dur="$(elapsed_since "$t_start")"
      log_card_end "SKIPPED" "Requires active sudo for package cache" "$dur"
      record_result "clean-dnf" "CLEAN" "SKIPPED" "Needs sudo" "$dur"
    fi
  fi

  # 32. Stale Crashpad Dumps
  if should_run "clean-dumps" "clean"; then
    log_card_start "Stale Crash Dumps & Minidumps" "clean"
    t_start="$(now_ns)"
    log_step "Scanning for *.dmp crash dumps older than 7 days..."
    declare -a dump_dirs=()
    if [[ $IS_WINDOWS -eq 1 ]]; then
      dump_dirs=(
        "${LOCALAPPDATA_DIR}/CrashDumps"
        "${HOME}/.zcode/v2/crash"
        "${HOME}/.gemini/antigravity-cli/crashes"
      )
      for _d in "${LOCALAPPDATA_DIR}"/*/Crashpad "${APPDATA_DIR}"/*/Crashpad; do
        [[ -d "$_d" ]] && dump_dirs+=("$_d")
      done
    else
      dump_dirs=("$HOME/.config" "$HOME/.cache")
    fi

    if [[ $DRY_RUN -eq 1 ]]; then
      read -r dmp_count dmp_sz <<< "$(scan_or_prune_old_files scan "*.dmp" 7 "${dump_dirs[@]}")"
      dur="$(elapsed_since "$t_start")"
      if [[ "${dmp_count:-0}" -gt 0 ]]; then
        log_card_end "UPDATE AVAIL" "${dmp_count} stale (>7d) dump(s) (${dmp_sz})" "$dur"
        record_result "clean-dumps" "CLEAN" "UPDATE AVAIL" "${dmp_count} (${dmp_sz})" "$dur"
      else
        log_card_end "UP TO DATE" "0 stale crash dumps (>7d)" "$dur"
        record_result "clean-dumps" "CLEAN" "UP TO DATE" "0 stale dumps" "$dur"
      fi
    else
      read -r dmp_count dmp_sz <<< "$(scan_or_prune_old_files prune "*.dmp" 7 "${dump_dirs[@]}")"
      dur="$(elapsed_since "$t_start")"
      if [[ "${dmp_count:-0}" -gt 0 ]]; then
        log_card_end "CLEANED" "Pruned ${dmp_count} stale crash dump(s) (${dmp_sz})" "$dur"
        record_result "clean-dumps" "CLEAN" "CLEANED" "${dmp_count} purged" "$dur"
      else
        log_card_end "UP TO DATE" "0 stale crash dumps (>7d)" "$dur"
        record_result "clean-dumps" "CLEAN" "UP TO DATE" "0 stale dumps" "$dur"
      fi
    fi
  fi
fi

# ==============================================================================
# SUMMARY & OUTPUT
# ==============================================================================
count_updated=0
count_uptodate=0
count_avail=0
count_cached=0
count_cleaned=0
count_skipped=0
count_failed=0

for s in "${REPORT_STATUS[@]:-}"; do
  [[ -z "$s" ]] && continue
  case "$s" in
    UPDATED)           ((count_updated++)) || true ;;
    CACHED)            ((count_cached++)) || true ;;
    CLEANED|DEBLOATED) ((count_cleaned++)) || true ;;
    "UP TO DATE")      ((count_uptodate++)) || true ;;
    "UPDATE AVAIL")    ((count_avail++)) || true ;;
    FAILED)            ((count_failed++)) || true ;;
    *)                 ((count_skipped++)) || true ;;
  esac
done

if [[ "$OUTPUT_FORMAT" == "json" ]]; then
  run_py -c '
import json, sys

sep = "__AIUP_SEP__"
names = sys.argv[6].split(sep) if sys.argv[6] else []
types = sys.argv[7].split(sep) if sys.argv[7] else []
statuses = sys.argv[8].split(sep) if sys.argv[8] else []
details = sys.argv[9].split(sep) if sys.argv[9] else []
durations = sys.argv[10].split(sep) if sys.argv[10] else []

results = []
for n, t, s, d, dur in zip(names, types, statuses, details, durations):
    if n:
        results.append({
            "target": n,
            "scope": t,
            "status": s,
            "details": d,
            "duration": dur,
        })

summary = {
    "version": sys.argv[1],
    "os": sys.argv[2],
    "arch": sys.argv[3],
    "pkg_manager": sys.argv[4],
    "mode": sys.argv[5],
    "counts": {
        "total": len(results),
        "up_to_date": int(sys.argv[11]),
        "updated": int(sys.argv[12]),
        "cleaned": int(sys.argv[13]),
        "cached": int(sys.argv[14]),
        "available": int(sys.argv[15]),
        "skipped": int(sys.argv[16]),
        "failed": int(sys.argv[17]),
    },
    "results": results,
}
print(json.dumps(summary, indent=2))
' \
    "$VERSION" "$HOST_OS" "$ARCH" "$PKG_MGR" "$MODE_LABEL" \
    "$(printf "%s__AIUP_SEP__" "${REPORT_NAMES[@]:-}")" \
    "$(printf "%s__AIUP_SEP__" "${REPORT_TYPES[@]:-}")" \
    "$(printf "%s__AIUP_SEP__" "${REPORT_STATUS[@]:-}")" \
    "$(printf "%s__AIUP_SEP__" "${REPORT_DETAILS[@]:-}")" \
    "$(printf "%s__AIUP_SEP__" "${REPORT_DURATIONS[@]:-}")" \
    "$count_uptodate" "$count_updated" "$count_cleaned" "$count_cached" "$count_avail" "$count_skipped" "$count_failed"
  [[ $count_failed -gt 0 ]] && exit 1
  exit 0
fi

# Text Mode Summary Dashboard
echo -e "${BOLD}${CYAN}╭────────────────────────────────────────────────────────────────────────────────────────╮${RESET}"
echo -e "${BOLD}${CYAN}│${RESET}  ${BOLD}📊 Sync Summary Dashboard${RESET}                                                            ${BOLD}${CYAN}│${RESET}"
echo -e "${BOLD}${CYAN}├─────────────────────┬────────────┬────────────────────┬────────────────────────┬───────┤${RESET}"
printf "${BOLD}${CYAN}│${RESET} %-19s │ %-10s │ %-18s │ %-22s │ %-5s ${BOLD}${CYAN}│${RESET}\n" "Target" "Scope" "Status" "Details" "Time"
echo -e "${BOLD}${CYAN}├─────────────────────┼────────────┼────────────────────┼────────────────────────┼───────┤${RESET}"

for i in "${!REPORT_NAMES[@]}"; do
  name="${REPORT_NAMES[$i]}"
  type="${REPORT_TYPES[$i]}"
  status="${REPORT_STATUS[$i]}"
  detail="${REPORT_DETAILS[$i]}"
  dur="${REPORT_DURATIONS[$i]}"

  case "$status" in
    UPDATED)           status_badge="${GREEN}✔ UPDATED${RESET}";       status_plain="✔ UPDATED" ;;
    CLEANED|DEBLOATED) status_badge="${GREEN}✔ CLEANED${RESET}";       status_plain="✔ CLEANED" ;;
    "UP TO DATE")      status_badge="${GREEN}✔ UP-TO-DATE${RESET}";    status_plain="✔ UP-TO-DATE" ;;
    "UPDATE AVAIL")    status_badge="${YELLOW}★ AVAILABLE${RESET}";    status_plain="★ AVAILABLE" ;;
    "DIRTY (SKIPPED)") status_badge="${YELLOW}▲ DIRTY TREE${RESET}";   status_plain="▲ DIRTY TREE" ;;
    CACHED)            status_badge="${CYAN}⇣ CACHED${RESET}";         status_plain="⇣ CACHED" ;;
    FAILED)            status_badge="${RED}✖ FAILED${RESET}";          status_plain="✖ FAILED" ;;
    SKIPPED)           status_badge="${GRAY}⊘ SKIPPED${RESET}";        status_plain="⊘ SKIPPED" ;;
    *)                 status_badge="${CYAN}${status}${RESET}";        status_plain="${status}" ;;
  esac

  type_badge="${CYAN}${type}${RESET}"
  [[ "$type" == "DESKTOP" ]] && type_badge="${MAGENTA}${type}${RESET}"
  [[ "$type" == "CLEAN" ]] && type_badge="${BLUE}${type}${RESET}"

  pad_type=$(( 10 - ${#type} ))
  pad_status=$(( 18 - ${#status_plain} ))
  [[ $pad_type -lt 0 ]] && pad_type=0
  [[ $pad_status -lt 0 ]] && pad_status=0

  printf "${BOLD}${CYAN}│${RESET} %-19s │ %b%*s │ %b%*s │ %-22s │ %-5s ${BOLD}${CYAN}│${RESET}\n" \
    "${name:0:19}" \
    "$type_badge" "$pad_type" "" \
    "$status_badge" "$pad_status" "" \
    "${detail:0:22}" "$dur"
done

echo -e "${BOLD}${CYAN}╰─────────────────────┴────────────┴────────────────────┴────────────────────────┴───────╯${RESET}"
summary_footer="  ${BOLD}Total:${RESET} ${#REPORT_NAMES[@]} items  │  ${GREEN}${count_uptodate} up-to-date${RESET}  │  ${GREEN}${count_updated} updated${RESET}"
[[ $count_cleaned -gt 0 ]] && summary_footer+="  │  ${BLUE}${count_cleaned} cleaned${RESET}"
[[ $count_cached -gt 0 ]] && summary_footer+="  │  ${CYAN}${count_cached} cached${RESET}"
[[ $count_avail -gt 0 ]] && summary_footer+="  │  ${YELLOW}${count_avail} available${RESET}"
[[ $count_skipped -gt 0 ]] && summary_footer+="  │  ${GRAY}${count_skipped} skipped${RESET}"
[[ $count_failed -gt 0 ]] && summary_footer+="  │  ${RED}${count_failed} failed${RESET}"
echo -e "${summary_footer}\n"

# Desktop Notification (if in active GUI session)
if [[ $IS_LINUX -eq 1 ]] && command -v notify-send &>/dev/null && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
  notify_msg="${count_uptodate} Up-to-date, ${count_updated} Updated"
  [[ $count_cleaned -gt 0 ]] && notify_msg+=", ${count_cleaned} Cleaned"
  [[ $count_avail -gt 0 ]] && notify_msg+=", ${count_avail} Available"
  [[ $count_failed -gt 0 ]] && notify_msg+=", ${count_failed} Failed"
  notify-send -a "aiup" -i "dialog-information" "⚡ AIUP Sync Finished" "$notify_msg" 2>/dev/null || true
elif [[ $IS_MACOS -eq 1 ]]; then
  osascript -e "display notification \"${count_uptodate} Up-to-date, ${count_updated} Updated, ${count_cleaned} Cleaned\" with title \"⚡ AIUP Sync Finished\"" 2>/dev/null || true
elif [[ $IS_WINDOWS -eq 1 && -t 1 && "$MODE_LABEL" == "update" ]] && [[ "${CI:-}" != "true" && "${AIUP_NONINTERACTIVE:-}" != "1" ]]; then
  win_msg="${count_uptodate} Up-to-date, ${count_updated} Updated"
  [[ $count_cleaned -gt 0 ]] && win_msg+=", ${count_cleaned} Cleaned"
  [[ $count_avail -gt 0 ]] && win_msg+=", ${count_avail} Available"
  [[ $count_failed -gt 0 ]] && win_msg+=", ${count_failed} Failed"
  powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -Command "
    try {
      [Windows.UI.Notifications.ToastNotificationManager, Windows.UI.Notifications, ContentType=WindowsRuntime] > \$null
      \$xml = [Windows.UI.Notifications.ToastNotificationManager]::GetTemplateContent([Windows.UI.Notifications.ToastTemplateType]::ToastText02)
      \$nodes = \$xml.GetElementsByTagName('text')
      \$nodes[0].AppendChild(\$xml.CreateTextNode('AIUP Sync Finished')) > \$null
      \$nodes[1].AppendChild(\$xml.CreateTextNode('$win_msg')) > \$null
      \$toast = [Windows.UI.Notifications.ToastNotification]::new(\$xml)
      [Windows.UI.Notifications.ToastNotificationManager]::CreateToastNotifier('Microsoft.WindowsTerminal_8wekyb3d8bbwe!App').Show(\$toast)
    } catch {}
  " </dev/null >/dev/null 2>&1 || true
fi

[[ $count_failed -gt 0 ]] && exit 1
exit 0
