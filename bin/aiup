  printf "  │ %-24s │ %-26s │ %-14s │\n" "OpenCode CLI" "opencode" "${v_opencode:0:14}"
  printf "  │ %-24s │ %-26s │ %-14s │\n" "Xiaomi Mimocode" "mimo" "${v_mimo:0:14}"
  printf "  │ %-24s │ %-26s │ %-14s │\n" "Kilo Agent" "kilo" "${v_kilo:0:14}"
