#!/usr/bin/env bash
# ==============================================================================
# aiup - The Universal AI Harness & Desktop App Updater
# Repository: https://github.com/Nan0pk/aiup
# License: MIT
#
# Supported Categories:
#   ◈ CLI Harnesses & Agents:
#     - agy                  (Google Antigravity CLI)
#     - claude               (Anthropic Claude Code CLI)
#     - codex                (OpenAI Codex CLI)
#     - hermes               (NousResearch Hermes Agent)
#     - opencode             (OpenCode CLI)
#     - mimo                 (Xiaomi Mimocode CLI)
#     - kilo                 (Kilo Agent / CLI)
#     - goose                (Block Goose CLI)
#     - uv-tools             (Python uv managed tools, e.g. mistral-vibe)
#     - npm-globals          (command-code, @qwen-code/qwen-code, cline)
#
#   ❖ Desktop AI Apps & Workspaces:
#     - chatgpt              (ChatGPT Desktop App - DNF / APT / DMG / RPM)
#     - opencode-desktop     (OpenCode Desktop App - RPM / AppImage / DMG)
#     - aionui               (AionUi AI Workspace Desktop)
#     - antigravity-desktop  (Google Antigravity IDE)
#     - cowork-os            (CoWork-OS Desktop & Local Repository)
#     - orkas                (Orkas Desktop Multi-Agent Client)
#     - hermes-desktop       (Hermes Desktop UI)
# ==============================================================================

set -uo pipefail

VERSION="1.0.0"

# Detect Operating System
OS="$(uname -s)"
case "$OS" in
  Linux*)  IS_LINUX=1; IS_MACOS=0 ;;
  Darwin*) IS_LINUX=0; IS_MACOS=1 ;;
  *)       IS_LINUX=0; IS_MACOS=0 ;;
esac

# Detect Linux Package Manager
PKG_MGR="unknown"
if [[ $IS_LINUX -eq 1 ]]; then
  if command -v dnf &>/dev/null; then
    PKG_MGR="dnf"
  elif command -v apt-get &>/dev/null; then
    PKG_MGR="apt"
  elif command -v pacman &>/dev/null; then
    PKG_MGR="pacman"
  elif command -v zypper &>/dev/null; then
    PKG_MGR="zypper"
  fi
elif [[ $IS_MACOS -eq 1 ]]; then
  PKG_MGR="brew"
fi

# ANSI Styling
if [[ -t 1 && "${NO_COLOR:-}" != "1" && "${1:-}" != *"--no-color"* ]]; then
  BOLD="\033[1m"
  DIM="\033[2m"
  RED="\033[1;31m"
  GREEN="\033[1;32m"
  YELLOW="\033[1;33m"
  BLUE="\033[1;34m"
  CYAN="\033[1;36m"
  MAGENTA="\033[1;35m"
  GRAY="\033[38;5;244m"
  LIGHT_GRAY="\033[38;5;250m"
  RESET="\033[0m"
else
  BOLD=""
  DIM=""
  RED=""
  GREEN=""
  YELLOW=""
  BLUE=""
  CYAN=""
  MAGENTA=""
  GRAY=""
  LIGHT_GRAY=""
  RESET=""
fi

# Track results
declare -a REPORT_NAMES=()
declare -a REPORT_TYPES=()
declare -a REPORT_STATUS=()
declare -a REPORT_DETAILS=()
declare -a REPORT_DURATIONS=()

MODE="update"     # "update", "check", "list", "clean"
FILTER_TYPE="all" # "all", "cli", "desktop", "clean"
OUTPUT_FORMAT="text" # "text", "json"
FORCE_GIT=0
FORCE_PREAUTH=0
NO_SUDO=0
DO_CLEANUP=1
SUDO_KEEP_ALIVE_PID=""
declare -a ONLY_TARGETS=()
declare -a SKIP_TARGETS=()

usage() {
  echo -e "${BOLD}${CYAN}╭──────────────────────────────────────────────────────────────╮${RESET}"
  echo -e "${BOLD}${CYAN}│${RESET}  ${BOLD}⚡ AIUP${RESET} — Universal AI Harness & Desktop App Updater     ${BOLD}${CYAN}│${RESET}"
  echo -e "${BOLD}${CYAN}│${RESET}  ${DIM}Version ${VERSION}  •  https://github.com/Nan0pk/aiup${RESET}           ${BOLD}${CYAN}│${RESET}"
  echo -e "${BOLD}${CYAN}╰──────────────────────────────────────────────────────────────╯${RESET}"
  echo ""
  echo -e "${BOLD}USAGE:${RESET}"
  echo "    aiup [OPTIONS]"
  echo "    uai  [OPTIONS]"
  echo ""
  echo -e "${BOLD}OPTIONS:${RESET}"
  echo -e "    ${CYAN}-h, --help${RESET}            Show this documentation"
  echo -e "    ${CYAN}-v, --version${RESET}         Show version number"
  echo -e "    ${CYAN}-l, --list${RESET}            List all detected CLI and Desktop AI apps & versions"
  echo -e "    ${CYAN}-c, --check${RESET}           Dry-run check for available updates without applying"
  echo -e "    ${CYAN}-C, --clean${RESET}           Perform housekeeping, cache purge & system debloat only"
  echo -e "    ${CYAN}--no-clean${RESET}            Skip post-update housekeeping and cache debloat"
  echo -e "    ${CYAN}-S, --sudo${RESET}            Pre-authenticate sudo upfront at startup for unattended sync"
  echo -e "    ${CYAN}--no-sudo${RESET}             Disable all sudo prompts (skip or cache privileged updates)"
  echo -e "    ${CYAN}--cli${RESET}                 Only target CLI harnesses and agent runtimes"
  echo -e "    ${CYAN}--desktop${RESET}             Only target Desktop AI apps and UI workspaces"
  echo -e "    ${CYAN}-o, --only <names>${RESET}    Only update specified targets (comma-separated)"
  echo -e "    ${CYAN}-s, --skip <names>${RESET}    Skip specified targets (comma-separated)"
  echo -e "    ${CYAN}--json${RESET}                Output results in JSON format"
  echo -e "    ${CYAN}--force-git${RESET}           Stash and update git repos even if tree is dirty"
  echo -e "    ${CYAN}--no-color${RESET}            Disable colored terminal output"
  echo ""
  echo -e "${BOLD}SUPPORTED TARGETS:${RESET}"
  echo -e "  ${CYAN}◈ CLI Engines:${RESET}     agy, claude, codex, hermes, opencode, mimo, kilo, goose, uv-tools, npm-globals"
  echo -e "  ${MAGENTA}❖ Desktop Apps:${RESET}    chatgpt, opencode-desktop, aionui, antigravity-desktop, cowork-os, orkas, hermes-desktop"
  echo -e "  ${BLUE}🧹 Housekeeping:${RESET}   clean-uv, clean-npm, clean-pip, clean-installers, clean-git, clean-electron, clean-dnf, clean-dumps"
  echo ""
  echo -e "${BOLD}EXAMPLES:${RESET}"
  echo "    aiup                    # Update everything with live progress & debloat afterwards"
  echo "    aiup -l                 # Sleek dashboard of all installed versions"
  echo "    aiup -c                 # Check update availability without touching files"
  echo "    aiup -C                 # Run cache debloat & housekeeping only (skip updates)"
  echo "    aiup -S                 # Pre-authenticate sudo at start for uninterrupted batch"
  echo "    aiup --no-clean         # Fast update only, skipping housekeeping"
  echo "    aiup --desktop          # Update only desktop AI applications"
  echo "    aiup -o chatgpt,claude  # Target specific apps"
  echo "    aiup -c --json          # Output results as JSON for automations"
  exit 0
}

# Parse Arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      ;;
    -v|--version)
      echo "aiup version ${VERSION} (${OS})"
      exit 0
      ;;
    -l|--list)
      MODE="list"
      shift
      ;;
    -c|--check)
      MODE="check"
      shift
      ;;
    -C|--clean|--debloat)
      MODE="clean"
      FILTER_TYPE="clean"
      DO_CLEANUP=1
      shift
      ;;
    --no-clean|--skip-clean|--skip-cleanup)
      DO_CLEANUP=0
      shift
      ;;
    -S|--sudo)
      FORCE_PREAUTH=1
      shift
      ;;
    --no-sudo)
      NO_SUDO=1
      shift
      ;;
    --cli)
      FILTER_TYPE="cli"
      shift
      ;;
    --desktop)
      FILTER_TYPE="desktop"
      shift
      ;;
    --json)
      OUTPUT_FORMAT="json"
      shift
      ;;
    --force-git)
      FORCE_GIT=1
      shift
      ;;
    --no-color)
      BOLD=""; DIM=""; RED=""; GREEN=""; YELLOW=""; BLUE=""; CYAN=""; MAGENTA=""
      GRAY=""; LIGHT_GRAY=""; RESET=""
      shift
      ;;
    -o|--only)
      IFS=',' read -r -a targets <<< "$2"
      for t in "${targets[@]}"; do
        ONLY_TARGETS+=("$(echo "$t" | tr '[:upper:]' '[:lower:]' | xargs)")
      done
      shift 2
      ;;
    -s|--skip)
      IFS=',' read -r -a targets <<< "$2"
      for t in "${targets[@]}"; do
        SKIP_TARGETS+=("$(echo "$t" | tr '[:upper:]' '[:lower:]' | xargs)")
      done
      shift 2
      ;;
    *)
      echo -e "${RED}[ERROR]${RESET} Unknown option: $1" >&2
      usage
      ;;
  esac
done

should_run() {
  local name="$1"
  local type="$2" # "cli", "desktop", or "clean"
  local lower_name
  lower_name="$(echo "$name" | tr '[:upper:]' '[:lower:]')"

  if [[ "$FILTER_TYPE" == "cli" && "$type" != "cli" ]]; then
    return 1
  fi
  if [[ "$FILTER_TYPE" == "desktop" && "$type" != "desktop" ]]; then
    return 1
  fi
  if [[ "$FILTER_TYPE" == "clean" && "$type" != "clean" ]]; then
    return 1
  fi
  if [[ "$FILTER_TYPE" == "all" && "$type" == "clean" && $DO_CLEANUP -eq 0 ]]; then
    return 1
  fi

  for s in "${SKIP_TARGETS[@]:-}"; do
    if [[ "$lower_name" == "$s" ]]; then
      return 1
    fi
  done

  if [[ ${#ONLY_TARGETS[@]} -gt 0 ]]; then
    for o in "${ONLY_TARGETS[@]}"; do
      if [[ "$lower_name" == "$o" ]]; then
        return 0
      fi
    done
    return 1
  fi

  return 0
}

record_result() {
  local name="$1"
  local type="$2"
  local status="$3"
  local detail="$4"
  local duration="$5"

  REPORT_NAMES+=("$name")
  REPORT_TYPES+=("$type")
  REPORT_STATUS+=("$status")
  REPORT_DETAILS+=("$detail")
  REPORT_DURATIONS+=("$duration")
}

log_card_start() {
  [[ "$OUTPUT_FORMAT" == "json" ]] && return
  local title="$1"
  local type="$2"
  if [[ "$type" == "cli" ]]; then
    echo -e "${BOLD}${CYAN}┌── ◈ [CLI] ${title}${RESET}"
  elif [[ "$type" == "clean" || "$type" == "clean"* ]]; then
    echo -e "${BOLD}${BLUE}┌── 🧹 [CLEANUP] ${title}${RESET}"
  else
    echo -e "${BOLD}${MAGENTA}┌── ❖ [DESKTOP] ${title}${RESET}"
  fi
}

log_step() {
  [[ "$OUTPUT_FORMAT" == "json" ]] && return
  local msg="$1"
  echo -e "  ${DIM}│${RESET}   ${GRAY}↳${RESET} ${LIGHT_GRAY}${msg}${RESET}"
}

log_card_end() {
  [[ "$OUTPUT_FORMAT" == "json" ]] && return
  local status="$1"
  local detail="$2"
  local dur="$3"
  local badge=""

  case "$status" in
    UPDATED)
      badge="${GREEN}✔ [UPDATED]${RESET}"
      ;;
    CLEANED|DEBLOATED)
      badge="${GREEN}✔ [CLEANED]${RESET}"
      ;;
    "UP TO DATE")
      badge="${GREEN}✔ [UP-TO-DATE]${RESET}"
      ;;
    "UPDATE AVAIL")
      badge="${YELLOW}★ [UPDATE AVAILABLE]${RESET}"
      ;;
    "DIRTY (SKIPPED)")
      badge="${YELLOW}▲ [DIRTY TREE]${RESET}"
      ;;
    CACHED)
      badge="${CYAN}⇣ [CACHED]${RESET}"
      ;;
    SKIPPED)
      badge="${GRAY}⊘ [SKIPPED]${RESET}"
      ;;
    *)
      badge="${CYAN}• [${status}]${RESET}"
      ;;
  esac

  echo -e "  ${DIM}└──${RESET} ${badge} ${detail} ${GRAY}[${dur}]${RESET}\n"
}

stream_progress() {
  [[ "$OUTPUT_FORMAT" == "json" ]] && cat >/dev/null && return
  local max_lines="${1:-6}"
  local count=0
  while IFS= read -r line; do
    line=$(echo "$line" | tr -d '\r' | sed -E "s/\x1B\[[0-9;]*[a-zA-Z]//g" | xargs 2>/dev/null)
    [[ -z "$line" ]] && continue
    if [[ "$line" =~ ^[[:space:]]*[═─━_=-]{3,} ]] || [[ "$line" =~ ^[█░▒◒◐◓◑]+$ ]]; then
      continue
    fi
    if [[ ${#line} -gt 74 ]]; then
      line="${line:0:71}..."
    fi
    echo -e "  ${DIM}│${RESET}   ${GRAY}↳${RESET} ${DIM}${line}${RESET}"
    ((count++))
    if [[ $count -ge $max_lines ]]; then
      break
    fi
  done
}

keep_sudo_alive() {
  if [[ -z "${SUDO_KEEP_ALIVE_PID:-}" ]]; then
    while true; do
      sudo -n true 2>/dev/null || exit 0
      sleep 50
    done 2>/dev/null &
    SUDO_KEEP_ALIVE_PID=$!
    trap '[[ -n "${SUDO_KEEP_ALIVE_PID:-}" ]] && kill "$SUDO_KEEP_ALIVE_PID" 2>/dev/null || true' EXIT
  fi
}

run_privileged() {
  local prompt_desc="${1:-system update}"
  shift || true

  # 1. Non-interactive or already authenticated sudo session
  if sudo -n true 2>/dev/null; then
    keep_sudo_alive
    sudo "$@"
    return $?
  fi

  # Skip interactive prompts if explicitly marked non-interactive or --no-sudo
  if [[ $NO_SUDO -eq 1 || "${CI:-}" == "true" || "${DEBIAN_FRONTEND:-}" == "noninteractive" || "${AIUP_NONINTERACTIVE:-}" == "1" ]]; then
    return 2
  fi

  # 2. Interactive terminal (stdin is a TTY)
  if [[ -t 0 ]]; then
    log_step "Administrator privileges required for ${prompt_desc}"
    if sudo -v </dev/tty >/dev/tty 2>&1; then
      keep_sudo_alive
      sudo "$@"
      return $?
    fi
    return 1
  fi

  # 3. Graphical desktop session with Polkit pkexec
  if [[ (-n "${DISPLAY:-}" || -n "${WAYLAND_DISPLAY:-}") ]] && command -v pkexec &>/dev/null; then
    log_step "Requesting desktop authorization via pkexec (${prompt_desc})..."
    pkexec "$@"
    return $?
  fi

  return 2
}

preauth_sudo_if_safe() {
  # Never in check or list mode
  [[ "$MODE" != "update" ]] && return 0

  # Never if user explicitly disabled sudo
  [[ $NO_SUDO -eq 1 ]] && return 0

  # Never in automated/CI runs unless forced
  if [[ $FORCE_PREAUTH -eq 0 ]]; then
    [[ "${CI:-}" == "true" || "${DEBIAN_FRONTEND:-}" == "noninteractive" || "${AIUP_NONINTERACTIVE:-}" == "1" ]] && return 0
  fi

  # Only if running interactively in a terminal
  [[ ! -t 0 ]] && return 0

  # Check if privileged targets are included in this run
  local has_privileged=0
  if (rpm -q chatgpt &>/dev/null || [[ -d "/Applications/ChatGPT.app" ]]) && should_run "chatgpt" "desktop"; then
    has_privileged=1
  fi
  if (rpm -q opencode &>/dev/null || [[ -d "/opt/OpenCode" ]]) && should_run "opencode-desktop" "desktop"; then
    has_privileged=1
  fi

  # If not forced with -S/--sudo, only pre-auth if privileged apps are queued
  if [[ $FORCE_PREAUTH -eq 0 && $has_privileged -eq 0 ]]; then
    return 0
  fi

  # If sudo is already cached/active, keep it warm and return
  if sudo -n true 2>/dev/null; then
    keep_sudo_alive
    return 0
  fi

  # Safe interactive startup pre-auth
  if [[ "$OUTPUT_FORMAT" != "json" ]]; then
    echo -e "${DIM}┌──${RESET} ${BOLD}${CYAN}🔒 Administrator Privileges (sudo)${RESET}"
    echo -e "  ${DIM}│${RESET}   ${GRAY}↳${RESET} ${LIGHT_GRAY}Privileged system targets included in sync${RESET}"
    echo -e "  ${DIM}│${RESET}   ${GRAY}↳${RESET} ${LIGHT_GRAY}Authenticating upfront for seamless unattended run...${RESET}"
  fi

  if sudo -v </dev/tty >/dev/tty 2>&1; then
    keep_sudo_alive
    if [[ "$OUTPUT_FORMAT" != "json" ]]; then
      echo -e "  ${DIM}└──${RESET} ${GREEN}✔ Sudo session established (active keep-alive)${RESET}\n"
    fi
    return 0
  else
    if [[ "$OUTPUT_FORMAT" != "json" ]]; then
      echo -e "  ${DIM}└──${RESET} ${YELLOW}⚠ Sudo pre-auth skipped — will request when needed${RESET}\n"
    fi
    return 1
  fi
}

get_asar_version() {
  local asar_path="$1"
  if [[ ! -f "$asar_path" ]]; then
    echo "unknown"
    return
  fi
  python3 -c "
import struct, json, sys
try:
    with open(sys.argv[1], 'rb') as f:
        f.seek(4)
        total_header_size = struct.unpack('<I', f.read(4))[0]
        base = 8 + total_header_size
        f.seek(12)
        l = struct.unpack('<I', f.read(4))[0]
        h = json.loads(f.read(l).decode('utf-8'))
        off = int(h['files']['package.json']['offset'])
        sz = int(h['files']['package.json']['size'])
        f.seek(base + off)
        p = json.loads(f.read(sz).decode('utf-8'))
        print(p.get('version', 'unknown'))
except Exception:
    print('unknown')
" "$asar_path" 2>/dev/null || echo "unknown"
}

get_npm_pkg_version() {
  local pkg="$1"
  local node_root="${HOME}/.local/node/lib/node_modules"
  if [[ ! -d "$node_root" ]] && command -v npm &>/dev/null; then
    node_root="$(npm root -g 2>/dev/null || echo '')"
  fi
  if [[ -f "${node_root}/${pkg}/package.json" ]]; then
    jq -r '.version // "unknown"' "${node_root}/${pkg}/package.json" 2>/dev/null
  else
    echo ""
  fi
}

get_version() {
  local tool="$1"
  case "$tool" in
    agy)
      command -v agy &>/dev/null && agy --version 2>&1 | head -n 1 | awk '{print $1}' || echo "not installed"
      ;;
    claude)
      command -v claude &>/dev/null && claude --version 2>&1 | head -n 1 || echo "not installed"
      ;;
    codex)
      command -v codex &>/dev/null && codex --version 2>&1 | head -n 1 | awk '{print $2}' || echo "not installed"
      ;;
    hermes)
      command -v hermes &>/dev/null && (hermes --version 2>&1 | head -n 1 | grep -oE 'v[0-9.]+' || echo "installed") || echo "not installed"
      ;;
    opencode)
      command -v opencode &>/dev/null && opencode --version 2>&1 | head -n 1 | awk '{print $2}' || echo "not installed"
      ;;
    mimo)
      command -v mimo &>/dev/null && mimo --version 2>&1 | head -n 1 || echo "not installed"
      ;;
    kilo)
      command -v kilo &>/dev/null && kilo --version 2>&1 | head -n 1 || echo "not installed"
      ;;
    goose)
      command -v goose &>/dev/null && goose --version 2>&1 | head -n 1 | xargs || echo "not installed"
      ;;
    chatgpt)
      if command -v rpm &>/dev/null && rpm -q chatgpt &>/dev/null; then
        rpm -q --qf '%{VERSION}\n' chatgpt 2>/dev/null
      elif [[ $IS_MACOS -eq 1 && -d "/Applications/ChatGPT.app" ]]; then
        defaults read /Applications/ChatGPT.app/Contents/Info.plist CFBundleShortVersionString 2>/dev/null || echo "installed"
      else
        echo "not installed"
      fi
      ;;
    opencode-desktop)
      if command -v rpm &>/dev/null && rpm -q opencode &>/dev/null; then
        rpm -q --qf '%{VERSION}\n' opencode 2>/dev/null
      else
        echo "not installed"
      fi
      ;;
    aionui)
      [[ -f "$HOME/.local/opt/AionUi/resources/app.asar" ]] && get_asar_version "$HOME/.local/opt/AionUi/resources/app.asar" || echo "not installed"
      ;;
    antigravity-desktop)
      [[ -f "$HOME/.local/share/antigravity/resources/app.asar" ]] && get_asar_version "$HOME/.local/share/antigravity/resources/app.asar" || echo "not installed"
      ;;
    cowork-os)
      if [[ -d "$HOME/CoWork-OS/.git" ]]; then
        local hash
        hash=$(git -C "$HOME/CoWork-OS" rev-parse --short HEAD 2>/dev/null || echo "git")
        local pkg_ver
        pkg_ver=$(jq -r '.version // "unknown"' "$HOME/CoWork-OS/package.json" 2>/dev/null || echo "dev")
        echo "v${pkg_ver} (${hash})"
      else
        echo "not found"
      fi
      ;;
    orkas)
      if [[ -d "$HOME/Orkas/.git" ]]; then
        local hash
        hash=$(git -C "$HOME/Orkas" rev-parse --short HEAD 2>/dev/null || echo "git")
        local pkg_ver
        pkg_ver=$(jq -r '.version // "unknown"' "$HOME/Orkas/package.json" 2>/dev/null || echo "dev")
        echo "v${pkg_ver} (${hash})"
      else
        echo "not found"
      fi
      ;;
    hermes-desktop)
      command -v hermes &>/dev/null && echo "Ready" || echo "not installed"
      ;;
    uv-tools)
      command -v uv &>/dev/null && (uv tool list 2>/dev/null | tr '\n' ', ' | sed 's/,$//') || echo "none"
      ;;
    npm-globals)
      local items=""
      for p in "command-code" "@qwen-code/qwen-code" "cline"; do
        local v
        v=$(get_npm_pkg_version "$p")
        if [[ -n "$v" ]]; then
          items+="${p##*/}@${v} "
        fi
      done
      echo "${items:-none}"
      ;;
    *)
      echo "unknown"
      ;;
  esac
}

list_harnesses() {
  if [[ "$OUTPUT_FORMAT" == "json" ]]; then
    python3 -c "
import json
data = {
  'os': '${OS}',
  'pkg_manager': '${PKG_MGR}',
  'cli_harnesses': {
    'agy': '$(get_version agy)',
    'claude': '$(get_version claude)',
    'codex': '$(get_version codex)',
    'hermes': '$(get_version hermes)',
    'opencode': '$(get_version opencode)',
    'mimo': '$(get_version mimo)',
    'kilo': '$(get_version kilo)',
    'goose': '$(get_version goose)',
    'uv_tools': '$(get_version uv-tools)',
    'npm_globals': '$(get_version npm-globals)'
  },
  'desktop_apps': {
    'chatgpt': '$(get_version chatgpt)',
    'opencode_desktop': '$(get_version opencode-desktop)',
    'aionui': '$(get_version aionui)',
    'antigravity_desktop': '$(get_version antigravity-desktop)',
    'cowork_os': '$(get_version cowork-os)',
    'orkas': '$(get_version orkas)',
    'hermes_desktop': '$(get_version hermes-desktop)'
  }
}
print(json.dumps(data, indent=2))
"
    exit 0
  fi

  echo -e "${BOLD}${CYAN}╭────────────────────────────────────────────────────────────────────╮${RESET}"
  echo -e "${BOLD}${CYAN}│${RESET}  ${BOLD}⚡ AIUP Installed Inventory${RESET}                                       ${BOLD}${CYAN}│${RESET}"
  echo -e "${BOLD}${CYAN}╰────────────────────────────────────────────────────────────────────╯${RESET}"
  echo ""
  echo -e "  ${BOLD}${CYAN}◈ CLI HARNESSES & AGENT RUNTIMES${RESET}"
  echo -e "  ╭──────────────────────────┬────────────────────────────┬──────────────╮"
  echo -e "  │ Target                   │ Engine / Command           │ Version      │"
  echo -e "  ├──────────────────────────┼────────────────────────────┼──────────────┤"
  printf "  │ %-24s │ %-26s │ %-12s │\n" "Google Antigravity" "agy" "$(get_version agy)"
  printf "  │ %-24s │ %-26s │ %-12s │\n" "Claude Code" "claude" "$(get_version claude | awk '{print $1}')"
  printf "  │ %-24s │ %-26s │ %-12s │\n" "OpenAI Codex" "codex" "$(get_version codex)"
  printf "  │ %-24s │ %-26s │ %-12s │\n" "Hermes Agent" "hermes" "$(get_version hermes)"
  printf "  │ %-24s │ %-26s │ %-12s │\n" "OpenCode CLI" "opencode" "$(get_version opencode)"
  printf "  │ %-24s │ %-26s │ %-12s │\n" "Xiaomi Mimocode" "mimo" "$(get_version mimo)"
  printf "  │ %-24s │ %-26s │ %-12s │\n" "Kilo Agent" "kilo" "$(get_version kilo)"
  printf "  │ %-24s │ %-26s │ %-12s │\n" "Goose CLI" "goose" "$(get_version goose)"
  printf "  │ %-24s │ %-26s │ %-12s │\n" "Python uv Tools" "uv tool" "mistral-vibe"
  printf "  │ %-24s │ %-26s │ %-12s │\n" "NPM AI Globals" "npm (global)" "3 packages"
  echo -e "  ╰──────────────────────────┴────────────────────────────┴──────────────╯"
  echo ""
  echo -e "  ${BOLD}${MAGENTA}❖ DESKTOP AI APPS & WORKSPACES${RESET}"
  echo -e "  ╭──────────────────────────┬────────────────────────────┬──────────────╮"
  echo -e "  │ Application              │ Binary / Environment       │ Version      │"
  echo -e "  ├──────────────────────────┼────────────────────────────┼──────────────┤"
  printf "  │ %-24s │ %-26s │ %-12s │\n" "ChatGPT Desktop" "RPM (/usr/bin/chatgpt)" "$(get_version chatgpt)"
  printf "  │ %-24s │ %-26s │ %-12s │\n" "OpenCode Desktop" "RPM (/opt/OpenCode)" "$(get_version opencode-desktop)"
  printf "  │ %-24s │ %-26s │ %-12s │\n" "AionUi Workspace" "Electron (~/.local/opt)" "$(get_version aionui)"
  printf "  │ %-24s │ %-26s │ %-12s │\n" "Antigravity IDE" "IDE (~/.local/share)" "$(get_version antigravity-desktop)"
  printf "  │ %-24s │ %-26s │ %-12s │\n" "CoWork-OS Desktop" "Electron (~/CoWork-OS)" "$(get_version cowork-os | awk '{print $1}')"
  printf "  │ %-24s │ %-26s │ %-12s │\n" "Orkas Desktop Client" "Electron (~/Orkas)" "$(get_version orkas | awk '{print $1}')"
  printf "  │ %-24s │ %-26s │ %-12s │\n" "Hermes Desktop UI" "UI (hermes desktop)" "Ready"
  echo -e "  ╰──────────────────────────┴────────────────────────────┴──────────────╯"
  echo ""
  exit 0
}

if [[ "$MODE" == "list" ]]; then
  list_harnesses
fi

if [[ "$OUTPUT_FORMAT" != "json" ]]; then
  echo -e "\n${BOLD}${CYAN}╭──────────────────────────────────────────────────────────────╮${RESET}"
  if [[ "$MODE" == "check" ]]; then
    echo -e "${BOLD}${CYAN}│${RESET}  ${YELLOW}🔍 [CHECK MODE] Scanning for AI Harness & App Updates...${RESET}    ${BOLD}${CYAN}│${RESET}"
  elif [[ "$MODE" == "clean" ]]; then
    echo -e "${BOLD}${CYAN}│${RESET}  ${BLUE}🧹 [CLEANUP MODE] Housekeeping & System Debloat...${RESET}           ${BOLD}${CYAN}│${RESET}"
  else
    echo -e "${BOLD}${CYAN}│${RESET}  ${BOLD}🚀 [UPDATE MODE] Syncing All AI Harnesses & Desktop Apps...${RESET} ${BOLD}${CYAN}│${RESET}"
  fi
  echo -e "${BOLD}${CYAN}╰──────────────────────────────────────────────────────────────╯${RESET}\n"
fi

# Pre-authenticate administrator privileges upfront if safe and applicable
preauth_sudo_if_safe

# ==============================================================================
# SECTION 1: CLI HARNESSES & AGENTS
# ==============================================================================
if [[ ("$FILTER_TYPE" == "all" || "$FILTER_TYPE" == "cli") && "$MODE" != "clean" ]]; then
  [[ "$OUTPUT_FORMAT" != "json" ]] && echo -e "${BOLD}${CYAN}◈ [SECTION 1] CLI HARNESSES & CORE AGENTS${RESET}\n"

  # 1. Antigravity CLI (agy)
  if command -v agy &>/dev/null && should_run "agy" "cli"; then
    log_card_start "Antigravity CLI (agy)" "cli"
    t_start=$(date +%s%N)
    log_step "Checking official Google Antigravity release channel..."
    output=$(agy update 2>&1 || true)
    echo "$output" | stream_progress 4
    t_end=$(date +%s%N)
    dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
    if echo "$output" | grep -qi "already on the latest"; then
      log_card_end "UP TO DATE" "Current version is latest" "$dur"
      record_result "agy" "CLI" "UP TO DATE" "Current version latest" "$dur"
    elif echo "$output" | grep -qi "success"; then
      log_card_end "UPDATED" "Updated to newest build" "$dur"
      record_result "agy" "CLI" "UPDATED" "Updated successfully" "$dur"
    else
      log_card_end "UP TO DATE" "Channel verified" "$dur"
      record_result "agy" "CLI" "UP TO DATE" "Channel verified" "$dur"
    fi
  fi

  # 2. Claude Code (claude)
  if command -v claude &>/dev/null && should_run "claude" "cli"; then
    log_card_start "Claude Code (claude)" "cli"
    t_start=$(date +%s%N)
    log_step "Connecting to Anthropic update manifest..."
    output=$(claude update 2>&1 || true)
    echo "$output" | stream_progress 4
    t_end=$(date +%s%N)
    dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
    if echo "$output" | grep -qi "Updated from"; then
      new_v=$(echo "$output" | grep -oE "to version [0-9.]+" | awk '{print $3}')
      log_card_end "UPDATED" "Upgraded to v${new_v}" "$dur"
      record_result "claude" "CLI" "UPDATED" "v${new_v}" "$dur"
    elif echo "$output" | grep -qi "already.*latest"; then
      log_card_end "UP TO DATE" "Already on latest version" "$dur"
      record_result "claude" "CLI" "UP TO DATE" "Already latest" "$dur"
    else
      log_card_end "UP TO DATE" "Manifest verified" "$dur"
      record_result "claude" "CLI" "UP TO DATE" "Verified" "$dur"
    fi
  fi

  # 3. OpenAI Codex (codex)
  if command -v codex &>/dev/null && should_run "codex" "cli"; then
    log_card_start "OpenAI Codex CLI (codex)" "cli"
    t_start=$(date +%s%N)
    log_step "Resolving standalone binary from chatgpt.com..."
    output=$(codex update 2>&1 || true)
    echo "$output" | stream_progress 4
    t_end=$(date +%s%N)
    dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
    v=$(echo "$output" | grep -oE "Codex CLI [0-9.]+" | awk '{print $3}')
    log_card_end "UP TO DATE" "Verified (v${v:-current})" "$dur"
    record_result "codex" "CLI" "UP TO DATE" "v${v:-current}" "$dur"
  fi

  # 4. OpenCode CLI (opencode)
  if command -v opencode &>/dev/null && should_run "opencode" "cli"; then
    log_card_start "OpenCode CLI (opencode)" "cli"
    t_start=$(date +%s%N)
    log_step "Checking upstream OpenCode CLI packages..."
    output=$(opencode upgrade 2>&1 || true)
    echo "$output" | stream_progress 4
    t_end=$(date +%s%N)
    dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
    if echo "$output" | grep -qi "already installed"; then
      log_card_end "UP TO DATE" "Already latest release" "$dur"
      record_result "opencode" "CLI" "UP TO DATE" "Already latest" "$dur"
    elif echo "$output" | grep -qi "Upgrade complete"; then
      log_card_end "UPDATED" "Upgraded to latest" "$dur"
      record_result "opencode" "CLI" "UPDATED" "Upgraded" "$dur"
    else
      log_card_end "UP TO DATE" "Verified" "$dur"
      record_result "opencode" "CLI" "UP TO DATE" "Verified" "$dur"
    fi
  fi

  # 5. Xiaomi Mimocode (mimo)
  if command -v mimo &>/dev/null && should_run "mimo" "cli"; then
    log_card_start "Xiaomi Mimocode (mimo)" "cli"
    t_start=$(date +%s%N)
    log_step "Connecting to Xiaomi Mimocode release endpoint..."
    output=$(mimo upgrade 2>&1 || true)
    echo "$output" | stream_progress 4
    t_end=$(date +%s%N)
    dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
    if echo "$output" | grep -qi "already installed"; then
      log_card_end "UP TO DATE" "Already on latest version" "$dur"
      record_result "mimo" "CLI" "UP TO DATE" "Already latest" "$dur"
    elif echo "$output" | grep -qi "Upgrade complete"; then
      log_card_end "UPDATED" "Upgraded successfully" "$dur"
      record_result "mimo" "CLI" "UPDATED" "Upgraded" "$dur"
    else
      log_card_end "UP TO DATE" "Verified" "$dur"
      record_result "mimo" "CLI" "UP TO DATE" "Verified" "$dur"
    fi
  fi

  # 6. Kilo Agent (kilo)
  if command -v kilo &>/dev/null && should_run "kilo" "cli"; then
    log_card_start "Kilo Agent (kilo)" "cli"
    t_start=$(date +%s%N)
    log_step "Checking Kilo Agent distribution..."
    output=$(kilo upgrade 2>&1 || true)
    echo "$output" | stream_progress 4
    t_end=$(date +%s%N)
    dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
    if echo "$output" | grep -qi "already installed"; then
      log_card_end "UP TO DATE" "Already on latest version" "$dur"
      record_result "kilo" "CLI" "UP TO DATE" "Already latest" "$dur"
    elif echo "$output" | grep -qi "Upgrade complete"; then
      log_card_end "UPDATED" "Upgraded successfully" "$dur"
      record_result "kilo" "CLI" "UPDATED" "Upgraded" "$dur"
    else
      log_card_end "UP TO DATE" "Verified" "$dur"
      record_result "kilo" "CLI" "UP TO DATE" "Verified" "$dur"
    fi
  fi

  # 7. Goose CLI (goose)
  if command -v goose &>/dev/null && should_run "goose" "cli"; then
    log_card_start "Goose CLI (goose)" "cli"
    t_start=$(date +%s%N)
    log_step "Checking Goose CLI latest release..."
    output=$(goose update 2>&1 || true)
    echo "$output" | stream_progress 4
    t_end=$(date +%s%N)
    dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
    if echo "$output" | grep -qi "already on the latest"; then
      log_card_end "UP TO DATE" "Already on latest release" "$dur"
      record_result "goose" "CLI" "UP TO DATE" "Already latest" "$dur"
    elif echo "$output" | grep -qi "successfully"; then
      log_card_end "UPDATED" "Upgraded successfully" "$dur"
      record_result "goose" "CLI" "UPDATED" "Upgraded" "$dur"
    else
      log_card_end "UP TO DATE" "Verified" "$dur"
      record_result "goose" "CLI" "UP TO DATE" "Verified" "$dur"
    fi
  fi

  # 8. Hermes Agent (hermes)
  if command -v hermes &>/dev/null && should_run "hermes" "cli"; then
    log_card_start "Hermes Agent (hermes)" "cli"
    t_start=$(date +%s%N)
    if [[ "$MODE" == "check" ]]; then
      log_step "Probing Hermes Agent git repository..."
      output=$(hermes update --check 2>&1 || true)
      echo "$output" | stream_progress 4
      t_end=$(date +%s%N)
      dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
      if echo "$output" | grep -qi "Update available"; then
        log_card_end "UPDATE AVAIL" "New commits on origin" "$dur"
        record_result "hermes" "CLI" "UPDATE AVAIL" "New commits on origin" "$dur"
      else
        log_card_end "UP TO DATE" "Up to date with origin" "$dur"
        record_result "hermes" "CLI" "UP TO DATE" "Up to date" "$dur"
      fi
    else
      log_step "Updating Hermes dependencies and core engine..."
      output=$(hermes update --yes --no-gateway-restart 2>&1 || true)
      echo "$output" | stream_progress 4
      t_end=$(date +%s%N)
      dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
      if echo "$output" | grep -qi "already up to date"; then
        log_card_end "UP TO DATE" "Already up to date" "$dur"
        record_result "hermes" "CLI" "UP TO DATE" "Up to date" "$dur"
      elif [[ $? -eq 0 ]]; then
        log_card_end "UPDATED" "Dependencies & git synced" "$dur"
        record_result "hermes" "CLI" "UPDATED" "Synced" "$dur"
      else
        log_card_end "UP TO DATE" "Completed with notices" "$dur"
        record_result "hermes" "CLI" "UP TO DATE" "Notices logged" "$dur"
      fi
    fi
  fi

  # 9. Python Tools via uv (mistral-vibe)
  if command -v uv &>/dev/null && should_run "uv-tools" "cli"; then
    log_card_start "Python uv Tools (mistral-vibe, etc.)" "cli"
    t_start=$(date +%s%N)
    log_step "Checking uv tool registry..."
    output=$(uv tool upgrade --all 2>&1 || true)
    echo "$output" | stream_progress 4
    t_end=$(date +%s%N)
    dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
    if echo "$output" | grep -qi "Nothing to upgrade"; then
      log_card_end "UP TO DATE" "All uv tools current" "$dur"
      record_result "uv-tools" "CLI" "UP TO DATE" "Tools current" "$dur"
    elif echo "$output" | grep -qi "Upgraded"; then
      log_card_end "UPDATED" "Upgraded installed tools" "$dur"
      record_result "uv-tools" "CLI" "UPDATED" "Upgraded tools" "$dur"
    else
      log_card_end "UP TO DATE" "Checked" "$dur"
      record_result "uv-tools" "CLI" "UP TO DATE" "Checked" "$dur"
    fi
  fi

  # 10. NPM AI Global Packages
  if command -v npm &>/dev/null && should_run "npm-globals" "cli"; then
    log_card_start "NPM Global AI Packages (command-code, qwen-code, cline)" "cli"
    t_start=$(date +%s%N)
    npm_targets=()
    for pkg in "command-code" "@qwen-code/qwen-code" "cline"; do
      if [[ -n "$(get_npm_pkg_version "$pkg")" ]]; then
        npm_targets+=("${pkg}@latest")
      fi
    done

    if [[ ${#npm_targets[@]} -gt 0 ]]; then
      log_step "Detected packages: ${npm_targets[*]}"
      if [[ "$MODE" == "check" ]]; then
        t_end=$(date +%s%N)
        dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
        log_card_end "UP TO DATE" "${#npm_targets[@]} packages installed" "$dur"
        record_result "npm-globals" "CLI" "UP TO DATE" "${#npm_targets[@]} packages" "$dur"
      else
        for target in "${npm_targets[@]}"; do
          log_step "Installing ${target}..."
          npm install -g "$target" 2>&1 | stream_progress 2 || true
        done
        t_end=$(date +%s%N)
        dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
        log_card_end "UPDATED" "Refreshed ${#npm_targets[@]} packages" "$dur"
        record_result "npm-globals" "CLI" "UPDATED" "Refreshed packages" "$dur"
      fi
    fi
  fi
fi

# ==============================================================================
# SECTION 2: DESKTOP AI APPS & WORKSPACES
# ==============================================================================
if [[ ("$FILTER_TYPE" == "all" || "$FILTER_TYPE" == "desktop") && "$MODE" != "clean" ]]; then
  [[ "$OUTPUT_FORMAT" != "json" ]] && echo -e "${BOLD}${MAGENTA}❖ [SECTION 2] DESKTOP AI APPS & WORKSPACES${RESET}\n"

  # 11. ChatGPT Desktop App
  if (rpm -q chatgpt &>/dev/null || [[ -d "/Applications/ChatGPT.app" ]]) && should_run "chatgpt" "desktop"; then
    log_card_start "ChatGPT Desktop App (chatgpt)" "desktop"
    t_start=$(date +%s%N)
    curr_v="$(get_version chatgpt)"

    if [[ $PKG_MGR == "dnf" ]]; then
      log_step "Checking official DNF repository (https://persistent.oaistatic.com/codex-app-prod)..."
      dnf_out=$(dnf check-update chatgpt 2>&1 || true)
      dnf_rc=$?
      t_end=$(date +%s%N)
      dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")

      if [[ $dnf_rc -eq 100 ]]; then
        avail_v=$(echo "$dnf_out" | grep -i chatgpt | awk '{print $2}' | head -n 1)
        log_step "Found newer version: ${avail_v:-latest} (current: ${curr_v})"
        if [[ "$MODE" == "check" ]]; then
          log_card_end "UPDATE AVAIL" "${curr_v} → ${avail_v:-latest}" "$dur"
          record_result "chatgpt" "DESKTOP" "UPDATE AVAIL" "${avail_v:-latest}" "$dur"
        else
          log_step "Attempting DNF upgrade for ChatGPT Desktop..."
          if run_privileged "ChatGPT Desktop upgrade" dnf upgrade -y chatgpt 2>&1 | stream_progress 4; then
            log_card_end "UPDATED" "Upgraded via DNF" "$dur"
            record_result "chatgpt" "DESKTOP" "UPDATED" "Upgraded" "$dur"
          else
            log_card_end "UPDATE AVAIL" "Run: sudo dnf upgrade -y chatgpt" "$dur"
            record_result "chatgpt" "DESKTOP" "UPDATE AVAIL" "sudo dnf upgrade" "$dur"
          fi
        fi
      else
        log_card_end "UP TO DATE" "Version ${curr_v} is current" "$dur"
        record_result "chatgpt" "DESKTOP" "UP TO DATE" "v${curr_v}" "$dur"
      fi
    else
      t_end=$(date +%s%N)
      dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
      log_card_end "UP TO DATE" "Version ${curr_v} is installed" "$dur"
      record_result "chatgpt" "DESKTOP" "UP TO DATE" "v${curr_v}" "$dur"
    fi
  fi

  # 12. OpenCode Desktop App
  if (rpm -q opencode &>/dev/null || [[ -d "/opt/OpenCode" ]]) && should_run "opencode-desktop" "desktop"; then
    log_card_start "OpenCode Desktop App (opencode-desktop)" "desktop"
    t_start=$(date +%s%N)
    curr_v="$(get_version opencode-desktop)"
    log_step "Inspecting local desktop installation (v${curr_v})..."
    log_step "Querying GitHub releases (anomalyco/opencode)..."
    latest_tag=$(curl -s --connect-timeout 3 https://api.github.com/repos/anomalyco/opencode/releases/latest 2>/dev/null | jq -r '.tag_name // empty' | sed 's/^v//')
    t_end=$(date +%s%N)
    dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")

    if [[ -n "$latest_tag" && "$latest_tag" != "$curr_v" ]]; then
      log_step "Found new release: v${latest_tag} (local: v${curr_v})"
      if [[ "$MODE" == "check" ]]; then
        log_card_end "UPDATE AVAIL" "v${curr_v} → v${latest_tag}" "$dur"
        record_result "opencode-desktop" "DESKTOP" "UPDATE AVAIL" "v${latest_tag}" "$dur"
      else
        rpm_cache="${HOME}/.cache/@opencode-aidesktop-updater/pending/opencode-desktop-linux-x86_64.rpm"
        mkdir -p "$(dirname "$rpm_cache")"
        rpm_url="https://github.com/anomalyco/opencode/releases/download/v${latest_tag}/opencode-desktop-linux-x86_64.rpm"

        need_download=1
        if [[ -f "$rpm_cache" ]] && command -v rpm &>/dev/null; then
          cached_v=$(rpm -qp "$rpm_cache" --queryformat "%{VERSION}" 2>/dev/null || true)
          if [[ "$cached_v" == "$latest_tag" ]]; then
            log_step "Verified ready cached RPM package (v${cached_v}) at ${rpm_cache}"
            need_download=0
          fi
        fi

        download_ok=0
        if [[ $need_download -eq 0 ]]; then
          download_ok=1
        else
          log_step "Downloading RPM package from ${rpm_url}..."
          if curl -fL --connect-timeout 5 -o "$rpm_cache" "$rpm_url" 2>&1 | stream_progress 2; then
            log_step "Package cached at ${rpm_cache}"
            download_ok=1
          fi
        fi

        if [[ $download_ok -eq 1 ]]; then
          log_step "Installing RPM package (v${latest_tag})..."
          if run_privileged "OpenCode Desktop RPM installation" rpm -U "$rpm_cache" 2>&1 | stream_progress 4; then
            log_step "Installed RPM package successfully"
            log_card_end "UPDATED" "Installed v${latest_tag}" "$dur"
            record_result "opencode-desktop" "DESKTOP" "UPDATED" "v${latest_tag}" "$dur"
          else
            log_step "Privileged installation not completed"
            log_card_end "CACHED" "Run: sudo rpm -U ${rpm_cache}" "$dur"
            record_result "opencode-desktop" "DESKTOP" "CACHED" "RPM ready" "$dur"
          fi
        else
          log_card_end "UPDATE AVAIL" "v${latest_tag} available" "$dur"
          record_result "opencode-desktop" "DESKTOP" "UPDATE AVAIL" "v${latest_tag}" "$dur"
        fi
      fi
    else
      log_card_end "UP TO DATE" "Version v${curr_v} is current" "$dur"
      record_result "opencode-desktop" "DESKTOP" "UP TO DATE" "v${curr_v}" "$dur"
    fi
  fi

  # 13. AionUi Desktop Workspace
  if [[ -d "$HOME/.local/opt/AionUi" ]] && should_run "aionui" "desktop"; then
    log_card_start "AionUi AI Workspace (aionui)" "desktop"
    t_start=$(date +%s%N)
    curr_v=$(get_asar_version "$HOME/.local/opt/AionUi/resources/app.asar")
    log_step "Reading internal application asar package (v${curr_v})..."
    log_step "Checking GitHub releases for iOfficeAI/AionUi..."
    latest_tag=$(curl -s --connect-timeout 3 https://api.github.com/repos/iOfficeAI/AionUi/releases/latest 2>/dev/null | jq -r '.tag_name // empty' | sed 's/^v//')
    t_end=$(date +%s%N)
    dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")

    if [[ -n "$latest_tag" && "$latest_tag" != "$curr_v" ]]; then
      log_step "New release available on GitHub: v${latest_tag}"
      log_card_end "UPDATE AVAIL" "v${curr_v} → v${latest_tag}" "$dur"
      record_result "aionui" "DESKTOP" "UPDATE AVAIL" "v${latest_tag}" "$dur"
    else
      log_card_end "UP TO DATE" "Version v${curr_v} is current" "$dur"
      record_result "aionui" "DESKTOP" "UP TO DATE" "v${curr_v}" "$dur"
    fi
  fi

  # 14. Google Antigravity Desktop IDE
  if [[ -d "$HOME/.local/share/antigravity" ]] && should_run "antigravity-desktop" "desktop"; then
    log_card_start "Google Antigravity IDE (antigravity)" "desktop"
    t_start=$(date +%s%N)
    curr_v=$(get_asar_version "$HOME/.local/share/antigravity/resources/app.asar")
    log_step "Inspecting Antigravity IDE shell (v${curr_v})..."
    log_step "Engine, language server, and agent tools managed via 'agy'"
    t_end=$(date +%s%N)
    dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
    log_card_end "UP TO DATE" "IDE v${curr_v} (Engine: agy)" "$dur"
    record_result "antigravity" "DESKTOP" "UP TO DATE" "v${curr_v}" "$dur"
  fi

  # 15. CoWork-OS Desktop / Repo (~/CoWork-OS)
  if [[ -d "$HOME/CoWork-OS/.git" ]] && should_run "cowork-os" "desktop"; then
    log_card_start "CoWork-OS Desktop (~/CoWork-OS)" "desktop"
    t_start=$(date +%s%N)
    dirty_count=$(git -C "$HOME/CoWork-OS" status --porcelain 2>/dev/null | wc -l)
    log_step "Checking local git working tree..."
    if [[ $dirty_count -gt 0 && $FORCE_GIT -eq 0 ]]; then
      log_step "Detected ${dirty_count} uncommitted files in repository"
      log_step "Safety protection active: skipping pull to preserve local edits"
      t_end=$(date +%s%N)
      dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
      log_card_end "DIRTY (SKIPPED)" "${dirty_count} uncommitted files" "$dur"
      record_result "cowork-os" "DESKTOP" "DIRTY (SKIPPED)" "${dirty_count} edits" "$dur"
    elif [[ "$MODE" == "check" ]]; then
      log_step "Fetching origin/main..."
      git -C "$HOME/CoWork-OS" fetch origin main &>/dev/null || true
      behind=$(git -C "$HOME/CoWork-OS" rev-list HEAD..origin/main --count 2>/dev/null || echo 0)
      t_end=$(date +%s%N)
      dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
      if [[ "$behind" -gt 0 ]]; then
        log_card_end "UPDATE AVAIL" "${behind} commits behind origin" "$dur"
        record_result "cowork-os" "DESKTOP" "UPDATE AVAIL" "${behind} commits behind" "$dur"
      else
        log_card_end "UP TO DATE" "Up to date with origin/main" "$dur"
        record_result "cowork-os" "DESKTOP" "UP TO DATE" "Up to date" "$dur"
      fi
    else
      if [[ $FORCE_GIT -eq 1 && $dirty_count -gt 0 ]]; then
        log_step "Stashing local changes (--force-git)..."
        git -C "$HOME/CoWork-OS" stash push -m "Auto-stashed by aiup" &>/dev/null || true
      fi
      log_step "Pulling latest commits from origin/main..."
      git_out=$(git -C "$HOME/CoWork-OS" pull --ff-only origin main 2>&1 || true)
      t_end=$(date +%s%N)
      dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
      if echo "$git_out" | grep -qi "Already up to date"; then
        log_card_end "UP TO DATE" "Already up to date" "$dur"
        record_result "cowork-os" "DESKTOP" "UP TO DATE" "Up to date" "$dur"
      else
        log_step "Rebuilding CLI and Electron runtime..."
        (cd "$HOME/CoWork-OS" && npm install --silent && npm run build:cli &>/dev/null && npm run build:electron &>/dev/null) 2>&1 | stream_progress 4 || true
        log_card_end "UPDATED" "Pulled & rebuilt desktop" "$dur"
        record_result "cowork-os" "DESKTOP" "UPDATED" "Rebuilt" "$dur"
      fi
    fi
  fi

  # 16. Orkas Desktop Client (~/Orkas)
  if [[ -d "$HOME/Orkas/.git" ]] && should_run "orkas" "desktop"; then
    log_card_start "Orkas Desktop Client (~/Orkas)" "desktop"
    t_start=$(date +%s%N)
    dirty_count=$(git -C "$HOME/Orkas" status --porcelain 2>/dev/null | wc -l)
    log_step "Inspecting local Orkas git checkout..."
    if [[ $dirty_count -gt 0 && $FORCE_GIT -eq 0 ]]; then
      log_step "Detected ${dirty_count} uncommitted files in repository"
      t_end=$(date +%s%N)
      dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
      log_card_end "DIRTY (SKIPPED)" "${dirty_count} uncommitted files" "$dur"
      record_result "orkas" "DESKTOP" "DIRTY (SKIPPED)" "${dirty_count} edits" "$dur"
    elif [[ "$MODE" == "check" ]]; then
      log_step "Fetching origin/main..."
      git -C "$HOME/Orkas" fetch origin main &>/dev/null || true
      behind=$(git -C "$HOME/Orkas" rev-list HEAD..origin/main --count 2>/dev/null || echo 0)
      t_end=$(date +%s%N)
      dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
      if [[ "$behind" -gt 0 ]]; then
        log_card_end "UPDATE AVAIL" "${behind} commits behind origin" "$dur"
        record_result "orkas" "DESKTOP" "UPDATE AVAIL" "${behind} commits behind" "$dur"
      else
        log_card_end "UP TO DATE" "Up to date with origin/main" "$dur"
        record_result "orkas" "DESKTOP" "UP TO DATE" "Up to date" "$dur"
      fi
    else
      log_step "Syncing origin/main and npm dependencies..."
      git_out=$(git -C "$HOME/Orkas" pull --ff-only origin main 2>&1 || true)
      t_end=$(date +%s%N)
      dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
      if echo "$git_out" | grep -qi "Already up to date"; then
        log_card_end "UP TO DATE" "Already up to date" "$dur"
        record_result "orkas" "DESKTOP" "UP TO DATE" "Up to date" "$dur"
      else
        (cd "$HOME/Orkas" && npm install --silent &>/dev/null) 2>&1 | stream_progress 2 || true
        log_card_end "UPDATED" "Dependencies refreshed" "$dur"
        record_result "orkas" "DESKTOP" "UPDATED" "Refreshed" "$dur"
      fi
    fi
  fi

  # 17. Hermes Desktop UI
  if command -v hermes &>/dev/null && should_run "hermes-desktop" "desktop"; then
    log_card_start "Hermes Desktop UI (hermes-desktop)" "desktop"
    t_start=$(date +%s%N)
    log_step "Checking Hermes desktop frontend components..."
    log_step "Desktop UI assets synced directly with Hermes core engine"
    t_end=$(date +%s%N)
    dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
    log_card_end "UP TO DATE" "Synced via hermes core" "$dur"
    record_result "hermes-desktop" "DESKTOP" "UP TO DATE" "Synced" "$dur"
  fi
fi

# ==============================================================================
# SECTION 3: HOUSEKEEPING & SYSTEM DEBLOAT
# ==============================================================================
if [[ $DO_CLEANUP -eq 1 && ("$FILTER_TYPE" == "all" || "$FILTER_TYPE" == "clean") ]]; then
  [[ "$OUTPUT_FORMAT" != "json" ]] && echo -e "${BOLD}${BLUE}🧹 [SECTION 3] HOUSEKEEPING & SYSTEM DEBLOAT${RESET}\n"

  # 18. Python uv Cache & Environments
  if command -v uv &>/dev/null && should_run "clean-uv" "clean"; then
    log_card_start "Python uv Cache & Environments" "clean"
    t_start=$(date +%s%N)
    log_step "Pruning dangling wheel builds and orphaned cache entries..."
    if [[ "$MODE" == "check" ]]; then
      uv_sz=$(du -sh "$HOME/.cache/uv" 2>/dev/null | awk '{print $1}' || echo "0B")
      t_end=$(date +%s%N)
      dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
      log_card_end "UP TO DATE" "Cache footprint: ${uv_sz}" "$dur"
      record_result "clean-uv" "CLEAN" "UP TO DATE" "Cache: ${uv_sz}" "$dur"
    else
      uv_out=$(uv cache prune 2>&1 || true)
      t_end=$(date +%s%N)
      dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
      if echo "$uv_out" | grep -qi "Removed"; then
        freed=$(echo "$uv_out" | grep -oE "Removed [^)]+\)" | sed 's/Removed //')
        log_card_end "CLEANED" "Pruned dangling files (${freed})" "$dur"
        record_result "clean-uv" "CLEAN" "CLEANED" "Pruned: ${freed}" "$dur"
      else
        log_card_end "UP TO DATE" "Cache optimal (0 dangling files)" "$dur"
        record_result "clean-uv" "CLEAN" "UP TO DATE" "Cache optimal" "$dur"
      fi
    fi
  fi

  # 19. NPM Cache & Debug Logs
  if command -v npm &>/dev/null && should_run "clean-npm" "clean"; then
    log_card_start "NPM Cache & Debug Logs" "clean"
    t_start=$(date +%s%N)
    log_step "Purging stale debug logs (~/.npm/_logs)..."
    log_count=$(find "$HOME/.npm/_logs" -type f 2>/dev/null | wc -l || echo 0)
    [[ $log_count -gt 0 && "$MODE" != "check" ]] && rm -rf "$HOME/.npm/_logs/"* 2>/dev/null || true
    log_step "Verifying cache integrity and garbage-collecting corrupted indices..."
    if [[ "$MODE" == "check" ]]; then
      t_end=$(date +%s%N)
      dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
      log_card_end "UP TO DATE" "${log_count} debug logs present" "$dur"
      record_result "clean-npm" "CLEAN" "UP TO DATE" "${log_count} logs" "$dur"
    else
      npm cache verify &>/dev/null || true
      t_end=$(date +%s%N)
      dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
      log_card_end "CLEANED" "Purged ${log_count} log files & verified cache" "$dur"
      record_result "clean-npm" "CLEAN" "CLEANED" "Purged ${log_count} logs" "$dur"
    fi
  fi

  # 20. Python Pip Wheel Cache
  if command -v pip &>/dev/null && should_run "clean-pip" "clean"; then
    log_card_start "Python Pip Cache" "clean"
    t_start=$(date +%s%N)
    log_step "Purging cached wheel downloads and HTTP index files..."
    if [[ "$MODE" == "check" ]]; then
      pip_sz=$(pip cache info 2>/dev/null | grep -i "cache size:" | awk -F: '{print $2}' | xargs || echo "0B")
      t_end=$(date +%s%N)
      dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
      log_card_end "UP TO DATE" "Cache footprint: ${pip_sz:-0B}" "$dur"
      record_result "clean-pip" "CLEAN" "UP TO DATE" "Cache: ${pip_sz:-0B}" "$dur"
    else
      pip_out=$(pip cache purge 2>&1 || true)
      t_end=$(date +%s%N)
      dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
      if echo "$pip_out" | grep -qi "Files removed"; then
        freed=$(echo "$pip_out" | grep -oE "\([0-9.]+ [KMGT]?B\)" | tr -d '()' | head -n 1)
        log_card_end "CLEANED" "Purged wheels & index files (${freed:-freed})" "$dur"
        record_result "clean-pip" "CLEAN" "CLEANED" "Purged: ${freed:-freed}" "$dur"
      else
        log_card_end "UP TO DATE" "Cache optimal" "$dur"
        record_result "clean-pip" "CLEAN" "UP TO DATE" "Cache optimal" "$dur"
      fi
    fi
  fi

  # 21. Desktop Updater Packages & Temp Installers
  if should_run "clean-installers" "clean"; then
    log_card_start "Desktop Updater Packages & Temp Installers" "clean"
    t_start=$(date +%s%N)
    rpm_cache="$HOME/.cache/@opencode-aidesktop-updater/pending/opencode-desktop-linux-x86_64.rpm"
    cleaned_installer=0
    installer_detail="No stale installers"
    if [[ -f "$rpm_cache" ]] && command -v rpm &>/dev/null; then
      cached_v=$(rpm -qp "$rpm_cache" --queryformat "%{VERSION}" 2>/dev/null || true)
      curr_v=$(rpm -q --queryformat "%{VERSION}" opencode 2>/dev/null || true)
      if [[ -n "$curr_v" && -n "$cached_v" && "$curr_v" == "$cached_v" ]]; then
        sz=$(du -sh "$rpm_cache" 2>/dev/null | awk '{print $1}')
        if [[ "$MODE" != "check" ]]; then
          rm -rf "$HOME/.cache/@opencode-aidesktop-updater/pending"* 2>/dev/null || true
          cleaned_installer=1
          installer_detail="Removed installed RPM installer (${sz})"
        else
          installer_detail="Installed RPM cached (${sz})"
        fi
      else
        installer_detail="Retained pending update package (v${cached_v})"
      fi
    fi
    t_end=$(date +%s%N)
    dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
    if [[ $cleaned_installer -eq 1 ]]; then
      log_card_end "CLEANED" "$installer_detail" "$dur"
      record_result "clean-installers" "CLEAN" "CLEANED" "$installer_detail" "$dur"
    elif [[ "$installer_detail" =~ Retained ]]; then
      log_card_end "CACHED" "$installer_detail" "$dur"
      record_result "clean-installers" "CLEAN" "CACHED" "Installer ready" "$dur"
    else
      log_card_end "UP TO DATE" "$installer_detail" "$dur"
      record_result "clean-installers" "CLEAN" "UP TO DATE" "$installer_detail" "$dur"
    fi
  fi

  # 22. Local AI Git Repositories (git gc --auto)
  if should_run "clean-git" "clean"; then
    log_card_start "Local AI Git Repositories (git gc --auto)" "clean"
    t_start=$(date +%s%N)
    repos_checked=0
    for r in "$HOME/CoWork-OS" "$HOME/Orkas"; do
      if [[ -d "$r/.git" ]]; then
        log_step "Optimizing repository packfiles in ${r}..."
        [[ "$MODE" != "check" ]] && git -C "$r" gc --auto --quiet 2>/dev/null || true
        ((repos_checked++))
      fi
    done
    t_end=$(date +%s%N)
    dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
    if [[ $repos_checked -gt 0 ]]; then
      log_card_end "CLEANED" "Packed loose objects in ${repos_checked} repos" "$dur"
      record_result "clean-git" "CLEAN" "CLEANED" "${repos_checked} repos optimized" "$dur"
    else
      log_card_end "UP TO DATE" "No active local git repos" "$dur"
      record_result "clean-git" "CLEAN" "UP TO DATE" "Optimal" "$dur"
    fi
  fi

  # 23. Cached Electron Distribution Archives
  if [[ -d "$HOME/.cache/electron" ]] && should_run "clean-electron" "clean"; then
    log_card_start "Cached Electron Distribution Archives" "clean"
    t_start=$(date +%s%N)
    log_step "Pruning cached distribution zips older than 7 days (~/.cache/electron)..."
    old_zips=$(find "$HOME/.cache/electron" -type f -name "*.zip" -mtime +7 2>/dev/null | wc -l || echo 0)
    if [[ $old_zips -gt 0 && "$MODE" != "check" ]]; then
      find "$HOME/.cache/electron" -type f -name "*.zip" -mtime +7 -delete 2>/dev/null || true
      find "$HOME/.cache/electron" -type d -empty -delete 2>/dev/null || true
    fi
    t_end=$(date +%s%N)
    dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
    log_card_end "CLEANED" "Pruned ${old_zips} stale electron archives" "$dur"
    record_result "clean-electron" "CLEAN" "CLEANED" "${old_zips} archives pruned" "$dur"
  fi

  # 24. System Package Manager Cache Debloat (DNF)
  if command -v dnf &>/dev/null && should_run "clean-dnf" "clean"; then
    log_card_start "System Package Cache (DNF)" "clean"
    t_start=$(date +%s%N)
    log_step "Pruning downloaded package cache files..."
    if [[ "$MODE" != "check" ]]; then
      if sudo -n true 2>/dev/null; then
        sudo dnf clean packages &>/dev/null || true
      else
        dnf clean packages &>/dev/null || true
      fi
    fi
    t_end=$(date +%s%N)
    dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
    log_card_end "CLEANED" "DNF package cache pruned" "$dur"
    record_result "clean-dnf" "CLEAN" "CLEANED" "Package cache pruned" "$dur"
  fi

  # 25. Stale Crashpad Dumps & Temporary Sockets
  if should_run "clean-dumps" "clean"; then
    log_card_start "Stale Crash Dumps & Daemon Minidumps" "clean"
    t_start=$(date +%s%N)
    log_step "Scanning for crashpad minidumps older than 7 days..."
    dmp_count=$(find "$HOME/.config" "$HOME/.cache" -type f -name "*.dmp" -mtime +7 2>/dev/null | wc -l || echo 0)
    if [[ $dmp_count -gt 0 && "$MODE" != "check" ]]; then
      find "$HOME/.config" "$HOME/.cache" -type f -name "*.dmp" -mtime +7 -delete 2>/dev/null || true
    fi
    t_end=$(date +%s%N)
    dur=$(awk "BEGIN {printf \"%.1fs\", ($t_end - $t_start)/1000000000}")
    log_card_end "CLEANED" "Pruned ${dmp_count} stale crash dumps" "$dur"
    record_result "clean-dumps" "CLEAN" "CLEANED" "${dmp_count} dumps purged" "$dur"
  fi
fi

# ==============================================================================
# SUMMARY & OUTPUT
# ==============================================================================
count_updated=0
count_uptodate=0
count_avail=0
count_cached=0
count_cleaned=0
count_skipped=0

for s in "${REPORT_STATUS[@]}"; do
  case "$s" in
    UPDATED)           ((count_updated++)) ;;
    CACHED)            ((count_cached++)) ;;
    CLEANED|DEBLOATED) ((count_cleaned++)) ;;
    "UP TO DATE")      ((count_uptodate++)) ;;
    "UPDATE AVAIL")    ((count_avail++)) ;;
    *)                 ((count_skipped++)) ;;
  esac
done

if [[ "$OUTPUT_FORMAT" == "json" ]]; then
  python3 -c "
import json, sys

sep = '__AIUP_SEP__'
names = sys.argv[1].split(sep) if sys.argv[1] else []
types = sys.argv[2].split(sep) if sys.argv[2] else []
statuses = sys.argv[3].split(sep) if sys.argv[3] else []
details = sys.argv[4].split(sep) if sys.argv[4] else []
durations = sys.argv[5].split(sep) if sys.argv[5] else []

results = []
for n, t, s, d, dur in zip(names, types, statuses, details, durations):
    if n:
        results.append({
            'target': n,
            'scope': t,
            'status': s,
            'details': d,
            'duration': dur
        })

summary = {
    'version': '${VERSION}',
    'os': '${OS}',
    'pkg_manager': '${PKG_MGR}',
    'mode': '${MODE}',
    'counts': {
        'total': len(results),
        'up_to_date': ${count_uptodate},
        'updated': ${count_updated},
        'cleaned': ${count_cleaned},
        'cached': ${count_cached},
        'available': ${count_avail},
        'skipped': ${count_skipped}
    },
    'results': results
}
print(json.dumps(summary, indent=2))
" \
  "$(printf "%s__AIUP_SEP__" "${REPORT_NAMES[@]:-}")" \
  "$(printf "%s__AIUP_SEP__" "${REPORT_TYPES[@]:-}")" \
  "$(printf "%s__AIUP_SEP__" "${REPORT_STATUS[@]:-}")" \
  "$(printf "%s__AIUP_SEP__" "${REPORT_DETAILS[@]:-}")" \
  "$(printf "%s__AIUP_SEP__" "${REPORT_DURATIONS[@]:-}")"
  exit 0
fi

# Text Mode Summary Dashboard
echo -e "${BOLD}${CYAN}╭────────────────────────────────────────────────────────────────────────────────────────╮${RESET}"
echo -e "${BOLD}${CYAN}│${RESET}  ${BOLD}📊 Update Summary Dashboard${RESET}                                                          ${BOLD}${CYAN}│${RESET}"
echo -e "${BOLD}${CYAN}├─────────────────────┬────────────┬────────────────────┬────────────────────────┬───────┤${RESET}"
printf "${BOLD}${CYAN}│${RESET} %-19s │ %-10s │ %-18s │ %-22s │ %-5s ${BOLD}${CYAN}│${RESET}\n" "Target" "Scope" "Status" "Details" "Time"
echo -e "${BOLD}${CYAN}├─────────────────────┼────────────┼────────────────────┼────────────────────────┼───────┤${RESET}"

for i in "${!REPORT_NAMES[@]}"; do
  name="${REPORT_NAMES[$i]}"
  type="${REPORT_TYPES[$i]}"
  status="${REPORT_STATUS[$i]}"
  detail="${REPORT_DETAILS[$i]}"
  dur="${REPORT_DURATIONS[$i]}"

  case "$status" in
    UPDATED)
      status_badge="${GREEN}✔ UPDATED${RESET}"
      status_plain="✔ UPDATED"
      ;;
    CLEANED|DEBLOATED)
      status_badge="${GREEN}✔ CLEANED${RESET}"
      status_plain="✔ CLEANED"
      ;;
    "UP TO DATE")
      status_badge="${GREEN}✔ UP-TO-DATE${RESET}"
      status_plain="✔ UP-TO-DATE"
      ;;
    "UPDATE AVAIL")
      status_badge="${YELLOW}★ AVAILABLE${RESET}"
      status_plain="★ AVAILABLE"
      ;;
    "DIRTY (SKIPPED)")
      status_badge="${YELLOW}▲ DIRTY TREE${RESET}"
      status_plain="▲ DIRTY TREE"
      ;;
    CACHED)
      status_badge="${CYAN}⇣ CACHED${RESET}"
      status_plain="⇣ CACHED"
      ;;
    SKIPPED)
      status_badge="${GRAY}⊘ SKIPPED${RESET}"
      status_plain="⊘ SKIPPED"
      ;;
    *)
      status_badge="${CYAN}${status}${RESET}"
      status_plain="${status}"
      ;;
  esac

  type_badge="${CYAN}${type}${RESET}"
  [[ "$type" == "DESKTOP" ]] && type_badge="${MAGENTA}${type}${RESET}"
  [[ "$type" == "CLEAN" ]] && type_badge="${BLUE}${type}${RESET}"

  pad_type=$(( 10 - ${#type} ))
  pad_status=$(( 18 - ${#status_plain} ))
  [[ $pad_type -lt 0 ]] && pad_type=0
  [[ $pad_status -lt 0 ]] && pad_status=0

  printf "${BOLD}${CYAN}│${RESET} %-19s │ %b%*s │ %b%*s │ %-22s │ %-5s ${BOLD}${CYAN}│${RESET}\n" \
    "${name:0:19}" \
    "$type_badge" "$pad_type" "" \
    "$status_badge" "$pad_status" "" \
    "${detail:0:22}" "$dur"
done

echo -e "${BOLD}${CYAN}╰─────────────────────┴────────────┴────────────────────┴────────────────────────┴───────╯${RESET}"
summary_footer="  ${BOLD}Total:${RESET} ${#REPORT_NAMES[@]} items  │  ${GREEN}${count_uptodate} up-to-date${RESET}  │  ${GREEN}${count_updated} updated${RESET}"
[[ $count_cleaned -gt 0 ]] && summary_footer+="  │  ${BLUE}${count_cleaned} cleaned${RESET}"
[[ $count_cached -gt 0 ]] && summary_footer+="  │  ${CYAN}${count_cached} cached${RESET}"
[[ $count_avail -gt 0 ]] && summary_footer+="  │  ${YELLOW}${count_avail} available${RESET}"
[[ $count_skipped -gt 0 ]] && summary_footer+="  │  ${GRAY}${count_skipped} skipped${RESET}"
echo -e "${summary_footer}\n"

# Desktop Notification (if in active GUI session)
if command -v notify-send &>/dev/null && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
  notify_msg="${count_uptodate} Up-to-date, ${count_updated} Updated"
  [[ $count_cleaned -gt 0 ]] && notify_msg+=", ${count_cleaned} Cleaned"
  [[ $count_avail -gt 0 ]] && notify_msg+=", ${count_avail} Available"
  notify-send -a "aiup" -i "dialog-information" "⚡ AIUP Sync Finished" "$notify_msg" 2>/dev/null || true
elif [[ $IS_MACOS -eq 1 ]]; then
  osascript -e "display notification \"${count_uptodate} Up-to-date, ${count_updated} Updated, ${count_cleaned} Cleaned\" with title \"⚡ AIUP Sync Finished\"" 2>/dev/null || true
fi
